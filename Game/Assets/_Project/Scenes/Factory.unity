  m_Script: {fileID: 11500000, guid: f8e4f54d48e1f4a4f92269fbbdaab871, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Abandoned.Runtime::Abandoned.Interaction.MysteryNote
  title: PATTERN MASTER'S LOG
  text: 'Order: 15-ton ceremonial bronze bell.

    The customer provided their own
    alloy ingot specifications.

    Wood patterns keep splintering along the grain
    during sand ramming as if vibrating from within.

    The apprentice refuses
    to enter the shop after sundown.

    He says the bell mould rings before we
    pour the bronze.'
