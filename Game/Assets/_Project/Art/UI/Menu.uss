/* ABANDONED UI theme (UI overhaul step 1): a cheap salvage company. Hazard yellow on near-black, condensed
   display type for headings and buttons, a readable sans for everything small, the stencil only for big titles.
   Fonts (OFL): Barlow (body, set on the root from code), Barlow Condensed (display), Saira Stencil One (titles),
   IBM Plex Mono (receipts), VT323 (the HQ terminal). Sizes are at the 1920x1080 reference (scaled by height). */

:root {
    --c-ink: rgb(10, 11, 12);
    --c-panel: rgba(14, 15, 17, 0.94);
    --c-panel-2: rgb(28, 30, 33);
    --c-panel-3: rgb(40, 43, 47);
    --c-line: rgba(255, 255, 255, 0.09);
    --c-accent: rgb(255, 194, 26);
    --c-accent-hot: rgb(255, 220, 110);
    --c-accent-ink: rgb(20, 17, 8);
    --c-text: rgb(240, 236, 224);
    --c-dim: rgb(165, 161, 150);
    --c-faint: rgba(240, 236, 224, 0.45);
    --c-good: rgb(126, 224, 126);
    --c-bad: rgb(255, 92, 74);
    --c-money: rgb(150, 232, 110);
    --c-paper: rgb(238, 231, 212);
    --c-paper-ink: rgb(42, 38, 32);
    --c-crt: rgb(255, 176, 0);
    --c-crt-bg: rgb(20, 12, 2);
}

/* ---- Type ---- */

.font-display { -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf"); }
.font-display-semi { -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); }
.font-stencil { -unity-font-definition: url("../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); }
.font-body-bold { -unity-font-definition: url("../ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); }
.font-mono { -unity-font-definition: url("../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); }
.font-mono-bold { -unity-font-definition: url("../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf"); }
.font-crt { -unity-font-definition: url("../ThirdParty/Fonts/VT323/VT323-Regular.ttf"); }

.menu-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: var(--c-text);
}

.title {
    -unity-font-definition: url("../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 88px;
    color: var(--c-text);
    letter-spacing: 2px;
    margin-bottom: -8px;
    text-shadow: 0 6px 0 rgba(0, 0, 0, 0.55);
}

.subtitle {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    color: var(--c-accent);
    margin-bottom: 26px;
    white-space: normal;
}

.heading {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 52px;
    letter-spacing: 2px;
    color: var(--c-text);
    margin-top: 0;
    margin-bottom: 4px;
}

.section {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 22px;
    letter-spacing: 3px;
    color: var(--c-accent);
    margin-top: 18px;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 2px;
    border-bottom-color: var(--c-line);
}

.text {
    font-size: 19px;
    color: var(--c-dim);
    white-space: normal;
    margin-bottom: 4px;
}

.text--error { color: var(--c-bad); }
.text--small { font-size: 16px; }
.text--good { color: var(--c-good); }
.text--money { color: var(--c-money); }

/* ---- Backdrops and panels ---- */

.backdrop {
    flex-grow: 1;
    background-color: rgba(6, 7, 8, 0.5);
    justify-content: center;
    padding-left: 7%;
}

.backdrop--dim { background-color: rgba(6, 7, 8, 0.8); }

.backdrop--center {
    align-items: center;
    padding-left: 0;
}

.panel {
    background-color: var(--c-panel);
    border-top-width: 6px;
    border-top-color: var(--c-accent);
    padding: 30px 40px 30px 40px;
    width: 660px;
    max-width: 92%;
    max-height: 92%;
}

.panel--wide { width: 960px; }
.panel--xwide { width: 1180px; }

/* A strip of hazard tape: yellow with dark diagonal bars (drawn by UiKit.Hazard). */
.hazard {
    height: 10px;
    background-color: var(--c-accent);
    flex-direction: row;
    overflow: hidden;
}

.hazard__bar {
    flex-shrink: 0;
    width: 14px;
    height: 30px;
    margin-left: 14px;
    margin-top: -10px;
    background-color: var(--c-ink);
    rotate: 35deg;
}

/* ---- Buttons ---- */

/* Big menu buttons, R.E.P.O.-style: just words; hover lights them up, nudges them right and shows the arrow. */
.menu-button {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 38px;
    letter-spacing: 1px;
    height: 54px;
    margin: 2px 0 2px 0;
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-text);
    border-width: 0;
    -unity-text-align: middle-left;
    flex-direction: row;
    align-items: center;
    translate: 0 0;
    transition-property: translate, color;
    transition-duration: 0.07s;
}

.menu-button:hover, .menu-button:focus {
    color: var(--c-accent);
    translate: 18px 0;
    background-color: rgba(0, 0, 0, 0);
}

.menu-button:active { color: var(--c-accent-hot); }
.menu-button:disabled { opacity: 0.35; }

.menu-button__arrow {
    position: absolute;
    left: -30px;
    font-size: 26px;
    color: var(--c-accent);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.07s;
}

.menu-button:hover > .menu-button__arrow, .menu-button:focus > .menu-button__arrow { opacity: 1; }

/* Small buttons are chips: a dark slab that turns yellow. */
.menu-button--small {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 20px;
    letter-spacing: 1px;
    height: 40px;
    margin: 3px 0 3px 8px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--c-panel-3);
    -unity-text-align: middle-center;
    border-radius: 2px;
    align-self: flex-start;
}

.menu-button--small:hover, .menu-button--small:focus {
    background-color: var(--c-accent);
    color: var(--c-accent-ink);
    translate: 0 0;
}

.menu-button--on {
    background-color: var(--c-accent);
    color: var(--c-accent-ink);
}

.menu-button--on:hover { color: var(--c-accent-ink); }

/* ---- Layout helpers ---- */

.row {
    flex-direction: row;
    align-items: center;
}

.grow { flex-grow: 1; }

.wrap {
    flex-direction: row;
    flex-wrap: wrap;
}

.scroll { flex-shrink: 1; }

.footer {
    position: absolute;
    right: 28px;
    bottom: 18px;
    font-size: 15px;
    color: var(--c-faint);
}

/* ---- Fields and settings ---- */

.field {
    font-size: 20px;
    height: 42px;
    margin: 4px 0 4px 0;
}

.field > .unity-text-field__input, .field > .unity-base-text-field__input {
    background-color: var(--c-ink);
    color: var(--c-text);
    border-color: var(--c-panel-3);
    border-width: 2px;
    padding-left: 10px;
}

.setting {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-line);
}

.setting__label {
    width: 320px;
    font-size: 19px;
    color: var(--c-text);
}

.setting__control { flex-grow: 1; }

.setting__value {
    width: 80px;
    font-size: 18px;
    color: var(--c-accent);
    -unity-text-align: middle-right;
}

/* Sliders: a thin dark track and a chunky yellow handle (selectors as specific as the default theme's). */
.setting__control.unity-base-slider--horizontal .unity-base-slider__tracker {
    background-color: var(--c-panel-3);
    border-width: 0;
    height: 6px;
    margin-top: -3px;
}

.setting__control.unity-base-slider--horizontal .unity-base-slider__dragger {
    background-color: var(--c-accent);
    border-width: 0;
    width: 14px;
    height: 24px;
    margin-top: -12px;
    border-radius: 2px;
}

.setting__control.unity-base-slider--horizontal .unity-base-slider__dragger-border { display: none; }

/* Scrollbars: a thin dark rail with a yellow thumb, no arrow buttons. */
.unity-scroller--vertical {
    width: 8px;
    margin-left: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller--vertical > .unity-scroller__low-button, .unity-scroller--vertical > .unity-scroller__high-button { display: none; }

.unity-scroller--vertical > .unity-scroller__slider { margin: 0; }

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: var(--c-panel-3);
    border-width: 0;
    width: 8px;
    left: 0;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--c-accent);
    border-width: 0;
    width: 8px;
    left: 0;
    border-radius: 2px;
}

/* ---- Tiles (wardrobe, achievements) ---- */

.tile {
    width: 260px;
    height: 66px;
    margin: 4px 8px 4px 0;
    white-space: normal;
    font-size: 17px;
    -unity-text-align: middle-left;
    padding-left: 12px;
    flex-direction: row;
    align-items: center;
}

.swatch {
    width: 24px;
    height: 24px;
    margin-right: 10px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.6);
}

.tile__text {
    flex-shrink: 1;
    white-space: normal;
    font-size: 16px;
    -unity-text-align: middle-left;
}

/* ---- Kit widgets (UiKit) ---- */

/* A keyboard key cap: the player's own binding, boxed. */
.keycap {
    -unity-font-definition: url("../ThirdParty/Fonts/Barlow/Barlow-Bold.ttf");
    min-width: 30px;
    height: 30px;
    padding: 0 7px 0 7px;
    margin: 0 6px 0 0;
    font-size: 17px;
    color: var(--c-ink);
    background-color: var(--c-text);
    border-radius: 4px;
    border-bottom-width: 4px;
    border-bottom-color: rgb(150, 146, 136);
    -unity-text-align: middle-center;
}

.keycap--mouse {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
    width: 30px;
    padding: 0;
    -unity-background-image-tint-color: var(--c-text);
}

.icon { width: 32px; height: 32px; flex-shrink: 0; }
.icon--small { width: 22px; height: 22px; }
.icon--large { width: 56px; height: 56px; }

.bar {
    height: 10px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    overflow: hidden;
}

.bar__fill {
    height: 100%;
    width: 0;
    background-color: var(--c-accent);
    transition-property: width, background-color;
    transition-duration: 0.15s;
}

.bar__fill--good { background-color: var(--c-good); }
.bar__fill--bad { background-color: var(--c-bad); }

/* A rubber stamp: slams in big and rotated, settles. */
.stamp {
    -unity-font-definition: url("../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 46px;
    padding: 2px 16px 2px 16px;
    border-width: 5px;
    border-radius: 6px;
    color: var(--c-bad);
    border-color: var(--c-bad);
    rotate: -8deg;
    scale: 1 1;
    opacity: 1;
    transition-property: scale, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    -unity-text-align: middle-center;
}

.stamp--good { color: var(--c-good); border-color: var(--c-good); }
.stamp--hidden { scale: 2.2 2.2; opacity: 0; }

.tag {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    padding: 1px 8px 1px 8px;
    color: var(--c-accent-ink);
    background-color: var(--c-accent);
    border-radius: 2px;
}

/* ---- Subtitles ---- */

.subtitle-line {
    font-size: 21px;
    color: var(--c-text);
    background-color: rgba(0, 0, 0, 0.65);
    padding: 4px 14px 4px 14px;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.subtitles {
    position: absolute;
    left: 0; right: 0; bottom: 130px;
    align-items: center;
}

/* ---- In-game HUD (M8.1; restyled in UI step 2) ---- */

.hud-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.hud-top {
    position: absolute;
    top: 16px; left: 0; right: 0;
    flex-direction: row;
    justify-content: center;
}

.hud-chip {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    background-color: rgba(10, 11, 12, 0.66);
    color: var(--c-text);
    font-size: 22px;
    letter-spacing: 1px;
    padding: 5px 14px 5px 14px;
    margin: 0 4px 0 4px;
    border-radius: 2px;
}

.hud-chip--good { color: var(--c-good); }
.hud-chip--bad { color: var(--c-bad); }

.hud-banner {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    position: absolute;
    left: 0; right: 0; top: 24%;
    font-size: 58px;
    letter-spacing: 2px;
    color: var(--c-accent);
    -unity-text-align: middle-center;
    text-shadow: 0 4px 0 rgba(0, 0, 0, 0.6);
}

.hud-banner--dead { color: var(--c-bad); top: 38%; }

.hud-crosshair {
    position: absolute;
    left: 50%; top: 50%;
    width: 6px; height: 6px;
    margin-left: -3px; margin-top: -3px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 3px;
}

.hud-prompt {
    position: absolute;
    left: 0; right: 0; top: 53%;
    font-size: 21px;
    color: var(--c-text);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.7);
}

.hud-prompt--hint { color: rgb(255, 140, 100); }

.hud-charge {
    position: absolute;
    left: 50%; top: 57%;
    width: 150px; height: 8px;
    margin-left: -75px;
    background-color: rgba(0, 0, 0, 0.55);
}

.hud-charge__fill { height: 100%; background-color: var(--c-accent); }

.hud-panel {
    position: absolute;
    background-color: rgba(10, 11, 12, 0.8);
    padding: 10px 14px 10px 14px;
    border-left-width: 4px;
    border-left-color: var(--c-accent);
    font-size: 18px;
    color: var(--c-text);
    white-space: normal;
}

.hud-inventory { left: 50%; bottom: 64px; width: 460px; margin-left: -230px; }
.hud-scanner { left: 52%; top: 45%; width: 300px; }
.hud-motion { right: 16px; top: 34%; width: 280px; }
.hud-nightvision { right: 16px; top: 26%; width: 280px; }

.hud-voice {
    position: absolute;
    left: 28px; bottom: 112px;
    font-size: 17px;
    color: rgb(187, 187, 187);
}

.hud-marker {
    position: absolute;
    font-size: 19px;
    translate: -50% -50%;
    -unity-text-align: middle-center;
}

.hud-ghost {
    position: absolute;
    left: 0; right: 0; bottom: 90px;
    font-size: 22px;
    color: rgb(187, 187, 255);
    -unity-text-align: middle-center;
}

.hud-float {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    position: absolute;
    font-size: 32px;
    translate: -50% -50%;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.6);
}

/* ---- World screens: board, shop, rack, appraisal (M8.1b; restyled in steps 7-8) ---- */

.hud-cards { flex-direction: row; }

.hud-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px 0 6px;
    padding: 14px 14px 14px 14px;
    background-color: var(--c-panel-2);
}

.hud-card--taken {
    border-top-width: 4px;
    border-top-color: var(--c-good);
}

.hud-row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-line);
}

.hud-cell { width: 150px; font-size: 17px; color: var(--c-text); -unity-text-align: middle-right; }
.hud-cell--name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    white-space: normal;
    -unity-text-align: middle-left;
}

.hud-hint {
    left: 24px; top: 84px;
    width: 440px;
}

.hud-floor {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    position: absolute;
    left: 0; right: 0; bottom: 160px;
    font-size: 28px;
    letter-spacing: 1px;
    color: rgb(255, 160, 70);
    -unity-text-align: middle-center;
}

.hud-floor--failing { color: var(--c-bad); font-size: 36px; }

.hud-toast {
    right: 24px; top: 84px;
    width: 380px;
    border-left-color: var(--c-good);
}

/* ---- Run HUD (UI step 2): haul vs quota up top, the window clock top right ---- */

.run-haul {
    position: absolute;
    top: 12px; left: 0; right: 0;
    align-items: center;
}

.run-haul__row { flex-direction: row; align-items: flex-end; }

.run-haul__label {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--c-dim);
    margin-right: 10px;
    margin-bottom: 9px;
}

.run-haul__amount {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 46px;
    color: var(--c-money);
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.65);
}

.run-haul__quota {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 22px;
    color: var(--c-text);
    margin-left: 10px;
    margin-bottom: 7px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.65);
}

.run-haul__bar { width: 380px; height: 8px; margin-top: 1px; }

.run-haul__cargo {
    font-size: 15px;
    color: var(--c-dim);
    margin-top: 5px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.7);
}

.run-haul__cargo--bad { color: var(--c-bad); }

.run-haul__met {
    margin-top: 6px;
    opacity: 0;
    scale: 1.6 1.6;
    transition-property: scale, opacity;
    transition-duration: 0.18s;
}

.run-haul__met--on { opacity: 1; scale: 1 1; }

.run-clock {
    position: absolute;
    top: 18px; right: 28px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 11, 12, 0.62);
    padding: 4px 14px 4px 10px;
    border-radius: 3px;
}

.run-clock__time {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 30px;
    margin-left: 6px;
    color: var(--c-text);
}

.run-clock--late { background-color: rgba(90, 14, 10, 0.75); }
.run-clock--late .run-clock__time { color: rgb(255, 150, 130); font-size: 24px; }

/* ---- Prompts and crosshair (UI step 2) ---- */

.hud-prompt-row {
    position: absolute;
    left: 0; right: 0; top: 54%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.hud-prompt__part {
    flex-direction: row;
    align-items: center;
    margin: 0 4px 0 4px;
    padding: 4px 10px 4px 6px;
    background-color: rgba(10, 11, 12, 0.6);
    border-radius: 3px;
}

.hud-prompt__text {
    font-size: 21px;
    color: var(--c-text);
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.75);
}

.hud-prompt-row--hint .hud-prompt__text { color: rgb(255, 150, 110); }

.hud-crosshair--target {
    width: 16px; height: 16px;
    margin-left: -8px; margin-top: -8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
}

/* ---- Player HUD (UI step 2): stamina bottom left, hand slots and pockets bottom right ---- */

.player-stamina {
    position: absolute;
    left: 28px; bottom: 26px;
    width: 300px;
}

.player-stamina__label {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--c-dim);
    margin-bottom: 3px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.7);
}

.player-stamina .bar { height: 9px; }

.player-load {
    font-size: 15px;
    color: var(--c-accent);
    margin-top: 5px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.7);
}

.player-slots {
    position: absolute;
    right: 28px; bottom: 22px;
    flex-direction: row;
    align-items: flex-end;
}

.slot {
    width: 62px; height: 62px;
    margin-left: 6px;
    background-color: rgba(10, 11, 12, 0.72);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    transition-property: translate, border-color;
    transition-duration: 0.1s;
}

.slot--hand { width: 76px; height: 76px; }
.slot--active { border-color: var(--c-accent); translate: 0 -8px; }

.slot__icon { width: 44px; height: 44px; -unity-background-scale-mode: scale-to-fit; }
.slot--hand .slot__icon { width: 54px; height: 54px; }
.slot--empty .slot__icon { opacity: 0; }

.slot__key {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    position: absolute;
    left: 5px; top: 1px;
    font-size: 15px;
    color: var(--c-dim);
}

.slot__value {
    -unity-font-definition: url("../ThirdParty/Fonts/Barlow/Barlow-Bold.ttf");
    position: absolute;
    right: 4px; bottom: 1px;
    font-size: 13px;
    color: var(--c-money);
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.9);
}

.slot-gap { width: 18px; }

.pockets-detail { right: 28px; bottom: 116px; width: 340px; }

/* ---- Loot tags: the value over loot you look at, hold, or scan (UI step 2) ---- */

.loot-tag {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
    background-color: rgba(10, 11, 12, 0.74);
    padding: 3px 10px 4px 10px;
    border-radius: 3px;
    border-bottom-width: 3px;
    border-bottom-color: var(--c-text);
    scale: 1 1;
    opacity: 1;
    transition-property: scale, opacity;
    transition-duration: 0.12s;
}

.loot-tag--hidden { scale: 0.5 0.5; opacity: 0; }

/* What you hold: pinned under the prompt instead of on the item (it's right in front of your face). */
.loot-tag--held { left: 50%; top: 61%; translate: -50% 0; }
.loot-tag--scan { background-color: rgba(10, 11, 12, 0.55); padding: 1px 8px 2px 8px; }

.loot-tag__value {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 28px;
    color: var(--c-text);
}

.loot-tag--scan .loot-tag__value { font-size: 22px; }

.loot-tag__name { font-size: 15px; color: var(--c-dim); }
.loot-tag__meta { flex-direction: row; margin-top: 3px; }
.loot-tag__meta .tag { margin: 0 2px 0 2px; font-size: 14px; }
.tag--warn { background-color: var(--c-bad); color: var(--c-text); }
.tag--dim { background-color: var(--c-panel-3); color: var(--c-text); }

.loot-tag--t1 { border-bottom-color: var(--c-money); }
.loot-tag--t1 .loot-tag__value { color: var(--c-money); }
.loot-tag--t2 { border-bottom-color: var(--c-accent); }
.loot-tag--t2 .loot-tag__value { color: var(--c-accent); }
.loot-tag--t3 { border-bottom-color: rgb(255, 120, 40); }
.loot-tag--t3 .loot-tag__value { color: rgb(255, 140, 60); }
.loot-tag--broken .loot-tag__value { color: var(--c-bad); }

/* The scan's ping: a ring that races out from the crosshair. */
.scan-ring {
    position: absolute;
    left: 50%; top: 50%;
    width: 200px; height: 200px;
    margin-left: -100px; margin-top: -100px;
    border-width: 3px;
    border-color: rgba(255, 194, 26, 0.9);
    border-radius: 100px;
    scale: 0.1 0.1;
    opacity: 1;
    transition-property: scale, opacity;
    transition-duration: 0.7s, 0.7s;
    transition-timing-function: ease-out, ease-in;
}

.scan-ring--out { scale: 10 10; opacity: 0; }

.scan-ready {
    position: absolute;
    left: 28px; bottom: 74px;
    flex-direction: row;
    align-items: center;
}

.scan-ready__text { font-size: 15px; color: var(--c-dim); text-shadow: 0 2px 0 rgba(0, 0, 0, 0.7); }

/* ---- Death, ghost, truck, toasts, speakers (UI step 3) ---- */

.death-card {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(40, 4, 2, 0.45);
    align-items: center;
    justify-content: center;
}

.death-card__title {
    -unity-font-definition: url("../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 132px;
    color: var(--c-bad);
    letter-spacing: 6px;
    text-shadow: 0 8px 0 rgba(0, 0, 0, 0.7);
}

.death-card__cause {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 36px;
    color: var(--c-text);
    margin-top: 4px;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.7);
}

.death-card__note {
    font-size: 19px;
    color: var(--c-dim);
    margin-top: 14px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.7);
}

.ghost-bar {
    position: absolute;
    left: 0; right: 0; bottom: 90px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.ghost-bar .hud-prompt__text { color: rgb(200, 205, 255); }

.threat-mark {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    color: var(--c-bad);
    font-size: 22px;
    letter-spacing: 1px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.8);
}

.truck-banner {
    position: absolute;
    left: 0; right: 0; top: 20%;
    align-items: center;
    background-color: rgba(10, 11, 12, 0.72);
    padding-bottom: 0;
}

.truck-banner .hazard { align-self: stretch; }

.truck-banner__title {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 40px;
    letter-spacing: 4px;
    color: var(--c-accent);
    margin-top: 10px;
}

.truck-banner__count {
    -unity-font-definition: url("../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 96px;
    color: var(--c-text);
    margin-top: -10px;
    margin-bottom: -14px;
}

.truck-banner__status {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 28px;
    letter-spacing: 2px;
    color: var(--c-bad);
    margin-bottom: 10px;
}

.truck-banner__status--good { color: var(--c-good); }

.toast-stack {
    position: absolute;
    right: 28px; top: 84px;
    width: 400px;
}

.toast {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 11, 12, 0.86);
    border-left-width: 5px;
    border-left-color: var(--c-accent);
    padding: 10px 14px 10px 12px;
    margin-bottom: 8px;
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.22s;
}

.toast--in { translate: 420px 0; opacity: 0; }
.toast--out { translate: 420px 0; opacity: 0; }
.toast--good { border-left-color: var(--c-good); }
.toast--warn { border-left-color: var(--c-bad); }
.toast__icon { width: 40px; height: 40px; margin-right: 12px; -unity-background-image-tint-color: var(--c-text); }
.toast__text { flex-shrink: 1; }

.toast__title {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 22px;
    letter-spacing: 1px;
    color: var(--c-text);
}

.toast__body { font-size: 16px; color: var(--c-dim); white-space: normal; }

.speaker-mark {
    position: absolute;
    translate: -50% -100%;
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 11, 12, 0.7);
    padding: 3px 9px 3px 6px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--c-good);
}

.speaker-mark .icon { -unity-background-image-tint-color: var(--c-good); margin-right: 5px; }

.speaker-mark__name {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 17px;
    color: var(--c-text);
}

.speaker-mark--radio { border-color: var(--c-accent); }
.speaker-mark--radio .icon { -unity-background-image-tint-color: var(--c-accent); }

/* The truck's haul board (a texture on a quad in the world). */
.truck-display {
    flex-grow: 1;
    align-items: center;
    background-color: rgb(10, 11, 12);
    color: var(--c-text);
}

.truck-display .hazard { align-self: stretch; height: 16px; }

.truck-display__label {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 34px;
    letter-spacing: 6px;
    color: var(--c-accent);
    margin-top: 10px;
}

.truck-display__amount {
    -unity-font-definition: url("../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 104px;
    color: var(--c-money);
    margin-top: -16px;
    margin-bottom: -10px;
}

.truck-display__quota {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 30px;
    color: var(--c-text);
}

.truck-display__quota--met { color: var(--c-good); }
.truck-display__bar { width: 520px; height: 16px; margin-top: 8px; }

.truck-display__cargo {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 24px;
    color: var(--c-dim);
    margin-top: 8px;
}

.truck-display__cargo--bad { color: var(--c-bad); }

/* ---- Pause menu (UI step 4): big buttons left, the crew right ---- */

.pause { padding-left: 0; justify-content: center; align-items: center; }

.pause__columns {
    flex-direction: row;
    align-items: center;
    width: 92%;
    max-width: 1500px;
}

.pause__left { width: 520px; flex-shrink: 0; margin-right: 60px; }
.pause__left .title { font-size: 96px; }

.pause__crew { width: auto; flex-grow: 1; max-width: 780px; }

.crew-row {
    flex-direction: row;
    align-items: center;
    min-height: 58px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-line);
}

.crew-row__swatch {
    width: 14px; height: 40px;
    margin-right: 14px;
    border-radius: 2px;
    background-color: var(--c-panel-3);
}

.crew-row__who { flex-grow: 1; flex-shrink: 1; min-width: 160px; }

.crew-row__name {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 26px;
    color: var(--c-text);
}

.crew-row__tags {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--c-accent);
}

.crew-row__talking {
    width: 12px; height: 12px;
    border-radius: 6px;
    margin: 0 10px 0 10px;
    background-color: var(--c-panel-3);
}

.crew-row__talking--on { background-color: var(--c-good); }

.crew-row__ping { width: 70px; font-size: 15px; color: var(--c-dim); -unity-text-align: middle-right; margin-right: 12px; }

.crew-row__volume { width: 170px; }

.crew-row__volume.unity-base-slider--horizontal .unity-base-slider__tracker {
    background-color: var(--c-panel-3);
    border-width: 0;
    height: 6px;
    margin-top: -3px;
}

.crew-row__volume.unity-base-slider--horizontal .unity-base-slider__dragger {
    background-color: var(--c-accent);
    border-width: 0;
    width: 12px; height: 20px;
    margin-top: -10px;
    border-radius: 2px;
}

.crew-row__volume.unity-base-slider--horizontal .unity-base-slider__dragger-border { display: none; }

/* ---- Settings tabs (UI step 5) ---- */

.settings { height: 86%; }
.tabs { margin-bottom: 8px; }
.tab { margin-left: 0; margin-right: 6px; min-width: 120px; }
.settings__body { flex-grow: 1; }

.choice__value {
    width: 240px;
    font-size: 19px;
    color: var(--c-text);
    -unity-text-align: middle-center;
}

.choice__arrow { min-width: 40px; margin-left: 0; padding-left: 0; padding-right: 0; }

.mic-meter { flex-grow: 1; height: 12px; margin-right: 80px; }

/* ---- Main menu and Play (UI step 6) ---- */

.main { flex-grow: 1; justify-content: center; }

.main__shade {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 48%;
    background-color: rgba(5, 6, 7, 0.72);
}

.main__column { padding-left: 7%; width: 760px; max-width: 60%; }
.main__logo { font-size: 128px; letter-spacing: 4px; margin-bottom: -6px; }
.main__tape { width: 420px; height: 10px; margin-bottom: 26px; }
.main__button { font-size: 46px; height: 62px; }
.main__notice { flex-direction: row; align-items: center; margin-bottom: 12px; }
.main__links { position: absolute; left: 7%; bottom: 52px; }
.main__links .menu-button--small { margin-left: 0; margin-right: 8px; }

.main__memo {
    position: absolute;
    left: 7%; right: 260px; bottom: 18px;
    font-size: 15px;
    color: var(--c-dim);
}

.play__cards { margin-top: 14px; margin-bottom: 8px; }
.play__card { padding: 18px 18px 18px 18px; justify-content: flex-start; }
.play__icon { width: 34px; height: 34px; margin-right: 10px; -unity-background-image-tint-color: var(--c-accent); }
.play__title { margin: 0; padding: 0; border-bottom-width: 0; font-size: 26px; }
.play__blurb { margin-top: 8px; margin-bottom: 10px; min-height: 64px; }
.play__card .menu-button { font-size: 32px; }

/* ---- Appraisal receipt (UI step 7) ---- */

.appraisal { width: 1240px; max-width: 96%; }
.appraisal__columns { flex-direction: row; align-items: flex-start; }

.receipt {
    width: 540px;
    flex-shrink: 0;
    background-color: var(--c-paper);
    padding: 22px 26px 26px 26px;
    margin-right: 34px;
    rotate: -1deg;
    border-bottom-width: 6px;
    border-bottom-color: rgb(210, 202, 180);
}

.receipt__head, .receipt__line, .receipt__line-value, .receipt__small, .receipt__rule, .receipt__was,
.receipt__total-label, .receipt__total-value {
    -unity-font-definition: url("../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    color: var(--c-paper-ink);
}

.receipt__head {
    -unity-font-definition: url("../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf");
    font-size: 26px;
    -unity-text-align: middle-center;
}

.receipt__small { font-size: 14px; -unity-text-align: middle-center; color: rgb(110, 102, 88); }
.receipt__rule { font-size: 15px; -unity-text-align: middle-center; color: rgb(140, 132, 116); overflow: hidden; }
.receipt__items { max-height: 330px; }
.receipt__row { min-height: 26px; }
.receipt__line { font-size: 16px; flex-grow: 1; flex-shrink: 1; white-space: normal; }
.receipt__line-value { font-size: 16px; -unity-text-align: middle-right; min-width: 100px; }
.receipt__line-value--damaged { color: rgb(190, 40, 30); }
.receipt__was { font-size: 14px; color: rgb(140, 132, 116); margin-right: 6px; }
.receipt__total { margin-top: 4px; }

.receipt__total-label {
    -unity-font-definition: url("../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf");
    font-size: 24px;
    flex-grow: 1;
}

.receipt__total-value {
    -unity-font-definition: url("../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf");
    font-size: 34px;
}

.receipt__stamp {
    position: absolute;
    right: 24px; bottom: 74px;
    font-size: 54px;
    border-width: 6px;
    background-color: rgba(238, 231, 212, 0.35);
}

.appraisal__side { flex-grow: 1; flex-shrink: 1; }
.appraisal__buttons { margin-top: 14px; }

.award { min-height: 30px; }
.award__icon { margin-right: 10px; -unity-background-image-tint-color: var(--c-accent); }
.award__text { margin-bottom: 0; color: var(--c-text); }

.tally { min-height: 30px; border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.tally__label { font-size: 18px; color: var(--c-dim); flex-grow: 1; }
.tally__value {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 24px;
    color: var(--c-text);
}

.tally--total .tally__label { color: var(--c-text); }
.tally--total .tally__value { font-size: 30px; }

/* ---- HQ supply terminal: amber CRT (UI step 8) ---- */

.crt {
    width: 1080px;
    max-width: 94%;
    background-color: rgb(30, 26, 20);
    border-top-width: 0;
    padding: 26px 26px 26px 26px;
    border-radius: 18px;
}

.crt__screen {
    background-color: var(--c-crt-bg);
    border-radius: 14px;
    padding: 22px 28px 18px 28px;
    border-width: 3px;
    border-color: rgb(60, 44, 18);
    overflow: hidden;
}

.crt__scanlines {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-repeat: repeat repeat;
    background-size: 4px 4px;
}

.crt__title, .crt__line, .crt__rule, .crt__name, .crt__note, .crt__price, .crt__about, .crt__cursor, .crt__button {
    -unity-font-definition: url("../ThirdParty/Fonts/VT323/VT323-Regular.ttf");
    color: var(--c-crt);
    text-shadow: 0 0 6px rgba(255, 176, 0, 0.55);
}

.crt__title { font-size: 34px; }
.crt__line { font-size: 24px; }
.crt__rule { font-size: 22px; color: rgba(255, 176, 0, 0.55); overflow: hidden; white-space: nowrap; }
.crt__list { max-height: 440px; min-height: 300px; }

.crt__button {
    font-size: 26px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0 10px 0 0;
    margin: 0 12px 0 0;
}

.crt__button:hover, .crt__button--on { color: var(--c-crt-bg); background-color: var(--c-crt); text-shadow: none; }

.crt__row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 2px 6px 2px 6px;
    min-height: 34px;
}

.crt__row:hover { background-color: var(--c-crt); }
.crt__row:hover .crt__name, .crt__row:hover .crt__note, .crt__row:hover .crt__price { color: var(--c-crt-bg); text-shadow: none; }
.crt__row--locked .crt__name, .crt__row--locked .crt__price { color: rgba(255, 176, 0, 0.4); }
.crt__row--cant .crt__price { color: rgba(255, 176, 0, 0.55); }

.crt__name { font-size: 28px; flex-grow: 1; }
.crt__note { font-size: 22px; width: 150px; -unity-text-align: middle-right; color: rgba(255, 176, 0, 0.7); }
.crt__price { font-size: 28px; width: 150px; -unity-text-align: middle-right; }
.crt__about { font-size: 24px; min-height: 58px; white-space: normal; margin-top: 8px; }
.crt__cursor { font-size: 26px; }

/* The gear rack's buttons show the gear. */
.rack__item { flex-direction: row; align-items: center; padding-left: 8px; }
.rack__icon { margin-right: 6px; }

/* ---- Contract board: job sheets pinned to cork (UI step 8) ---- */

.board__cork {
    background-color: rgb(120, 86, 52);
    padding: 22px 16px 22px 16px;
    border-width: 6px;
    border-color: rgb(70, 50, 30);
    border-radius: 4px;
}

.sheet {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 10px 0 10px;
    padding: 22px 18px 16px 18px;
    background-color: var(--c-paper);
    border-bottom-width: 4px;
    border-bottom-color: rgb(205, 196, 172);
}

.sheet__pin {
    position: absolute;
    top: 6px; left: 50%;
    width: 16px; height: 16px;
    margin-left: -8px;
    border-radius: 8px;
    background-color: rgb(200, 40, 34);
    border-bottom-width: 3px;
    border-bottom-color: rgb(120, 20, 16);
}

.sheet__place {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(110, 102, 88);
}

.sheet__job {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf");
    font-size: 34px;
    color: var(--c-paper-ink);
    white-space: normal;
}

.sheet__quip { font-size: 16px; color: rgb(110, 102, 88); -unity-font-style: italic; white-space: normal; margin-bottom: 6px; }
.sheet__text { font-size: 16px; color: var(--c-paper-ink); white-space: normal; margin-bottom: 8px; }

.sheet__fact {
    min-height: 26px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 38, 32, 0.15);
}

.sheet__fact-label {
    -unity-font-definition: url("../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 14px;
    color: rgb(110, 102, 88);
    flex-grow: 1;
}

.sheet__fact-value, .sheet__fact-value--warn {
    -unity-font-definition: url("../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf");
    font-size: 16px;
    color: var(--c-paper-ink);
}

.sheet__fact-value--warn { color: rgb(190, 40, 30); }
.sheet__take { margin: 12px 0 0 0; align-self: stretch; }
.sheet__stamp { position: absolute; top: 40%; left: 18%; font-size: 52px; }

/* Wardrobe with a turning preview (UI step 8). */
.wardrobe__columns { align-items: flex-start; flex-shrink: 1; }

.wardrobe__preview {
    width: 360px; height: 450px;
    flex-shrink: 0;
    margin-right: 24px;
    border-width: 2px;
    border-color: var(--c-line);
    border-radius: 4px;
    -unity-background-scale-mode: scale-and-crop;
}

.wardrobe__choices { flex-grow: 1; max-height: 560px; }

/* ---- The drive between levels (UI step 9) ---- */

.travel {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(6, 7, 8);
    justify-content: space-between;
}

.travel__tape { height: 14px; }
.travel__middle { flex-grow: 1; align-items: center; justify-content: center; }
.travel__van .icon { -unity-background-image-tint-color: var(--c-accent); width: 72px; height: 72px; }

.travel__where {
    -unity-font-definition: url("../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 64px;
    color: var(--c-text);
    margin-top: 18px;
}

.travel__terms {
    -unity-font-definition: url("../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 24px;
    letter-spacing: 2px;
    color: var(--c-accent);
    margin-top: 6px;
}

.travel__road {
    width: 420px; height: 4px;
    margin-top: 26px;
    background-color: var(--c-panel-3);
}

.travel__tip {
    font-size: 19px;
    color: var(--c-dim);
    -unity-text-align: middle-center;
    margin-bottom: 30px;
}
