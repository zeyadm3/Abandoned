/* Compact salvage/VHS field instruments. The final stylesheet in UiThemeAssets. */
.field-hud {
    color: rgb(214, 198, 161);
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
}
.field-hud Label { font-size: 14px; -unity-font-style: normal; margin: 0; padding: 0; }
.field-panel {
    background-color: rgba(15, 18, 19, 0.88);
    border-width: 1px;
    border-color: rgba(159, 136, 100, 0.42);
    border-radius: 0;
    padding: 7px 9px;
}
.field-hud .field-vitals {
    position: absolute; left: 28px; bottom: 28px; top: auto; right: auto;
    width: 220px; min-width: 0; min-height: 0; margin: 0; padding: 7px 9px;
    border-width: 1px; border-color: rgba(159, 136, 100, 0.42);
}
.field-meter-row { flex-direction: row; align-items: center; margin-bottom: 6px; padding-bottom: 6px; border-bottom-width: 1px; border-bottom-color: rgba(159, 136, 100, 0.22); }
.field-meter-row--last { margin-bottom: 0; padding-bottom: 0; border-bottom-width: 0; }
.field-hud .field-meter-caption { width: 64px; flex-shrink: 0; font-size: 11px; }
.field-hud .field-meter { flex-grow: 1; min-width: 12px; height: 7px; margin: 0 8px 0 0; border-width: 0; border-radius: 0; background-color: rgba(150, 135, 100, 0.25); }
.field-meter-number { width: 37px; -unity-text-align: middle-right; }
.field-hud .field-health .bar__fill { background-color: rgb(229, 106, 78); border-radius: 0; }
.field-hud .field-stamina .bar__fill { background-color: rgb(206, 200, 140); border-radius: 0; }
.field-hud .field-load .bar__fill { background-color: rgb(184, 177, 150); border-radius: 0; }
.field-hud .field-power { position: absolute; top: 28px; right: 28px; width: 205px; flex-direction: row; align-items: center; }
.field-power__caption { flex-grow: 1; }
.field-power__number { margin-right: 9px; }
.field-hud .field-battery { width: 54px; height: 12px; flex-shrink: 0; }
.field-battery .segment { background-color: rgba(153, 157, 128, 0.2); margin-right: 2px; border-width: 0; border-radius: 0; }
.field-battery .segment__fill { background-color: rgb(182, 197, 151); border-radius: 0; }
.field-battery .segment__fill--bad { background-color: rgb(229, 106, 78); }
.field-frame { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.field-recording { position: absolute; top: 28px; left: 28px; }
.field-rec { flex-direction: row; align-items: center; align-self: flex-start; padding: 1px 7px; border-width: 1px; border-color: rgba(159, 136, 100, 0.42); background-color: rgba(15, 18, 19, 0.75); }
.field-hud .field-rec__text { font-size: 16px; }
.field-rec__dot { width: 9px; height: 9px; margin-left: 8px; border-radius: 5px; background-color: rgb(222, 62, 48); }
.field-hud .field-recording__line { font-size: 12px; margin-top: 3px; }
.field-mission { position: absolute; top: 28px; left: 50%; translate: -50% 0; width: 380px; align-items: center; }
.field-objective { width: 100%; flex-direction: row; align-items: center; padding: 6px 9px; }
.field-hud .field-objective__caption { font-size: 12px; margin-right: 10px; color: rgb(196, 175, 123); flex-shrink: 0; }
.field-hud .field-objective__text { font-size: 12px; white-space: normal; flex-shrink: 1; min-width: 0; padding-left: 10px; border-left-width: 1px; border-left-color: rgba(159, 136, 100, 0.3); }
.field-extraction { flex-direction: row; align-items: center; margin-top: 5px; padding: 3px 10px; }
.field-hud .field-extraction__caption { font-size: 13px; color: rgb(182, 197, 151); margin-right: 10px; }
.field-hud .field-extraction__time { font-size: 17px; color: rgb(182, 197, 151); padding-left: 10px; border-left-width: 1px; border-left-color: rgba(153, 172, 121, 0.35); }
.field-mission--departing .field-extraction { border-color: rgb(185, 86, 58); }
.field-mission--departing .field-extraction__caption,
.field-mission--departing .field-extraction__time { color: rgb(237, 113, 87); }
.field-hud .field-departure-status { font-size: 12px; margin-top: 5px; }
.field-hud .field-compass { position: absolute; top: 112px; left: 50%; translate: -50% 0; width: 150px; height: 23px; overflow: hidden; }
.field-compass__tape { position: absolute; height: 22px; top: 0; left: 0; }
.field-hud .field-compass__mark { position: absolute; top: 0; font-size: 12px; translate: -50% 0; white-space: nowrap; }
.field-compass__needle { position: absolute; bottom: 0; left: 50%; width: 1px; height: 4px; background-color: rgb(214, 198, 161); }
.field-pockets { position: absolute; left: 24px; top: 35%; width: 34px; border-left-width: 1px; border-left-color: rgba(159, 136, 100, 0.42); background-color: rgba(15, 18, 19, 0.35); }
.field-hud .field-pocket { font-size: 13px; height: 42px; -unity-text-align: middle-center; color: rgb(185, 173, 145); border-left-width: 2px; border-left-color: transparent; }
.field-hud .field-pocket--active { color: rgb(255, 180, 156); background-color: rgba(136, 53, 34, 0.4); border-left-color: rgb(237, 113, 87); }
.field-hud .field-inventory { position: absolute; width: 290px; left: 50%; top: 50%; translate: -50% -50%; padding: 12px; }
.field-hud .field-inventory__title { font-size: 13px; margin-bottom: 8px; }
.field-inventory__slot { flex-direction: row; align-items: center; padding: 6px 8px; margin-bottom: 4px; min-height: 34px; background-color: rgb(30, 35, 35); border-width: 1px; border-color: rgba(120, 108, 84, 0.2); }
.field-inventory__slot--active { background-color: rgb(60, 48, 40); border-color: rgb(164, 133, 97); }
.field-hud .field-inventory__key { font-size: 12px; width: 28px; flex-shrink: 0; color: rgb(185, 173, 145); }
.field-hud .field-inventory__name { font-size: 12px; white-space: normal; min-width: 0; flex-shrink: 1; }
.field-hud .field-inventory__selected { font-size: 12px; margin-top: 5px; white-space: normal; }
.field-hud .field-inventory__stats,
.field-hud .field-inventory__hint { font-size: 11px; margin-top: 4px; white-space: normal; color: rgb(185, 173, 145); }
.field-hud .field-carry,
.field-hud .field-switch { position: absolute; bottom: 31px; left: 31%; right: 31%; -unity-text-align: middle-center; font-size: 13px; white-space: normal; }
.field-hud .field-cargo { position: absolute; right: 28px; bottom: 28px; width: 220px; }
.field-cargo__row { flex-direction: row; align-items: center; justify-content: space-between; padding-bottom: 5px; margin-bottom: 5px; border-bottom-width: 1px; border-bottom-color: rgba(159, 136, 100, 0.22); }
.field-cargo__row--last { padding-bottom: 0; margin-bottom: 0; border-bottom-width: 0; }
.field-hud .field-cargo__caption { font-size: 12px; }
.field-hud .field-cargo__value { font-size: 16px; color: rgb(207, 171, 105); }
.field-hud .field-cargo__quota { font-size: 13px; color: rgb(170, 158, 132); }
.field-hud .field-cargo__quota--met { color: rgb(150, 190, 120); }
.field-hud .field-cargo__weight { font-size: 12px; margin-right: 9px; flex-shrink: 0; }
.field-hud .field-cargo .field-load { max-width: 95px; margin-right: 0; }
.field-hud .field-prompt { position: absolute; min-width: 0; max-width: 260px; padding: 4px 6px; translate: 8px -50%; background-color: rgba(15, 18, 19, 0.78); }
.field-hud .field-prompt Label { font-size: 12px; white-space: normal; }
.field-hud .field-prompt .keycap { min-width: 16px; height: 18px; padding: 0 3px; font-size: 11px; }
.field-hud .field-reticle { position: absolute; left: 50%; top: 50%; width: 30px; height: 26px; translate: -50% -50%; border-width: 0; background-color: transparent; }
.field-hud .field-reticle .h-reticle__corner { width: 5px; height: 5px; border-color: rgb(214, 198, 161); }
.field-hud .field-throw { position: absolute; left: 50%; bottom: 63px; top: auto; width: 100px; translate: -50% 0; height: 3px; background-color: rgba(214, 198, 161, 0.2); }
.field-hud .field-throw-fill { height: 3px; background-color: rgb(214, 198, 161); }
.field-hud .loot-tag { padding: 5px 7px; max-width: 245px; border-width: 1px; background-color: rgba(15, 18, 19, 0.88); }
.field-hud .loot-tag__value { font-size: 16px; }
.field-hud .loot-tag__name { font-size: 12px; }
.field-hud .loot-tag__meta { margin-top: 3px; }
.field-hud .loot-tag .tag { font-size: 11px; padding: 1px 4px; }
.field-hud--compact .field-vitals { width: 195px; }
.field-hud--compact .field-cargo { width: 195px; }
.field-hud--compact .field-power { width: 190px; }
.field-hud--compact .field-mission { width: 320px; }
.field-hud--compact .field-carry,
.field-hud--compact .field-switch { bottom: 115px; left: 23%; right: 23%; }
.field-hud--compact .field-throw { bottom: 138px; }
.field-hud--compact .field-meter-caption { width: 57px; }
.field-hud--compact .field-meter-row Label { font-size: 12px; }
.field-hud--compact .field-meter-row .field-meter-caption { font-size: 10px; }
.colorblind .field-hud .field-health .bar__fill,
.colorblind .field-hud .segment__fill--bad { background-color: rgb(240, 158, 70); }
.colorblind .field-hud .field-stamina .bar__fill { background-color: rgb(117, 191, 224); }
.colorblind .field-hud .field-pocket--active { border-left-color: rgb(117, 191, 224); color: rgb(160, 213, 237); }
