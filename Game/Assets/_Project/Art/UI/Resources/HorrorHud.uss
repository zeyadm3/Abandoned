/* ABANDONED / survival instruments. Code-built silhouettes and traces; no copied reference artwork.
   Scope stays on the gameplay layer. Supporting data is monospaced; titles share the logo's stencil. */
.horror-hud {
    --h-bone: rgb(217, 207, 184);
    --h-muted: rgb(147, 143, 129);
    --h-faint: rgba(217, 207, 184, 0.25);
    --h-rust: rgb(172, 87, 67);
    --h-amber: rgb(186, 154, 98);
    --h-ink: rgba(13, 15, 14, 0.88);
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    color: var(--h-bone);
}
.horror-hud .h-instrument-title {
    -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--h-bone);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}
.horror-hud .h-micro {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: var(--h-muted);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}
.horror-hud .h-instrument-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}
.horror-hud .h-instrument-caption,
.horror-hud .h-instrument-value {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: var(--h-bone);
    padding: 0;
    margin: 0;
}
.horror-hud .h-instrument-caption { color: var(--h-muted); }

/* Vitals: one worn recovery instrument; the numeric reading and ten ticks remain unambiguous. */
.horror-hud .h-vitals {
    left: 28px;
    bottom: 40px;
    width: 216px;
    padding: 12px 14px 10px 12px;
    background-color: var(--h-ink);
    border-width: 0;
    border-left-width: 2px;
    border-left-color: var(--h-faint);
    border-top-width: 1px;
    border-top-color: var(--h-faint);
}
.horror-hud .h-vitals__row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 10px;
}
.horror-hud .h-vitals__body { width: 66px; height: 98px; flex-shrink: 0; margin-right: 8px; }
.horror-hud .h-vitals__readout { flex-grow: 1; min-width: 0; }
.horror-hud .h-vitals__readout .h-micro { font-size: 15px; letter-spacing: 0; }
.horror-hud .h-vitals__number { flex-direction: row; align-items: flex-end; }
.horror-hud .h-vitals__value {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf");
    font-size: 34px;
    letter-spacing: -2px;
    color: var(--h-bone);
    margin: 0;
    padding: 0;
}
.horror-hud .h-vitals__max { font-size: 15px; color: var(--h-muted); margin: 0 0 5px 4px; padding: 0; }
.horror-hud .h-vitals__pulse { height: 23px; width: 100%; margin-top: 2px; }
.horror-hud .h-vitals__state { font-size: 15px; letter-spacing: 1px; color: var(--h-muted); margin: 2px 0 0 0; padding: 0; }
.horror-hud .h-vitals--warning .h-vitals__value,
.horror-hud .h-vitals--warning .h-vitals__state { color: var(--h-amber); }
.horror-hud .h-vitals--critical { border-left-color: var(--h-rust); }
.horror-hud .h-vitals--critical .h-vitals__value,
.horror-hud .h-vitals--critical .h-vitals__state { color: var(--h-rust); }
.horror-hud .h-breath { border-top-width: 1px; border-top-color: var(--h-faint); padding-top: 8px; }
.horror-hud .h-breath__bar {
    height: 18px;
    border-width: 0;
    background-color: rgba(217, 207, 184, 0.05);
    overflow: hidden;
}
.horror-hud .h-breath__bar .bar__fill { height: 100%; background-color: rgba(186, 154, 98, 0.14); border-right-width: 1px; border-right-color: var(--h-amber); }
.horror-hud .h-breath__state { margin: 3px 0 0 0; padding: 0; font-size: 15px; letter-spacing: 1px; color: var(--h-muted); }
.horror-hud .h-breath--exhausted .h-instrument-value,
.horror-hud .h-breath--exhausted .h-breath__state { color: var(--h-rust); }
.horror-hud .h-breath--exhausted .bar__fill { border-right-color: var(--h-rust); background-color: rgba(172, 87, 67, 0.15); }
.horror-hud .h-power { margin-top: 8px; }
.horror-hud .h-power__bar { height: 3px; border-width: 0; background-color: rgba(217, 207, 184, 0.1); }
.horror-hud .h-power__bar .bar__fill { background-color: var(--h-amber); }
.horror-hud .h-power--low .h-instrument-value { color: var(--h-rust); }
.horror-hud .h-power--low .bar__fill { background-color: var(--h-rust); }
.horror-hud .h-vitals__load { margin: 8px 0 0 0; padding: 0; font-size: 15px; letter-spacing: 0; color: var(--h-muted); white-space: normal; }
.horror-hud .h-vitals__load--heavy { color: var(--h-amber); }

/* Inventory: gear cases and numbered fabric-pocket labels with a persistent active item. */
.horror-hud .h-inventory {
    right: 28px;
    bottom: 40px;
    width: 460px;
    max-width: none;
    flex-direction: column;
    align-items: stretch;
    opacity: 1;
}
.horror-hud .h-inventory__header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 7px; }
.horror-hud .h-inventory__header .h-instrument-title { font-size: 18px; letter-spacing: 1px; flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.horror-hud .h-inventory__header .h-micro { flex-shrink: 0; }
.horror-hud .h-inventory__gear { flex-direction: row; margin-bottom: 12px; }
.horror-hud .h-inventory__pockets { flex-direction: row; flex-wrap: nowrap; align-items: flex-end; }
.horror-hud .h-item {
    width: auto;
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    height: 126px;
    margin: 0 6px 0 0;
    padding: 5px 7px;
    background-color: rgba(15, 17, 15, 0.88);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(217, 207, 184, 0.17);
    border-bottom-width: 2px;
    border-bottom-color: rgba(147, 143, 129, 0.4);
    align-items: stretch;
    justify-content: flex-start;
    translate: 0 0;
    transition-property: border-color;
    transition-duration: 0.12s;
}
.horror-hud .h-item--gear { flex-grow: 1; flex-basis: 0; width: auto; height: 86px; }
.horror-hud .h-item--last { margin-right: 0; }
.horror-hud .h-item.slot--active {
    border-width: 1px;
    border-color: var(--h-amber);
    border-bottom-width: 2px;
    border-bottom-color: var(--h-amber);
    background-color: rgba(45, 39, 28, 0.88);
    translate: 0 0;
}
.horror-hud .h-item__key {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    position: relative;
    left: auto;
    top: auto;
    color: var(--h-muted);
    font-size: 15px;
    margin: 0;
    padding: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.horror-hud .h-item.slot--active .h-item__key { color: var(--h-amber); }
.horror-hud .h-item__icon { width: 40px; max-width: 100%; height: 40px; min-width: 0; min-height: 40px; align-self: center; margin: 3px 0 2px 0; background-size: contain; -unity-background-image-tint-color: var(--h-bone); }
.horror-hud .h-item__name { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 15px; color: var(--h-bone); margin: 0; padding: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.horror-hud .h-item__value {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    position: relative;
    right: auto;
    bottom: auto;
    font-size: 15px;
    color: var(--h-amber);
    margin: 1px 0 0 0;
    padding: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.horror-hud .h-item--gear .h-item__icon { position: absolute; left: 8px; top: 24px; width: 34px; height: 34px; min-width: 34px; min-height: 34px; margin: 0; }
.horror-hud .h-item--gear .h-item__name { margin-left: 44px; margin-top: 6px; }
.horror-hud .h-item--gear .h-item__value { margin-left: 44px; }
.horror-hud .h-item.slot--empty { background-color: rgba(13, 15, 14, 0.52); border-color: rgba(217, 207, 184, 0.1); }
.horror-hud .h-item.slot--empty .h-item__name,
.horror-hud .h-item.slot--empty .h-item__value { color: var(--h-muted); opacity: 0.7; }
.horror-hud .h-item.slot--empty .h-item__icon { opacity: 0; }

/* Hold-to-inspect card follows the actual inventory strip height, including backpack pockets. */
.horror-hud .h-inspection {
    position: absolute;
    right: 28px;
    width: 460px;
    max-width: none;
    padding: 14px;
    background-color: rgba(14, 16, 14, 0.96);
    border-width: 1px;
    border-color: var(--h-faint);
    border-top-width: 2px;
    border-top-color: var(--h-amber);
}
.horror-hud .h-inspection__selected { flex-direction: row; align-items: center; margin: 13px 0; }
.horror-hud .h-inspection__selected .icon { margin-right: 14px; -unity-background-image-tint-color: var(--h-bone); }
.horror-hud .h-inspection__copy { min-width: 0; flex-grow: 1; }
.horror-hud .h-inspection__name { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 20px; color: var(--h-bone); margin: 0; padding: 0; white-space: normal; }
.horror-hud .h-inspection__stats { font-size: 15px; color: var(--h-muted); margin: 5px 0 0 0; padding: 0; white-space: normal; }
.horror-hud .h-inspection__total { font-size: 15px; color: var(--h-amber); padding: 8px 0; margin: 0; border-top-width: 1px; border-top-color: var(--h-faint); }
.horror-hud .h-inspection__hint { font-size: 15px; color: var(--h-muted); margin: 0; padding: 0; white-space: normal; }

/* Navigation: a scarred tape below a compass bearing, with the existing Stalker direction warning. */
.horror-hud .h-navigation {
    top: 28px;
    height: 70px;
    max-width: 36%;
    background-color: rgba(13, 15, 14, 0.72);
    border-width: 0;
    border-top-width: 1px;
    border-top-color: var(--h-faint);
    border-bottom-width: 1px;
    border-bottom-color: var(--h-faint);
    overflow: visible;
}
.horror-hud .h-navigation__readout { flex-direction: row; justify-content: center; align-items: center; height: 36px; min-height: 36px; flex-shrink: 0; }
.horror-hud .h-navigation__direction { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 21px; color: var(--h-bone); padding: 0; margin: 0 12px; }
.horror-hud .h-navigation__bearing { font-size: 15px; color: var(--h-amber); padding: 0; margin: 0; }
.horror-hud .h-navigation__window { position: relative; height: 32px; min-height: 32px; flex-shrink: 0; overflow: hidden; }
.horror-hud .h-navigation .compass__point { font-size: 15px; color: var(--h-muted); -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); top: 4px; bottom: 0; }
.horror-hud .h-navigation .compass__point--cardinal { font-size: 17px; color: var(--h-bone); }
.horror-hud .h-navigation .compass__point--north { color: var(--h-amber); }
.horror-hud .h-navigation .compass__tick { top: 20px; bottom: 2px; background-color: var(--h-faint); }
.horror-hud .h-navigation .compass__needle { top: 0; height: 7px; background-color: var(--h-amber); }
.horror-hud .h-navigation .compass__threat { background-color: var(--h-rust); width: 3px; top: 2px; bottom: 2px; }

/* Tiny centre dot unfolds into four brackets only when there is something usable. */
.horror-hud .h-reticle { width: 3px; height: 3px; margin: -1.5px 0 0 -1.5px; background-color: var(--h-bone); border-width: 0; border-radius: 0; }
.horror-hud .h-reticle .h-reticle__corner { display: none; position: absolute; width: 6px; height: 6px; border-color: var(--h-bone); }
.horror-hud .h-reticle.hud-crosshair--target { width: 22px; height: 22px; margin: -11px 0 0 -11px; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; }
.horror-hud .h-reticle.hud-crosshair--target .h-reticle__corner { display: flex; }
.horror-hud .h-reticle__corner--nw { left: 0; top: 0; border-left-width: 1px; border-top-width: 1px; }
.horror-hud .h-reticle__corner--ne { right: 0; top: 0; border-right-width: 1px; border-top-width: 1px; }
.horror-hud .h-reticle__corner--sw { left: 0; bottom: 0; border-left-width: 1px; border-bottom-width: 1px; }
.horror-hud .h-reticle__corner--se { right: 0; bottom: 0; border-right-width: 1px; border-bottom-width: 1px; }
.horror-hud .h-reticle.hud-crosshair--hidden { opacity: 0; }
.horror-hud .h-interaction {
    position: absolute;
    left: 22%;
    right: 22%;
    top: 55%;
    align-items: center;
}
.horror-hud .h-interaction__context { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 18px; letter-spacing: 2px; color: var(--h-amber); padding: 2px 9px; margin: 0 0 5px 0; background-color: rgba(13, 15, 14, 0.78); }
.horror-hud .h-interaction__actions { position: relative; top: auto; left: auto; right: auto; flex-wrap: wrap; align-items: center; justify-content: center; }
.horror-hud .h-interaction .hud-prompt__part { border-radius: 0; padding: 5px 9px; margin: 0 2px 4px 2px; background-color: rgba(13, 15, 14, 0.92); border-bottom-width: 1px; border-bottom-color: var(--h-faint); max-width: 100%; min-width: 0; }
.horror-hud .h-interaction .hud-prompt__text { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); font-size: 17px; color: var(--h-bone); white-space: normal; min-width: 0; flex-shrink: 1; }
.horror-hud .h-interaction .keycap { color: var(--h-bone); border-color: rgba(217, 207, 184, 0.5); background-color: rgba(217, 207, 184, 0.04); font-size: 16px; min-width: 26px; margin-right: 8px; }
.horror-hud .h-interaction--hint .h-interaction__context,
.horror-hud .h-interaction--hint .hud-prompt__text { color: var(--h-rust); }
.horror-hud .h-throw { top: 65%; width: 180px; height: 27px; margin-left: -90px; background-color: rgba(13, 15, 14, 0.92); }
.horror-hud .h-throw__label { font-size: 15px; letter-spacing: 1px; color: var(--h-bone); -unity-text-align: middle-center; padding: 2px 0 4px 0; margin: 0; }
.horror-hud .h-throw .hud-charge__fill { position: absolute; bottom: 0; left: 0; height: 3px; background-color: var(--h-amber); }
.horror-hud .h-floor-warning { left: 28px; right: 28px; top: 40%; bottom: auto; translate: 0 0; width: auto; min-width: 0; white-space: normal; -unity-text-align: middle-center; }

/* The salvage scan is a single meter and a deadline, leaving the centre available for exploration. */
.horror-hud .h-recovery { left: auto; right: 28px; top: 28px; width: 340px; max-width: 28%; padding: 12px 14px; background-color: var(--h-ink); border-top-width: 1px; border-top-color: var(--h-faint); border-left-width: 2px; border-left-color: var(--h-amber); translate: 0 0; align-items: stretch; }
.horror-hud .h-recovery .run-haul__row { background-color: rgba(0, 0, 0, 0); padding: 6px 0 4px 0; border-width: 0; flex-wrap: wrap; }
.horror-hud .h-recovery .run-haul__amount { font-size: 29px; color: var(--h-bone); letter-spacing: -1px; margin: 0; padding: 0; }
.horror-hud .h-recovery .run-haul__quota { font-size: 17px; color: var(--h-muted); margin-left: 7px; margin-bottom: 3px; padding: 0; }
.horror-hud .h-recovery .run-haul__bar { width: 100%; height: 4px; border-width: 0; margin-top: 0; background-color: rgba(217, 207, 184, 0.12); }
.horror-hud .h-recovery .run-haul__bar .bar__fill { background-color: var(--h-amber); }
.horror-hud .h-recovery .run-haul__cargo { font-size: 15px; letter-spacing: 0; color: var(--h-muted); margin: 8px 0 0 0; padding: 0; white-space: normal; }
.horror-hud .h-recovery .run-haul__cargo--bad { color: var(--h-rust); }
.horror-hud .h-recovery__goals { font-size: 15px; color: var(--h-bone); margin: 7px 0 0 0; padding: 0; white-space: normal; }
.horror-hud .h-recovery .run-haul__met { position: relative; align-self: flex-start; font-size: 15px; color: var(--h-amber); background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 4px 0 0 0; margin: 0; scale: 1 1; opacity: 0; }
.horror-hud .h-recovery .run-haul__met--on { opacity: 1; }
.horror-hud .h-recovery .run-haul__met { min-width: 0; max-width: 100%; white-space: normal; }
.horror-hud .h-recovery--compact .run-haul__row { flex-direction: column; align-items: flex-start; }
.horror-hud .h-recovery--compact .run-haul__quota { margin-left: 0; margin-top: 2px; }
.horror-hud .h-window { position: relative; left: auto; right: auto; top: auto; width: auto; flex-direction: row; align-items: center; justify-content: space-between; border-width: 0; border-top-width: 1px; border-top-color: var(--h-faint); padding: 8px 0 0 0; margin: 8px 0 0 0; background-color: rgba(0, 0, 0, 0); }
.horror-hud .h-window .h-micro { flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: normal; margin-right: 12px; }
.horror-hud .h-window .run-clock__time { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf"); font-size: 20px; color: var(--h-bone); margin: 0; padding: 0; flex-shrink: 0; }
.horror-hud .h-window.run-clock--late .run-clock__time,
.horror-hud .h-window.run-clock--late .h-micro { color: var(--h-rust); }
.horror-hud .h-departure { top: 20%; left: 29%; right: 29%; bottom: auto; padding: 18px 20px; align-items: center; background-color: rgba(22, 15, 12, 0.96); border-width: 1px; border-color: var(--h-rust); border-top-width: 3px; border-bottom-width: 3px; }
.horror-hud .h-departure .truck-banner__title { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 27px; letter-spacing: 1px; color: var(--h-rust); margin: 6px 0 0 0; padding: 0; white-space: normal; }
.horror-hud .h-departure .truck-banner__count { font-size: 72px; color: var(--h-bone); padding: 0; margin: 0; }
.horror-hud .h-departure .truck-banner__status { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); font-size: 20px; letter-spacing: 1px; color: var(--h-rust); margin: 12px 0 0 0; padding: 0; white-space: normal; }
.horror-hud .h-departure .truck-banner__status--good { color: var(--h-amber); }
.horror-hud .h-departure .truck-banner__title,
.horror-hud .h-departure .truck-banner__status { max-width: 100%; -unity-text-align: middle-center; }

/* A compact panel state uses the scaled UI viewport, so the 1.5x setting keeps the centre clear. */
.horror-hud .h-vitals--compact { width: 196px; left: 20px; bottom: 32px; padding: 8px 10px; }
.horror-hud .h-vitals--compact .h-vitals__body { width: 55px; height: 74px; }
.horror-hud .h-vitals--compact .h-vitals__value { font-size: 29px; }
.horror-hud .h-vitals--compact .h-vitals__row { margin-top: 4px; margin-bottom: 6px; }
.horror-hud .h-vitals--compact .h-breath { padding-top: 5px; }
.horror-hud .h-inventory--compact { width: 388px; right: 20px; bottom: 32px; }
.horror-hud .h-inventory--compact .h-item { width: auto; height: 114px; }
.horror-hud .h-inventory--compact .h-item--gear { width: auto; height: 84px; }
.horror-hud .h-inventory--compact .h-inventory__gear { margin-bottom: 6px; }
.horror-hud .h-inventory--compact .h-item--pocket .h-item__icon { width: 28px; height: 28px; min-width: 0; min-height: 28px; }
.horror-hud .h-inventory--compact .h-item--gear .h-item__key { position: relative; left: auto; top: auto; }
.horror-hud .h-inventory--compact .h-item--gear .h-item__icon { left: 8px; top: 30px; width: 34px; height: 34px; min-width: 34px; min-height: 34px; }
.horror-hud .h-inventory--compact .h-item--gear .h-item__name { position: relative; left: auto; right: auto; top: auto; margin-left: 44px; margin-top: 4px; }
.horror-hud .h-inventory--compact .h-item--gear .h-item__value { position: relative; left: auto; right: auto; bottom: auto; margin-left: 44px; }
.horror-hud .h-inventory--dense .h-item--pocket { padding-left: 3px; padding-right: 3px; }
.horror-hud .h-inspection--compact { width: 388px; right: 20px; padding: 10px; }
.horror-hud .h-inspection--compact .h-inspection__name { font-size: 18px; }

/* Condition words and meter shape carry the meaning; the alternate palette is also explicit. */
.colorblind .horror-hud { --h-rust: rgb(222, 153, 84); --h-amber: rgb(134, 184, 213); }
