/* 2026 remake, after the handover: the screens laid out again in the clean modern horror style. Loaded after
   Remake2026.uss. Layout only through flex, spacing and borders (no absolute positions), so every language still fits;
   the classes are the ones the screens already use. */

/* ---------- screen panels (ScreenPanel's archive panel): a flat sheet, a thin accent edge ---------- */

.archive-panel {
    background-color: var(--c-panel);
    background-image: none;
    border-width: 1px;
    border-color: var(--c-line);
    border-left-width: 3px;
    border-left-color: var(--c-accent);
    border-radius: 0;
    padding: 30px 36px 24px 40px;
}

.archive-panel .heading { letter-spacing: 7px; color: var(--c-text); }
.archive-panel .subtitle { color: var(--c-dim); margin-bottom: 14px; }

/* ---------- the contract board: three equal job cards, no cork, no tilt ---------- */

.archive-panel .board__cork {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    padding: 0;
}

.archive-panel .board__cork .sheet {
    flex-basis: 30%;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 8px 12px 0;
    padding: 18px 18px 14px 18px;
    background-color: var(--c-panel-2);
    background-image: none;
    border-width: 1px;
    border-color: var(--c-line);
    border-top-width: 3px;
    border-top-color: var(--c-accent);
    border-bottom-width: 1px;
    border-bottom-color: var(--c-line);
    rotate: 0deg;
}

.archive-panel .sheet__place { color: var(--c-text); letter-spacing: 4px; font-size: 22px; }
.archive-panel .sheet__job { color: var(--c-accent); letter-spacing: 3px; font-size: 14px; margin-bottom: 8px; }
.archive-panel .sheet__text { color: var(--c-dim); font-size: 15px; margin-bottom: 6px; white-space: normal; }
.archive-panel .sheet__quip { color: var(--c-faint); -unity-font-style: italic; font-size: 14px; margin-bottom: 8px; white-space: normal; }
.archive-panel .sheet__fact {
    border-top-width: 1px;
    border-top-color: var(--c-line);
    padding-top: 5px;
    padding-bottom: 5px;
}
.archive-panel .sheet__fact-label { color: var(--c-faint); letter-spacing: 2px; font-size: 13px; width: 38%; flex-shrink: 0; }
.archive-panel .sheet__fact-value { color: var(--c-text); font-size: 16px; }
.archive-panel .sheet__fact-value--warn { color: var(--c-bad); }
.archive-panel .sheet__fact-note { color: var(--c-faint); font-size: 12px; white-space: normal; }
.archive-panel .sheet__take { margin-top: 12px; align-self: stretch; -unity-text-align: middle-center; }
.archive-panel .sheet__stamp {
    border-width: 1px;
    border-color: var(--c-good);
    color: var(--c-good);
    background-color: rgba(140, 182, 150, 0.08);
    font-size: 16px;
    letter-spacing: 6px;
    rotate: 0deg;
}
.archive-panel .dispatch-briefing {
    border-left-width: 2px;
    border-left-color: var(--c-accent);
    background-color: rgba(214, 158, 72, 0.05);
    padding: 12px 16px;
    margin-bottom: 16px;
}

/* ---------- the appraisal: the receipt left, the payday right ---------- */

.appraisal__columns { flex-direction: row; align-items: flex-start; }
.receipt {
    flex-basis: 55%;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 22px;
    padding: 20px 24px;
    background-color: var(--c-panel-2);
    background-image: none;
    border-width: 1px;
    border-color: var(--c-line);
    border-top-width: 3px;
    border-top-color: var(--c-accent);
    color: var(--c-text);
}
.receipt__head { letter-spacing: 5px; color: var(--c-accent); }
.receipt__row, .receipt__line { border-bottom-width: 1px; border-bottom-color: var(--c-line); padding-top: 3px; padding-bottom: 3px; }
.receipt__line-value, .receipt__total-value { color: var(--c-text); }
.receipt__line-value--damaged { color: var(--c-bad); }
.receipt__was { color: var(--c-faint); }
.receipt__small { color: var(--c-faint); }
.receipt__rule { background-color: var(--c-line); height: 1px; }
.receipt__total { margin-top: 10px; padding-top: 8px; border-top-width: 2px; border-top-color: var(--c-accent); }
.receipt__total-label { letter-spacing: 4px; color: var(--c-dim); }
.receipt__total-value { font-size: 30px; color: var(--c-money); }
.receipt__stamp { rotate: 0deg; border-color: var(--c-good); color: var(--c-good); }
.appraisal__side { flex-basis: 40%; flex-grow: 1; flex-shrink: 1; }
.tally { border-bottom-width: 1px; border-bottom-color: var(--c-line); padding-top: 6px; padding-bottom: 6px; }
.tally__label { color: var(--c-dim); letter-spacing: 2px; }
.tally__value { color: var(--c-text); }
.tally--total .tally__value { color: var(--c-money); font-size: 26px; }
.award { background-color: var(--c-panel-2); border-left-width: 3px; border-left-color: var(--c-accent); padding: 8px 12px; margin-top: 8px; }
.appraisal__buttons { margin-top: 18px; flex-direction: row; flex-wrap: wrap; }

/* ---------- the travel screen: one column, the place large, a hairline progress ---------- */

.travel { background-color: rgb(6, 7, 8); }
.travel__where { color: var(--c-text); letter-spacing: 10px; }
.travel__middle { border-left-width: 3px; border-left-color: var(--c-accent); padding-left: 28px; }
.travel__terms { color: var(--c-dim); letter-spacing: 2px; }
.travel__tip { color: var(--c-faint); border-top-width: 1px; border-top-color: var(--c-line); padding-top: 10px; margin-top: 14px; }
.transfer__brand, .transfer__direction { letter-spacing: 6px; color: var(--c-accent); }
.transfer__status { color: var(--c-dim); }
.transfer__progress { height: 2px; background-color: var(--c-accent); }
.transfer__footer { color: var(--c-faint); border-top-width: 1px; border-top-color: var(--c-line); }

/* ---------- the HUD: pockets as tiles, a thinner compass, quiet danger marks ---------- */

.field-inventory__slot {
    background-color: rgba(8, 9, 10, 0.72);
    border-width: 1px;
    border-color: var(--c-line);
    border-radius: 0;
    margin-right: 6px;
}
.field-inventory__slot--active { border-color: var(--c-accent); border-bottom-width: 3px; background-color: rgba(214, 158, 72, 0.12); }
.field-inventory__key { color: var(--c-faint); }
.field-inventory__name { color: var(--c-text); }
.field-inventory__selected { color: var(--c-accent-hot); }
.field-compass__tape { background-color: rgba(6, 7, 8, 0.55); border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.field-compass__needle { background-color: var(--c-accent); width: 2px; }
.field-compass__mark { color: var(--c-dim); }
.horror-danger__mark { background-color: rgba(220, 224, 228, 0.12); border-radius: 0; }
.horror-danger__mark--on { background-color: var(--c-accent); }
.horror-danger__mark--last { background-color: var(--c-bad); }
.horror-radio { border-left-width: 3px; border-left-color: var(--c-accent); background-color: rgba(6, 7, 8, 0.8); }
.horror-radio__caption { color: var(--c-accent); letter-spacing: 3px; }
