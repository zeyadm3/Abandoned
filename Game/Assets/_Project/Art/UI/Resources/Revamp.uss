/* ABANDONED 0.22 UI revamp: "Company Issue" (Docs/UI_STYLE_GUIDE_0.22.md). Loaded after Menu.uss, so these
   rules win on equal specificity. Delete this file to return to the pre-0.22 look. */

/* ==== 0.22.1 theme and kit ==== */

:root, .menu-root {
    --c-ink: rgb(10, 11, 12);
    --c-panel: rgba(18, 21, 24, 0.97);
    --c-panel-2: rgb(27, 31, 35);
    --c-panel-3: rgb(40, 45, 50);
    --c-line: rgba(242, 190, 40, 0.18);
    --c-accent: rgb(242, 190, 40);
    --c-accent-hot: rgb(255, 214, 92);
    --c-accent-ink: rgb(18, 16, 8);
    --c-text: rgb(232, 232, 226);
    --c-dim: rgb(150, 156, 160);
    --c-faint: rgba(214, 218, 220, 0.6);
    --c-good: rgb(110, 200, 120);
    --c-bad: rgb(232, 84, 60);
    --c-money: rgb(150, 220, 140);
    --c-paper: rgb(214, 206, 180);
    --c-paper-ink: rgb(26, 28, 30);
    --c-crt: rgb(240, 186, 60);
    --c-crt-bg: rgb(12, 16, 14);
}

/* Panels: a yellow spine down the left and a rule on top; square. */
.panel {
    border-left-width: 6px;
    border-left-color: var(--c-accent);
    border-top-width: 2px;
    border-top-color: var(--c-line);
    border-radius: 0;
}

.backdrop { background-color: rgba(8, 10, 12, 0.55); }
.backdrop--dim { background-color: rgba(8, 10, 12, 0.85); }

/* Chips: square slate slabs with a yellow underline that fill yellow on hover or focus. */
.menu-button--small {
    border-radius: 0;
    border-bottom-width: 2px;
    border-bottom-color: var(--c-accent);
    background-color: var(--c-panel-3);
}

.menu-button--small:hover, .menu-button--small:focus {
    background-color: var(--c-accent);
    color: var(--c-accent-ink);
    border-bottom-color: var(--c-ink);
}

.menu-button--small:active { background-color: var(--c-accent-hot); }

/* Big menu buttons keep the words-only look; focus also shows a yellow bar on the left (for the pad, 0.23). */
.menu-button:focus { border-left-width: 4px; border-left-color: var(--c-accent); padding-left: 10px; }

/* Fields and sliders. */
.field > .unity-text-field__input, .field > .unity-base-text-field__input {
    background-color: var(--c-panel-2);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: var(--c-accent);
    border-radius: 0;
}

.setting { border-bottom-color: rgba(255, 255, 255, 0.06); }
.setting__value { color: var(--c-accent); -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf"); }

.setting__control.unity-base-slider--horizontal .unity-base-slider__tracker {
    background-color: var(--c-panel-3);
    height: 4px;
    margin-top: -2px;
}

.setting__control.unity-base-slider--horizontal .unity-base-slider__dragger {
    width: 10px;
    height: 22px;
    margin-top: -11px;
    border-radius: 0;
    border-width: 2px;
    border-color: var(--c-ink);
}

.unity-scroller--vertical .unity-base-slider__dragger { border-radius: 0; }

/* Key caps: yellow outline boxes, readable on any background. */
.keycap {
    color: var(--c-accent);
    background-color: rgba(10, 11, 12, 0.85);
    border-radius: 0;
    border-width: 2px;
    border-color: var(--c-accent);
    border-bottom-width: 2px;
    border-bottom-color: var(--c-accent);
}

.bar { border-radius: 0; border-color: rgba(242, 190, 40, 0.25); }
.tag { border-radius: 0; }
.stamp { border-radius: 0; }

/* Toggles: a square box that fills yellow. */
.unity-toggle__checkmark {
    background-color: var(--c-panel-2);
    border-color: var(--c-accent);
    border-width: 2px;
    border-radius: 0;
    width: 22px;
    height: 22px;
}

.unity-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: var(--c-accent);
    -unity-background-image-tint-color: var(--c-ink);
}

.hazard { height: 8px; }

/* ==== 0.22.2 in-job HUD ==== */

/* Haul and clock: on a slate plate with a yellow rule, numbers in a monospace that doesn't jitter. */
.run-haul > .run-haul__row {
    background-color: rgba(10, 11, 12, 0.62);
    padding: 2px 14px 2px 14px;
    border-bottom-width: 2px;
    border-bottom-color: var(--c-accent);
}
.run-haul__label { color: var(--c-accent); letter-spacing: 4px; }
.run-haul__amount { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf"); font-size: 30px; }
.run-haul__quota { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); font-size: 19px; }
.run-haul__bar { height: 4px; border-width: 0; }
.run-haul__cargo { color: var(--c-dim); }
.run-clock {
    background-color: rgba(10, 11, 12, 0.62);
    border-left-width: 4px;
    border-left-color: var(--c-accent);
    border-radius: 0;
}
.run-clock__time { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf"); }
.run-clock--late { border-left-color: var(--c-bad); }

/* Hand slots and pockets: square cases; the one in hand lifts with a yellow frame. */
.slot { border-radius: 0; border-width: 1px; border-color: rgba(242, 190, 40, 0.18); background-color: rgba(10, 11, 12, 0.75); }
.slot--active { border-width: 2px; border-color: var(--c-accent); translate: 0 -5px; }
.slot__key { color: var(--c-accent); }

/* Health blocks keep their colours from code; square, a hairline between. */
.segment { border-radius: 0; margin-right: 2px; background-color: rgba(10, 11, 12, 0.8); }

/* Compass: slate tape, yellow ticks and a yellow needle. */
.compass { background-color: rgba(10, 11, 12, 0.6); border-bottom-color: var(--c-accent); }
.compass__tick { background-color: rgba(242, 190, 40, 0.5); }
.compass__point--cardinal { color: var(--c-accent); }
.compass__needle { background-color: var(--c-accent); }

/* Prompts and the crosshair. */
.hud-prompt { -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); font-size: 22px; letter-spacing: 1px; }
.hud-crosshair { background-color: rgba(242, 190, 40, 0.9); border-radius: 0; width: 4px; height: 4px; margin-left: -2px; margin-top: -2px; }
.hud-crosshair--target { background-color: var(--c-accent-hot); width: 8px; height: 8px; margin-left: -4px; margin-top: -4px; }
.hud-hint, .first-day {
    background-color: rgba(10, 11, 12, 0.82);
    border-left-width: 4px;
    border-left-color: var(--c-accent);
    border-radius: 0;
}

/* 0.22.2: one-line callouts (charging, drone, thermal, ghost keys) and the vent crawl's blackout. */
.hud-callout {
    position: absolute;
    left: 50%; bottom: 17%;
    translate: -50% 0;
    padding: 4px 16px 4px 16px;
    background-color: rgba(10, 11, 12, 0.78);
    border-bottom-width: 2px;
    border-bottom-color: var(--c-accent);
    -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--c-text);
    white-space: nowrap;
}
.hud-blackout {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
}
.hud-blackout__text {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 26px;
    color: rgba(214, 218, 220, 0.7);
    letter-spacing: 4px;
}

/* ==== 0.22.3 world tags and feed ==== */

.loot-tag {
    border-radius: 0;
    background-color: rgba(10, 11, 12, 0.8);
    border-bottom-width: 2px;
}
.loot-tag__value { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf"); }
.loot-tag__name { -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1px; }

/* Pings (0.19.0, UI Toolkit since 0.22.3): a turned square and a label in the pinger's colour. */
.ping-mark { position: absolute; translate: -50% -100%; align-items: center; }
.ping-mark__diamond { width: 14px; height: 14px; rotate: 45deg; border-width: 2px; border-color: rgb(10, 11, 12); }
.ping-mark__text {
    margin-top: 6px;
    padding: 1px 8px 1px 8px;
    background-color: rgba(10, 11, 12, 0.8);
    -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 17px;
    letter-spacing: 2px;
}

/* Toasts: slate slips with a yellow spine; good and warn keep their colours. */
.toast { border-left-width: 5px; border-left-color: var(--c-accent); background-color: rgba(18, 21, 24, 0.95); border-radius: 0; }
.toast--good { border-left-color: var(--c-good); }
.toast--warn { border-left-color: var(--c-bad); }
.toast__title { color: var(--c-accent); -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf"); letter-spacing: 2px; }
.toast__body { color: var(--c-text); }

/* Subtitles: a solid strip behind the words, for reading over anything. */
.subtitle-line { background-color: rgba(10, 11, 12, 0.82); border-radius: 0; padding: 2px 10px 2px 10px; }

/* Chat. */
.chat__log { border-left-width: 3px; border-left-color: var(--c-line); }
.chat__field > .unity-text-field__input { background-color: var(--c-panel-2); border-width: 0; border-bottom-width: 2px; border-bottom-color: var(--c-accent); border-radius: 0; }

/* ==== 0.22.4 damage and death ==== */

/* The death card: the company's form for a lost employee. Red stamp title, slate slip for the cause. */
.death-card { background-color: rgba(14, 6, 6, 0.6); }
.death-card__title { color: var(--c-bad); letter-spacing: 14px; }
.death-card__cause {
    background-color: rgba(10, 11, 12, 0.85);
    border-left-width: 6px;
    border-left-color: var(--c-bad);
    padding: 6px 18px 6px 18px;
    -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
}
.death-card__note { color: var(--c-faint); }
.ghost-bar, .hud-ghost { background-color: rgba(10, 11, 12, 0.7); border-bottom-width: 2px; border-bottom-color: rgba(150, 156, 160, 0.6); }

/* The truck leaving: hazard yellow, the countdown in heavy monospace. */
.truck-banner { background-color: rgba(10, 11, 12, 0.9); border-top-width: 3px; border-bottom-width: 3px; border-color: var(--c-accent); }
.truck-banner__title { color: var(--c-accent); letter-spacing: 6px; }
.truck-banner__count { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf"); color: var(--c-text); }
.truck-banner__status { color: var(--c-bad); }
.truck-banner__status--good { color: var(--c-good); }

/* ==== 0.22.5 main menu and Play ==== */

.main__shade {
    background-color: rgba(10, 11, 12, 0.78);
    border-right-width: 4px;
    border-right-color: var(--c-accent);
}
.main__logo { color: var(--c-text); letter-spacing: 6px; }
.main__tape { height: 8px; }
.main__button { -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf"); letter-spacing: 2px; }
.main__memo { color: var(--c-faint); -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); font-size: 14px; }

/* Lit buttons: a yellow underline and no orange glow. */
.menu-button { border-bottom-color: rgba(242, 190, 40, 0); }
.menu-button--lit { border-bottom-color: var(--c-accent); color: var(--c-accent); text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.menu-button--pressed { color: var(--c-accent-hot); }

/* Play cards: three company forms side by side. */
.play__card {
    background-color: var(--c-panel-2);
    border-top-width: 4px;
    border-top-color: var(--c-accent);
    border-radius: 0;
}
.play__title { color: var(--c-accent); letter-spacing: 2px; }
.play__blurb { color: var(--c-dim); }

/* The Early Access notice and watermark. */
.ea-watermark { color: rgba(242, 190, 40, 0.45); -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); }

/* ==== 0.22.6 pause, crew and settings ==== */

.pause__left .title { color: var(--c-accent); }
.pause__crew {
    background-color: var(--c-panel);
    border-left-width: 6px;
    border-left-color: var(--c-accent);
    border-radius: 0;
}
.crew-row { border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); border-radius: 0; }
.crew-row__name { -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); font-size: 22px; }
.crew-row__ping { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); color: var(--c-dim); }
.crew-row__talking--on { background-color: var(--c-accent); }
.crew-row__volume.unity-base-slider--horizontal .unity-base-slider__dragger { border-radius: 0; background-color: var(--c-accent); }
.mic-meter { border-radius: 0; }

/* Settings: page names down the left as tabbed folders; the open one carries the yellow tab. */
.settings__nav { border-right-color: var(--c-accent); }
.settings__nav-button { -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); }
.settings__nav-button--open {
    color: var(--c-accent-ink);
    background-color: var(--c-accent);
    padding-left: 10px;
}
.settings__page-title { color: var(--c-accent); }
.choice__arrow { color: var(--c-accent); }
.choice__value { -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); }
.tab { border-radius: 0; }

/* ==== 0.22.7 HQ screens ==== */

/* Job sheets stay paper on the cork board, now company forms: a yellow header band, square, a stamped look. */
.sheet { border-top-width: 10px; border-top-color: var(--c-accent); border-radius: 0; }
.sheet__fact-value--warn { color: rgb(170, 40, 24); }

/* The supply terminal is a real CRT: it keeps its amber; only the frame squares off. */
.crt { border-radius: 2px; }

/* Gear rack, shop, truck upgrades and wardrobe tiles. */
.tile { border-radius: 0; border-width: 1px; border-color: rgba(242, 190, 40, 0.15); background-color: var(--c-panel-2); }
.tile:hover { border-color: var(--c-accent); }
.sheet__stamp { border-radius: 0; }

/* ==== 0.22.8 job-flow screens ==== */

/* The drive: a slate card with the company's yellow rule. */
.travel { background-color: rgb(10, 11, 12); }
.travel__where { color: var(--c-accent); }

/* The appraisal: the receipt stays paper; the side column is the company's verdict. */
.appraisal__side { border-left-width: 6px; border-left-color: var(--c-accent); background-color: var(--c-panel); }
.award { border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.award__icon { -unity-background-image-tint-color: var(--c-accent); }
.receipt { border-top-width: 10px; border-top-color: var(--c-accent); }

/* Security monitors (0.16.7, UI Toolkit since 0.22.8): the feed fills the screen, tinted like an old CRT. */
.monitor {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(190, 255, 205);
    justify-content: space-between;
    padding: 3% 4% 3% 4%;
}
.monitor__caption {
    -unity-font-definition: url("../../ThirdParty/Fonts/VT323/VT323-Regular.ttf");
    font-size: 34px;
    color: rgb(200, 255, 205);
    text-shadow: 0 0 6px rgba(120, 255, 140, 0.6);
}
.monitor__help {
    align-self: center;
    padding: 3px 14px 3px 14px;
    background-color: rgba(10, 11, 12, 0.75);
    border-bottom-width: 2px;
    border-bottom-color: var(--c-accent);
    -unity-font-definition: url("../../ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf");
    font-size: 19px;
    letter-spacing: 2px;
}

/* ==== 0.22.9 consistency ==== */

/* One focus highlight everywhere (0.23.0 drives focus with a pad): a yellow frame on anything focusable. */
.unity-button:focus, .unity-toggle:focus, .unity-slider:focus, .unity-text-field:focus, .tile:focus, .sheet:focus, .field-guide__entry:focus {
    border-color: var(--c-accent);
    border-width: 2px;
}
.unity-toggle:focus > .unity-toggle__input > .unity-toggle__checkmark { border-color: var(--c-accent-hot); }

/* Long text and long names (translations, Arabic, Cyrillic and CJK through the 0.19.9 fallbacks) wrap rather
   than run off a panel; numbers and key caps never wrap. */
.panel .text, .settings__note, .toast__body, .hud-hint, .play__blurb, .field-guide__body { white-space: normal; }
.keycap, .run-haul__amount, .truck-banner__count, .hud-callout { white-space: nowrap; }
.crew-row__name, .loot-tag__name { overflow: hidden; text-overflow: ellipsis; -unity-text-overflow-position: end; }
