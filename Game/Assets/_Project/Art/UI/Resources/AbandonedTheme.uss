/* ABANDONED — recovered instruments and weathered signs. Loaded after the legacy layout.
   The logo's Saira Stencil One is the sign language; IBM Plex Mono carries field records and numbers.
   Geometry remains square and restrained so the building stays visible through the HUD. */

.horror-theme {
    --c-ink: rgb(10, 10, 9);
    --c-panel: rgba(17, 16, 14, 0.97);
    --c-panel-2: rgb(27, 25, 22);
    --c-panel-3: rgb(40, 36, 31);
    --c-line: rgba(205, 190, 160, 0.24);
    --c-accent: rgb(177, 119, 86);
    --c-accent-hot: rgb(222, 170, 125);
    --c-accent-ink: rgb(16, 12, 10);
    --c-text: rgb(225, 216, 194);
    --c-dim: rgb(169, 161, 144);
    --c-faint: rgb(125, 119, 108);
    --c-good: rgb(158, 177, 149);
    --c-bad: rgb(212, 105, 83);
    --c-money: rgb(193, 184, 147);
    --c-paper: rgb(185, 174, 145);
    --c-paper-ink: rgb(31, 28, 23);
    --c-crt: rgb(193, 165, 111);
    --c-crt-bg: rgb(12, 14, 11);
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    color: var(--c-text);
}

/* Sign lettering is the same face as ABANDONED, across every destination. */
.horror-theme .font-display, .horror-theme .font-display-semi,
.horror-theme .heading, .horror-theme .section, .horror-theme .subtitle,
.horror-theme .menu-button, .horror-theme .tab,
.horror-theme .sheet__job, .horror-theme .receipt__title,
.horror-theme .tile__name, .horror-theme .settings__page-title,
.horror-theme .field-guide__cover-title, .horror-theme .field-guide__title,
.horror-theme .field-guide__section {
    -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    -unity-font-style: normal;
    letter-spacing: 1px;
}

.horror-theme .text, .horror-theme .text--small, .horror-theme .setting__label,
.horror-theme .setting__value, .horror-theme .choice__value,
.horror-theme .field, .horror-theme .sheet__text, .horror-theme .sheet__quip,
.horror-theme .sheet__fact-label, .horror-theme .sheet__fact-value,
.horror-theme .receipt__row, .horror-theme .hud-cell,
.horror-theme .toast__body, .horror-theme .death-card__note {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    -unity-font-style: normal;
    font-size: 16px;
    letter-spacing: 0;
}
.horror-theme .text { color: var(--c-dim); }
.horror-theme .text--error { color: var(--c-bad); }
.horror-theme .text--good { color: var(--c-good); }
.horror-theme .text--money { color: var(--c-money); }
.horror-theme .text--small { font-size: 15px; }
.horror-theme .heading { font-size: 42px; margin-bottom: 10px; }
.horror-theme .section { font-size: 21px; border-bottom-width: 1px; color: var(--c-accent-hot); }
.horror-theme .subtitle { font-size: 20px; color: var(--c-dim); }

/* Dark found-metal panels; the old yellow spine becomes a corroded hairline. */
.horror-theme .backdrop { background-color: rgba(7, 7, 6, 0.72); }
.horror-theme .backdrop--dim { background-color: rgba(7, 6, 5, 0.9); }
.horror-theme .panel, .horror-theme .hud-card {
    background-color: var(--c-panel);
    background-image: url("../HorrorGrime.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-radius: 0;
    border-width: 1px;
    border-color: var(--c-line);
    border-top-width: 3px;
    border-top-color: var(--c-accent);
    padding: 26px 32px 24px 32px;
}
.horror-theme .hud-card { padding: 16px; }
.horror-theme .hud-panel, .horror-theme .hud-callout {
    background-color: rgba(14, 13, 11, 0.88);
    background-image: url("../HorrorGrime.png");
    border-width: 1px;
    border-color: var(--c-line);
    border-left-width: 2px;
    border-left-color: var(--c-accent);
    border-radius: 0;
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 16px;
    color: var(--c-text);
    letter-spacing: 0;
}
.horror-theme .hud-callout { bottom: 22%; max-width: 64%; white-space: normal; }

/* Buttons read like old stencilled signs. Focus is a frame and a change in value, as well as colour. */
.horror-theme .menu-button {
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-text);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 190, 160, 0.12);
    padding: 6px 8px;
    font-size: 30px;
    transition-duration: 0.1s;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.8);
}
.horror-theme .menu-button--small {
    font-size: 18px;
    padding: 7px 12px;
    margin: 3px;
    background-color: var(--c-panel-2);
    border-width: 1px;
    border-color: var(--c-line);
    border-bottom-width: 2px;
    border-bottom-color: var(--c-accent);
    border-radius: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}
.horror-theme .menu-button:hover, .horror-theme .menu-button:focus,
.horror-theme .menu-button--lit { color: var(--c-accent-hot); border-bottom-color: var(--c-accent-hot); }
.horror-theme .menu-button--small:hover, .horror-theme .menu-button--small:focus {
    background-color: rgb(57, 39, 29);
    color: var(--c-text);
    border-color: var(--c-accent-hot);
}
.horror-theme .menu-button--on, .horror-theme .menu-button--pressed,
.horror-theme .tab--active {
    background-color: rgb(62, 40, 29);
    color: var(--c-text);
    border-color: var(--c-accent-hot);
}
.horror-theme .menu-button:disabled { opacity: 0.42; }
.horror-theme .unity-button:focus, .horror-theme .unity-toggle:focus,
.horror-theme .unity-slider:focus, .horror-theme .unity-text-field:focus,
.horror-theme .tile:focus, .horror-theme .sheet:focus, .horror-theme .field-guide__entry:focus {
    border-width: 2px;
    border-color: var(--c-accent-hot);
}

/* Reserve the focus frame so keyboard/pad focus never moves control contents. */
.horror-theme .unity-toggle, .horror-theme .unity-slider, .horror-theme .unity-text-field {
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}
.horror-theme .unity-toggle:focus, .horror-theme .unity-slider:focus, .horror-theme .unity-text-field:focus {
    border-color: var(--c-accent-hot);
}

.horror-theme .field > .unity-text-field__input,
.horror-theme .field > .unity-base-text-field__input {
    background-color: rgb(12, 11, 10);
    color: var(--c-text);
    border-width: 1px;
    border-color: var(--c-line);
    border-bottom-width: 2px;
    border-bottom-color: var(--c-accent);
    border-radius: 0;
    padding: 8px;
}
.horror-theme .setting { border-bottom-color: var(--c-line); }
.horror-theme .setting__value { color: var(--c-accent-hot); }
.horror-theme .unity-base-slider__tracker { background-color: var(--c-panel-3); }
.horror-theme .unity-base-slider__dragger {
    background-color: var(--c-text);
    border-radius: 0;
    border-width: 1px;
    border-color: var(--c-accent);
}
.horror-theme .unity-scroller__low-button, .horror-theme .unity-scroller__high-button {
    background-color: var(--c-panel-2);
    -unity-background-image-tint-color: var(--c-dim);
}
.horror-theme .unity-toggle__checkmark {
    background-color: var(--c-ink);
    border-width: 1px;
    border-color: var(--c-accent);
    border-radius: 0;
}
.horror-theme .unity-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: var(--c-accent);
    -unity-background-image-tint-color: var(--c-text);
}
.horror-theme .tab { background-color: var(--c-panel-2); color: var(--c-dim); border-radius: 0; }
.horror-theme .tab:hover, .horror-theme .tab:focus { color: var(--c-text); border-color: var(--c-accent); }

/* Physical kit: punched key tags, scratched meters, warning stripes and stamped paper. */
.horror-theme .keycap {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf");
    font-size: 15px;
    color: var(--c-text);
    background-color: rgba(24, 22, 18, 0.96);
    border-width: 1px;
    border-color: rgba(205, 190, 160, 0.55);
    border-bottom-width: 2px;
    border-bottom-color: var(--c-accent);
    border-radius: 0;
    min-width: 27px;
    min-height: 26px;
    padding: 2px 7px;
}
.horror-theme .keycap--mouse { -unity-background-image-tint-color: var(--c-text); padding: 0; }
.horror-theme .bar { border-width: 1px; border-color: var(--c-line); border-radius: 0; background-color: rgba(6, 6, 5, 0.7); }
.horror-theme .bar__fill { background-color: var(--c-accent-hot); border-radius: 0; }
.horror-theme .bar__fill--good, .horror-theme .segment__fill--good { background-color: var(--c-good); }
.horror-theme .bar__fill--bad, .horror-theme .segment__fill--bad { background-color: var(--c-bad); }
.horror-theme .tag { background-color: rgba(20, 18, 15, 0.85); border-width: 1px; border-color: var(--c-line); color: var(--c-text); border-radius: 0; font-size: 15px; }
.horror-theme .tag--dim { color: var(--c-dim); }
.horror-theme .tag--warn { color: var(--c-bad); border-color: var(--c-bad); }
.horror-theme .stamp { color: var(--c-bad); border-color: var(--c-bad); -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); border-radius: 0; }
.horror-theme .stamp--good { color: var(--c-good); border-color: var(--c-good); }
.horror-theme .hazard { background-color: var(--c-accent); opacity: 0.62; }
.horror-theme .tile { background-color: var(--c-panel-2); border-radius: 0; border-color: var(--c-line); }
.horror-theme .tile:hover { border-color: var(--c-accent-hot); }

/* Recovered loot: a tagged object and its appraisal, with damage called out in words by the existing tag. */
.horror-theme .loot-tag {
    background-color: rgba(16, 14, 11, 0.9);
    background-image: url("../HorrorGrime.png");
    border-width: 1px;
    border-color: var(--c-line);
    border-left-width: 3px;
    border-left-color: var(--c-money);
    border-bottom-width: 1px;
    border-radius: 0;
    padding: 8px 12px;
    max-width: 360px;
    min-width: 0;
}
.horror-theme .loot-tag__value { color: var(--c-money); font-size: 28px; -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf"); }
.horror-theme .loot-tag__name { color: var(--c-text); font-size: 17px; -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); letter-spacing: 1px; }
.horror-theme .loot-tag--t2, .horror-theme .loot-tag--t3 { border-left-color: var(--c-accent-hot); border-bottom-color: var(--c-accent); }
.horror-theme .loot-tag--t2 .loot-tag__value, .horror-theme .loot-tag--t3 .loot-tag__value { color: var(--c-accent-hot); }
.horror-theme .loot-tag--broken { border-left-color: var(--c-bad); }
.horror-theme .loot-tag--broken .loot-tag__value { color: var(--c-bad); }
.horror-theme .loot-tag--scan { padding: 3px 8px; }
.horror-theme .loot-tag--held { top: 65%; max-width: none; translate: 0 0; }
.horror-theme .loot-tag__name { max-width: 100%; white-space: normal; -unity-text-align: middle-center; }
.horror-theme .loot-tag__meta { flex-wrap: wrap; justify-content: center; max-width: 100%; }
.horror-theme .scan-ring { border-color: rgba(205, 184, 145, 0.48); border-width: 1px; }
.horror-theme .scan-ready { left: auto; right: 30px; bottom: 28px; translate: 0 0; }
.horror-theme .scan-ready__text { font-size: 15px; letter-spacing: 1px; color: var(--c-dim); }
.horror-theme .hud-float, .horror-theme .threat-mark { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); }

/* Quiet torn notices; only real danger uses the red paint. */
.horror-theme .toast-stack { top: 280px; right: 28px; width: 330px; max-width: 28%; }
.horror-theme .toast {
    background-color: rgba(20, 18, 15, 0.96);
    background-image: url("../HorrorGrime.png");
    border-width: 1px;
    border-color: var(--c-line);
    border-left-width: 2px;
    border-left-color: var(--c-accent);
    border-radius: 0;
    padding: 12px;
}
.horror-theme .toast--good { border-left-color: var(--c-good); }
.horror-theme .toast--warn { border-left-color: var(--c-bad); }
.horror-theme .toast__title { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); color: var(--c-text); font-size: 18px; }
.horror-theme .toast__body { color: var(--c-dim); font-size: 15px; }
.horror-theme .toast__text { flex-grow: 1; min-width: 0; }
.horror-theme .toast__title { white-space: normal; }
.horror-theme .toast__icon { width: 32px; height: 32px; min-width: 32px; min-height: 32px; margin-right: 10px; }
.horror-theme .hud-floor { bottom: 24%; border-color: var(--c-bad); color: var(--c-text); background-color: rgba(50, 19, 14, 0.92); border-radius: 0; font-size: 20px; -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); }
.horror-theme .horror-danger { top: 118px; left: 50%; right: auto; translate: -50% 0; width: 200px; background-color: rgba(14, 13, 11, 0.7); border-top-width: 1px; border-top-color: var(--c-line); padding: 8px 12px; }
.horror-theme .horror-danger__label { color: var(--c-dim); font-size: 15px; letter-spacing: 1px; }
.horror-theme .horror-danger__mark { flex-grow: 1; flex-basis: 0; min-width: 0; height: 4px; margin-right: 3px; background-color: var(--c-panel-3); }
.horror-theme .horror-danger__mark--last { margin-right: 0; }
.horror-theme .horror-danger__mark--on { background-color: var(--c-accent-hot); }
.horror-theme .horror-danger--final .horror-danger__label { color: var(--c-bad); }
.horror-theme .horror-danger--final .horror-danger__mark--on { background-color: var(--c-bad); }
.horror-theme .horror-danger__progress { background-color: var(--c-ink); }
.horror-theme .horror-radio { background-color: rgba(18, 16, 13, 0.96); border-width: 1px; border-color: var(--c-line); border-left-width: 2px; border-left-color: var(--c-accent); }
.horror-theme .horror-radio__caption { font-size: 15px; color: var(--c-accent-hot); letter-spacing: 2px; }
.horror-theme .horror-radio__line { color: var(--c-text); font-size: 17px; }
.horror-theme .horror-radio--urgent { border-left-color: var(--c-bad); background-color: rgba(43, 20, 15, 0.96); }
.horror-theme .horror-radio--urgent .horror-radio__caption { color: var(--c-bad); }
.horror-theme .subtitles { left: 31%; right: 31%; bottom: 28px; }
.horror-theme .subtitle-line { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); background-color: rgba(13, 12, 10, 0.9); color: var(--c-text); border-left-width: 1px; border-left-color: var(--c-line); padding: 5px 10px; font-size: 18px; }
.horror-theme .subtitles--small .subtitle-line { font-size: 15px; }
.horror-theme .subtitles--large .subtitle-line { font-size: 26px; }
.horror-theme .speaker-mark { background-color: rgba(16, 14, 11, 0.92); border-radius: 0; border-width: 1px; border-color: var(--c-good); border-left-width: 3px; }
.horror-theme .speaker-mark__name { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); color: var(--c-text); font-size: 16px; }
.horror-theme .speaker-mark--radio { border-color: var(--c-accent-hot); }
.horror-theme .ping-mark__diamond { width: 11px; height: 11px; border-width: 1px; border-color: var(--c-ink); }
.horror-theme .ping-mark__text { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); background-color: rgba(16, 14, 11, 0.92); border-bottom-width: 1px; border-bottom-color: var(--c-line); font-size: 16px; letter-spacing: 0; }
.horror-theme .hud-charge { height: 5px; border-width: 1px; border-color: var(--c-line); }
.horror-theme.menu-narrow .subtitles { left: 28%; right: 41%; }

/* Death and evacuation share the logo's distressed sign language. */
.horror-theme .death-card { background-color: rgba(16, 8, 7, 0.82); background-image: url("../HorrorGrime.png"); }
.horror-theme .death-card__title { font-size: 116px; letter-spacing: 12px; color: var(--c-bad); text-shadow: 0 4px 0 rgba(0, 0, 0, 0.8); }
.horror-theme .death-card__cause { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 27px; color: var(--c-text); border-width: 1px; border-color: var(--c-line); border-left-width: 3px; border-left-color: var(--c-bad); padding: 12px 22px; }
.horror-theme .death-card__note { font-size: 17px; color: var(--c-dim); }
.horror-theme .death-card__title, .horror-theme .death-card__cause, .horror-theme .death-card__note {
    max-width: 86%;
    white-space: normal;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.horror-theme.menu-compact .death-card__title { font-size: 84px; letter-spacing: 7px; }
.horror-theme.menu-narrow .death-card__title { font-size: 62px; letter-spacing: 4px; }
.horror-theme.menu-short .death-card__cause { font-size: 22px; padding: 8px 14px; }
.horror-theme .ghost-bar, .horror-theme .hud-ghost { background-color: rgba(14, 13, 11, 0.88); color: var(--c-text); border-bottom-color: var(--c-line); }
.horror-theme .ghost-bar .hud-prompt__text { color: var(--c-dim); }
.horror-theme .ghost-bar { left: 8%; right: 8%; flex-wrap: wrap; }
.horror-theme .ghost-bar .hud-prompt { flex-wrap: wrap; justify-content: center; }
.horror-theme .ghost-bar .hud-prompt__part { max-width: 100%; min-width: 0; }
.horror-theme .ghost-bar .hud-prompt__text { white-space: normal; min-width: 0; flex-shrink: 1; }
.horror-theme .hud-blackout__text { max-width: 86%; white-space: normal; -unity-text-align: middle-center; letter-spacing: 1px; }
.horror-theme .monitor { padding: 28px; }
.horror-theme .monitor__caption { font-size: 26px; max-width: 100%; white-space: normal; }
.horror-theme .monitor__help { max-width: 100%; min-width: 0; white-space: normal; -unity-text-align: middle-center; letter-spacing: 0; -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); font-size: 16px; }
.horror-theme .truck-banner { left: 24%; right: 24%; top: 17%; background-color: rgba(25, 14, 10, 0.96); border-width: 1px; border-color: var(--c-bad); padding-bottom: 12px; }
.horror-theme .truck-banner__title { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 25px; color: var(--c-text); letter-spacing: 3px; }
.horror-theme .truck-banner__count { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf"); font-size: 78px; color: var(--c-accent-hot); }
.horror-theme .truck-banner__status { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 22px; color: var(--c-bad); }
.horror-theme .truck-banner__status--good { color: var(--c-good); }

/* The cargo-bay display uses the exact same assets as the player's document. */
.horror-theme.truck-display { background-color: rgb(11, 12, 10); padding: 16px 24px; color: var(--c-text); }
.horror-theme.truck-display .truck-display__label { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 23px; letter-spacing: 3px; color: var(--c-accent); margin-top: 10px; }
.horror-theme.truck-display .truck-display__amount { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf"); font-size: 78px; color: var(--c-text); margin: 0; }
.horror-theme.truck-display .truck-display__quota { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); font-size: 20px; color: var(--c-dim); }
.horror-theme.truck-display .truck-display__quota--met { color: var(--c-good); }
.horror-theme.truck-display .truck-display__cargo { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); font-size: 18px; color: var(--c-dim); }
.horror-theme.truck-display .truck-display__cargo--bad { color: var(--c-bad); }
.horror-theme.truck-display .truck-display__bar { width: auto; height: 8px; }

/* Preserve semantic colourblind settings above the horror palette. Shapes/text still carry meaning. */
.horror-theme.colorblind { --c-good: rgb(122, 181, 231); --c-money: rgb(162, 198, 223); --c-bad: rgb(239, 159, 83); }
.horror-theme .fps-counter { color: var(--c-dim); border-left-width: 1px; border-left-color: var(--c-line); }
