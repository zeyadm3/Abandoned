/* The game's one stylesheet (2026-10-28 UI redo). It replaces the eleven layers five redesigns had stacked on one
   another (Menu.uss, Revamp, AbandonedTheme, AbandonedMenus, HorrorHud, AbandonedPanels, FieldHud, TrainingHud,
   ModernMenus, Remake2026, Remake2026Layouts, HqStations), whose rules fought over the same elements. Applied once to
   the menu document's root (UiThemeAssets.Apply) and to the truck display's panel. Palette from the 2026 remake;
   type is Saira Stencil One for big headings, Barlow for everything else. No texture overlays. */

.horror-theme { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-text); --c-ink: rgb(6, 7, 8); --c-panel: rgba(10, 11, 12, 0.94); --c-panel-2: rgb(17, 18, 20); --c-panel-3: rgb(27, 28, 31); --c-line: rgba(220, 224, 228, 0.12); --c-accent: rgb(214, 158, 72); --c-accent-hot: rgb(242, 196, 112); --c-accent-ink: rgb(12, 10, 6); --c-text: rgb(226, 228, 230); --c-dim: rgb(160, 164, 170); --c-faint: rgb(108, 112, 118); --c-good: rgb(140, 182, 150); --c-bad: rgb(196, 62, 52); --c-money: rgb(205, 196, 160); }

/* ---- from Menu.uss ---- */
.grow { flex-grow: 1; }
.wrap { flex-direction: row; flex-wrap: wrap; }
.setting__control.unity-base-slider--horizontal .unity-base-slider__dragger-border { display: none; }
.unity-scroller--vertical { width: 8px; margin-left: 8px; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-scroller--vertical > .unity-scroller__low-button { display: none; }
.unity-scroller--vertical > .unity-scroller__high-button { display: none; }
.unity-scroller--vertical > .unity-scroller__slider { margin: 0; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: var(--c-panel-3); border-width: 0; width: 8px; left: 0; }
.icon--small { width: 22px; height: 22px; }
.icon--large { width: 56px; height: 56px; }
.stamp--hidden { scale: 2.2 2.2; opacity: 0; }
.hud-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-scanner { left: 52%; top: 45%; width: 300px; }
.hud-motion { right: 16px; top: 34%; width: 280px; }
.hud-nightvision { right: 16px; top: 26%; width: 280px; }
.hud-marker { position: absolute; font-size: 19px; translate: -50% -50%; -unity-text-align: middle-center; }
.hud-row { flex-direction: row; align-items: center; min-height: 32px; border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.hud-cell--name { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; white-space: normal; -unity-text-align: middle-left; }
.hud-prompt-row { position: absolute; left: 0; right: 0; top: 54%; flex-direction: row; justify-content: center; align-items: center; }
.hud-prompt__part { flex-direction: row; align-items: center; margin: 0 4px 0 4px; padding: 4px 10px 4px 6px; background-color: rgba(10, 11, 12, 0.6); border-radius: 3px; }
.hud-prompt__text { font-size: 21px; color: var(--c-text); }
.loot-tag--hidden { scale: 0.5 0.5; opacity: 0; }
.loot-tag--scan .loot-tag__value { font-size: 22px; }
.loot-tag__meta .tag { margin: 0 2px 0 2px; font-size: 14px; }
.loot-tag--t1 { border-bottom-color: var(--c-money); }
.loot-tag--t1 .loot-tag__value { color: var(--c-money); }
.scan-ring--out { scale: 10 10; opacity: 0; }
.toast--in { translate: 420px 0; opacity: 0; }
.toast--out { translate: 420px 0; opacity: 0; }
.speaker-mark .icon { -unity-background-image-tint-color: var(--c-good); margin-right: 5px; }
.truck-display { flex-grow: 1; align-items: center; background-color: rgb(10, 11, 12); color: var(--c-text); }
.truck-display .hazard { align-self: stretch; height: 16px; }
.truck-display__label { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf"); font-size: 34px; letter-spacing: 6px; color: var(--c-accent); margin-top: 10px; }
.truck-display__amount { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 104px; color: var(--c-money); margin-top: -16px; margin-bottom: -10px; }
.truck-display__quota { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); font-size: 30px; color: var(--c-text); }
.truck-display__quota--met { color: var(--c-good); }
.truck-display__bar { width: 520px; height: 16px; margin-top: 8px; }
.truck-display__cargo { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); font-size: 24px; color: var(--c-dim); margin-top: 8px; }
.truck-display__cargo--bad { color: var(--c-bad); }
.crew-row__volume.unity-base-slider--horizontal .unity-base-slider__tracker { background-color: var(--c-panel-3); border-width: 0; height: 6px; margin-top: -3px; }
.crew-row__volume.unity-base-slider--horizontal .unity-base-slider__dragger-border { display: none; }
.main { flex-grow: 1; justify-content: center; }
.main__notice { flex-direction: row; align-items: center; margin-bottom: 12px; }
.award__text { margin-bottom: 0; color: var(--c-text); }
.tally--total .tally__label { color: var(--c-text); }
.crt__button:hover { color: var(--c-panel-2); background-color: var(--c-accent); }
.crt__button--on { color: var(--c-panel-2); background-color: var(--c-accent); }
.crt__row:hover { background-color: var(--c-accent); }
.crt__row:hover .crt__name { color: var(--c-panel-2); }
.crt__row:hover .crt__note { color: var(--c-panel-2); }
.crt__row:hover .crt__price { color: var(--c-panel-2); }
.rack__item { flex-direction: row; align-items: center; padding-left: 8px; }
.rack__icon { margin-right: 6px; }
.sheet__take { margin: 12px 0 0 0; align-self: stretch; }
.chat--open .chat__log { background-color: rgba(10, 11, 12, 0.6); padding: 6px 10px 6px 10px; }
.chat__field { margin-top: 6px; }
.sheet__place { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); font-size: 16px; letter-spacing: 2px; color: rgb(76, 82, 65); }
.sheet__pin { position: absolute; top: 6px; left: 50%; width: 16px; height: 16px; margin-left: -8px; border-radius: 8px; border-bottom-width: 3px; background-color: rgb(121, 78, 56); border-bottom-color: rgb(65, 49, 36); }
.crt__scanlines { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; background-repeat: repeat repeat; background-size: 4px 8px; }
.crt__title { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-accent); font-size: 34px; }
.crt__line { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-accent); font-size: 24px; }
.crt__cursor { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-accent); font-size: 26px; }
.crt__button { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-accent); font-size: 26px; background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0 10px 0 0; margin: 0 12px 0 0; }
.crt__rule { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 22px; overflow: hidden; white-space: nowrap; color: rgba(188, 171, 118, 0.65); }
.crt__row--locked .crt__name { color: rgb(112, 116, 91); }
.crt__row--locked .crt__price { color: rgb(112, 116, 91); }
.crt__row--cant .crt__price { color: rgb(145, 147, 108); }
Label { min-width: 0; flex-shrink: 0; }
.scroll .unity-scroll-view__content-viewport { min-width: 0; min-height: 0; }
.scroll .unity-scroll-view__content-container { min-width: 0; flex-shrink: 0; }
.scroll .unity-scroller--horizontal { display: none; }
.row { flex-direction: row; align-items: center; min-width: 0; flex-shrink: 0; }
.pause__scroll { width: 100%; height: 100%; }
.pause__crew-list { min-width: 0; min-height: 0; }
.field .unity-text-input { min-width: 0; }
.hud-cards { flex-direction: row; flex-wrap: wrap; min-width: 0; flex-shrink: 0; }
.play__body { min-height: 0; }
.play__card .menu-button { font-size: 26px; }
.appraisal { width: 1240px; max-width: 96%; min-width: 0; min-height: 0; }
.receipt__items { min-height: 140px; max-height: 360px; }
.crt__screen { background-color: var(--c-panel-2); padding: 22px 28px 18px 28px; border-width: 3px; overflow: hidden; border-color: rgb(66, 76, 57); border-radius: 3px; min-width: 0; }
.crt__list { min-height: 160px; max-height: 440px; }
.crt__row { flex-direction: row; align-items: center; background-color: rgba(0, 0, 0, 0); border-width: 0; margin: 0; padding: 2px 6px 2px 6px; min-height: 46px; height: auto; flex-shrink: 0; min-width: 0; }
.crt__name { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-accent); font-size: 22px; min-width: 0; flex-basis: 0; flex-grow: 1; flex-shrink: 1; white-space: normal; }
.crt__note { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-text-align: middle-right; color: rgb(145, 147, 108); width: 120px; min-width: 100px; font-size: 18px; flex-shrink: 0; white-space: normal; }
.crt__price { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-accent); -unity-text-align: middle-right; width: 106px; min-width: 90px; font-size: 22px; flex-shrink: 0; }
.crt__about { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-accent); margin-top: 8px; height: auto; min-height: 72px; font-size: 20px; white-space: normal; }
.sheet__fact { border-bottom-width: 1px; border-bottom-color: rgba(42, 38, 32, 0.15); height: auto; min-height: 32px; flex-shrink: 0; }
.icon { width: 32px; height: 32px; background-size: contain; flex-shrink: 0; }
.rack__name { min-width: 0; flex-grow: 1; flex-shrink: 1; font-size: 18px; white-space: normal; }
.hud-voice { position: absolute; left: 28px; font-size: 15px; color: var(--c-dim); bottom: 178px; }
.chat { position: absolute; left: 28px; bottom: 214px; width: 440px; max-width: 30%; }
.chat__line { font-size: 18px; color: var(--c-text); margin-top: 2px; min-width: 0; white-space: normal; }
.hint { top: 124px; width: 340px; }
.menu-compact .wardrobe__preview { width: 240px; height: 320px; margin-right: 16px; }
.menu-compact .receipt { width: 100%; flex-basis: 100%; max-width: 100%; margin-right: 0; margin-bottom: 20px; }
.menu-compact .appraisal__side { flex-basis: 100%; }
.menu-short .wardrobe__preview { width: 220px; height: 280px; }
.pause.backdrop--dim { background-color: rgba(4, 6, 6, 0.42); }
.board__cork { border-width: 6px; -unity-background-scale-mode: stretch-to-fill; border-left-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-color: var(--c-line); border-right-color: var(--c-line); border-bottom-color: var(--c-line); background-color: rgb(59, 63, 47); border-color: rgb(35, 42, 34); border-radius: 0; flex-wrap: nowrap; padding: 22px 12px; }
.board__cork .sheet { min-width: 0; flex-basis: 0; flex-grow: 1; flex-shrink: 1; margin: 0 9px; padding: 24px 22px 16px 22px; }
.sheet .sheet__fact { flex-direction: row; align-items: center; min-height: 34px; height: auto; padding: 3px 0; flex-wrap: nowrap; }
.sheet .sheet__fact-label { width: 104px; min-width: 104px; flex-grow: 0; flex-shrink: 0; white-space: nowrap; font-size: 13px; letter-spacing: 1px; -unity-text-align: middle-left; }
.sheet__fact-cell { flex-grow: 1; flex-shrink: 1; min-width: 0; flex-direction: column; align-items: flex-start; justify-content: center; }
.sheet .sheet__fact-value { width: auto; min-width: 0; flex-shrink: 1; white-space: normal; -unity-text-align: middle-left; font-size: 17px; }
.sheet .sheet__fact-value--warn { color: rgb(150, 38, 26); }
.sheet__fact-note { font-size: 12px; color: rgb(98, 92, 76); white-space: normal; margin-top: -2px; }
.sheet .sheet__take { margin-top: 14px; }
.hud-crosshair--hidden { opacity: 0; }
.settings__body .section { margin-top: 14px; }
.settings__body .setting { min-height: 44px; }
.wardrobe { height: 88%; }
.wardrobe__header { justify-content: space-between; align-items: flex-start; flex-shrink: 0; }
.wardrobe__money { align-items: flex-end; flex-shrink: 1; min-width: 0; }
.wardrobe__body { flex-grow: 1; flex-shrink: 1; min-height: 0; align-items: stretch; margin-top: 8px; }
.wardrobe__shelf { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; }
.wardrobe__tabs { flex-shrink: 0; margin-bottom: 10px; }
.wardrobe__scroll { flex-grow: 1; }
.wardrobe__grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.wardrobe__card-tag--reward { color: rgb(205, 145, 116); }
.wardrobe__detail-swatch { height: 10px; margin-bottom: 10px; }
.wardrobe__detail-unlock { font-size: 16px; color: var(--c-accent); white-space: normal; margin-bottom: 16px; }
.wardrobe__action { font-size: 30px; }
.wardrobe__done { flex-shrink: 0; margin-top: 8px; align-self: flex-start; }
.menu-compact .wardrobe__card { width: 148px; }
.segments { flex-direction: row; height: 9px; }
.segment__fill { height: 100%; width: 0; background-color: var(--c-text); transition-property: width, background-color; transition-duration: 0.15s; }
.first-day .segments { height: 4px; margin-top: 8px; }

/* ---- from Resources/Revamp.uss ---- */
:root { --c-ink: rgb(10, 11, 12); --c-panel: rgba(18, 21, 24, 0.97); --c-panel-2: rgb(27, 31, 35); --c-panel-3: rgb(40, 45, 50); --c-line: rgba(242, 190, 40, 0.18); --c-accent: rgb(242, 190, 40); --c-accent-hot: rgb(255, 214, 92); --c-accent-ink: rgb(18, 16, 8); --c-text: rgb(232, 232, 226); --c-dim: rgb(150, 156, 160); --c-faint: rgba(214, 218, 220, 0.6); --c-good: rgb(110, 200, 120); --c-bad: rgb(232, 84, 60); --c-money: rgb(150, 220, 140); }
.menu-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: var(--c-text); --c-ink: rgb(10, 11, 12); --c-panel: rgba(18, 21, 24, 0.97); --c-panel-2: rgb(27, 31, 35); --c-panel-3: rgb(40, 45, 50); --c-line: rgba(242, 190, 40, 0.18); --c-accent: rgb(242, 190, 40); --c-accent-hot: rgb(255, 214, 92); --c-accent-ink: rgb(18, 16, 8); --c-text: rgb(232, 232, 226); --c-dim: rgb(150, 156, 160); --c-faint: rgba(214, 218, 220, 0.6); --c-good: rgb(110, 200, 120); --c-bad: rgb(232, 84, 60); --c-money: rgb(150, 220, 140); }
.setting__control.unity-base-slider--horizontal .unity-base-slider__tracker { border-width: 0; background-color: var(--c-panel-3); height: 4px; margin-top: -2px; }
.setting__control.unity-base-slider--horizontal .unity-base-slider__dragger { background-color: var(--c-accent); width: 10px; height: 22px; margin-top: -11px; border-radius: 0; border-width: 2px; border-color: var(--c-ink); }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: var(--c-accent); border-width: 0; width: 8px; left: 0; border-radius: 0; }
.slot { width: 54px; height: 54px; margin-left: 6px; align-items: center; justify-content: center; transition-property: translate, border-color; transition-duration: 0.1s; border-radius: 0; border-width: 1px; border-color: rgba(242, 190, 40, 0.18); background-color: rgba(10, 11, 12, 0.75); }
.segment { flex-grow: 1; flex-basis: 0; overflow: hidden; border-radius: 0; margin-right: 2px; background-color: rgba(10, 11, 12, 0.8); }
.compass { position: absolute; top: 10px; left: 50%; translate: -50% 0; height: 26px; overflow: hidden; border-bottom-width: 1px; background-color: rgba(10, 11, 12, 0.6); border-bottom-color: var(--c-accent); }
.hud-crosshair { position: absolute; left: 50%; top: 50%; background-color: rgba(242, 190, 40, 0.9); border-radius: 0; width: 4px; height: 4px; margin-left: -2px; margin-top: -2px; }
.hud-crosshair--target { border-width: 2px; border-color: rgba(255, 255, 255, 0.9); border-radius: 8px; background-color: var(--c-accent-hot); width: 8px; height: 8px; margin-left: -4px; margin-top: -4px; }
.first-day { top: 300px; width: 340px; background-color: rgba(10, 11, 12, 0.82); border-left-width: 4px; border-left-color: var(--c-accent); border-radius: 0; }
.hud-blackout { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(0, 0, 0); align-items: center; justify-content: center; }
.ping-mark { position: absolute; translate: -50% -100%; align-items: center; }
.chat__log { max-height: 260px; border-left-width: 3px; border-left-color: var(--c-line); }
.chat__field > .unity-text-field__input { background-color: var(--c-panel-2); border-width: 0; border-bottom-width: 2px; border-bottom-color: var(--c-accent); border-radius: 0; }
.play__card { padding: 18px 18px 18px 18px; justify-content: flex-start; flex-basis: 260px; min-width: 0; flex-shrink: 0; background-color: var(--c-panel-2); border-top-width: 4px; border-top-color: var(--c-accent); border-radius: 0; }
.play__title { margin: 0; padding: 0; border-bottom-width: 0; font-size: 26px; min-width: 0; flex-shrink: 1; white-space: normal; color: var(--c-accent); letter-spacing: 2px; }
.mic-meter { flex-grow: 1; height: 12px; margin-right: 80px; border-radius: 0; }
.sheet { flex-grow: 1; margin: 0 10px 0 10px; padding: 22px 18px 16px 18px; background-color: var(--c-panel-2); border-bottom-width: 4px; -unity-background-scale-mode: stretch-to-fill; border-bottom-color: rgb(112, 112, 94); min-width: 240px; flex-basis: 260px; flex-shrink: 0; border-top-width: 10px; border-top-color: var(--c-accent); border-radius: 0; }
.sheet__fact-value--warn { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 16px; color: rgb(170, 40, 24); }
.crt { width: 1080px; max-width: 94%; border-top-width: 0; padding: 26px 26px 26px 26px; -unity-background-scale-mode: stretch-to-fill; border-left-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-color: var(--c-line); border-right-color: var(--c-line); border-bottom-color: var(--c-line); background-color: rgb(30, 35, 30); min-width: 0; min-height: 0; border-radius: 2px; }
.sheet__stamp { position: relative; top: auto; right: auto; bottom: auto; left: auto; align-self: flex-start; margin-top: 12px; font-size: 26px; scale: 1 1; white-space: normal; border-radius: 0; }
.award__icon { margin-right: 10px; -unity-background-image-tint-color: var(--c-accent); }
.unity-toggle:focus > .unity-toggle__input > .unity-toggle__checkmark { border-color: var(--c-accent-hot); }
.panel .text { white-space: normal; }
.hud-hint { left: 24px; top: 84px; width: 440px; background-color: rgba(10, 11, 12, 0.82); border-left-width: 4px; border-left-color: var(--c-accent); border-radius: 0; white-space: normal; }
.play__blurb { margin-top: 8px; margin-bottom: 10px; min-height: 0; height: auto; color: var(--c-dim); white-space: normal; }
.colorblind { --c-good: rgb(86, 160, 255); --c-money: rgb(120, 180, 255); --c-bad: rgb(255, 140, 30); }

/* ---- from Resources/AbandonedTheme.uss ---- */
.font-display-semi { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); -unity-font-style: normal; letter-spacing: 1px; }
.sheet__job { color: var(--c-text); white-space: normal; font-size: 32px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); -unity-font-style: normal; letter-spacing: 1px; }
.field { margin: 4px 0 4px 0; min-height: 42px; height: auto; min-width: 0; flex-shrink: 0; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-font-style: normal; font-size: 16px; letter-spacing: 0; }
.sheet__text { color: var(--c-text); white-space: normal; margin-bottom: 8px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-font-style: normal; font-size: 16px; letter-spacing: 0; }
.sheet__quip { white-space: normal; margin-bottom: 6px; color: rgb(76, 82, 65); -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-font-style: normal; font-size: 16px; letter-spacing: 0; }
.sheet__fact-label { flex-grow: 1; color: rgb(76, 82, 65); width: 35%; min-width: 0; flex-shrink: 1; white-space: normal; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-font-style: normal; font-size: 16px; letter-spacing: 0; }
.sheet__fact-value { color: var(--c-text); width: 65%; min-width: 0; flex-shrink: 1; white-space: normal; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-font-style: normal; font-size: 16px; letter-spacing: 0; }
.hud-cell { width: 150px; color: var(--c-text); -unity-text-align: middle-right; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-font-style: normal; font-size: 16px; letter-spacing: 0; }
.hud-panel { position: absolute; padding: 10px 14px 10px 14px; white-space: normal; background-color: rgba(14, 13, 11, 0.88); border-width: 1px; border-color: var(--c-line); border-left-width: 2px; border-left-color: var(--c-accent); border-radius: 0; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 16px; color: var(--c-text); letter-spacing: 0; }
.hud-callout { position: absolute; left: 50%; translate: -50% 0; padding: 4px 16px 4px 16px; border-bottom-width: 2px; border-bottom-color: var(--c-accent); background-color: rgba(14, 13, 11, 0.88); border-width: 1px; border-color: var(--c-line); border-left-width: 2px; border-left-color: var(--c-accent); border-radius: 0; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 16px; color: var(--c-text); letter-spacing: 0; bottom: 22%; max-width: 64%; white-space: normal; }
.unity-button:focus { border-width: 2px; border-color: var(--c-accent-hot); }
.sheet:focus { border-width: 2px; border-color: var(--c-accent-hot); }
.unity-toggle { border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.unity-slider { border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.unity-text-field { border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.unity-toggle:focus { border-width: 2px; border-color: var(--c-accent-hot); }
.unity-slider:focus { border-width: 2px; border-color: var(--c-accent-hot); }
.unity-text-field:focus { border-width: 2px; border-color: var(--c-accent-hot); }
.field > .unity-text-field__input { padding-left: 10px; background-color: rgb(12, 11, 10); color: var(--c-text); border-width: 1px; border-color: var(--c-line); border-bottom-width: 2px; border-bottom-color: var(--c-accent); border-radius: 0; padding: 8px; }
.field > .unity-base-text-field__input { padding-left: 10px; background-color: rgb(12, 11, 10); color: var(--c-text); border-width: 1px; border-color: var(--c-line); border-bottom-width: 2px; border-bottom-color: var(--c-accent); border-radius: 0; padding: 8px; }
.unity-base-slider__tracker { background-color: var(--c-panel-3); }
.unity-base-slider__dragger { background-color: var(--c-text); border-radius: 0; border-width: 1px; border-color: var(--c-accent); }
.unity-scroller__low-button { background-color: var(--c-panel-2); -unity-background-image-tint-color: var(--c-dim); }
.unity-scroller__high-button { background-color: var(--c-panel-2); -unity-background-image-tint-color: var(--c-dim); }
.unity-toggle__checkmark { width: 22px; height: 22px; background-color: var(--c-ink); border-width: 1px; border-color: var(--c-accent); border-radius: 0; }
.unity-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark { background-color: var(--c-accent); -unity-background-image-tint-color: var(--c-text); }
.keycap { height: 30px; margin: 0 6px 0 0; -unity-text-align: middle-center; white-space: nowrap; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 15px; color: var(--c-text); background-color: rgba(24, 22, 18, 0.96); border-width: 1px; border-color: rgba(205, 190, 160, 0.55); border-bottom-width: 2px; border-bottom-color: var(--c-accent); border-radius: 0; min-width: 27px; min-height: 26px; padding: 2px 7px; }
.keycap--mouse { border-bottom-width: 0; width: 30px; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: var(--c-text); padding: 0; }
.bar { height: 10px; overflow: hidden; border-width: 1px; border-color: var(--c-line); border-radius: 0; background-color: rgba(6, 6, 5, 0.7); }
.bar__fill { height: 100%; width: 0; transition-property: width, background-color; transition-duration: 0.15s; background-color: var(--c-accent-hot); border-radius: 0; }
.bar__fill--good { background-color: var(--c-good); }
.bar__fill--bad { background-color: var(--c-bad); }
.segment__fill--bad { background-color: var(--c-bad); }
.tag { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1px; padding: 1px 8px 1px 8px; background-color: rgba(20, 18, 15, 0.85); border-width: 1px; border-color: var(--c-line); color: var(--c-text); border-radius: 0; font-size: 15px; }
.tag--dim { background-color: var(--c-panel-3); color: var(--c-dim); }
.tag--warn { background-color: var(--c-bad); color: var(--c-bad); border-color: var(--c-bad); }
.stamp { font-size: 46px; padding: 2px 16px 2px 16px; scale: 1 1; opacity: 1; transition-property: scale, opacity; transition-duration: 0.12s; transition-timing-function: ease-out; -unity-text-align: middle-center; border-width: 3px; color: var(--c-bad); border-color: var(--c-bad); -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); border-radius: 0; }
.stamp--good { color: var(--c-good); border-color: var(--c-good); }
.hazard { flex-direction: row; overflow: hidden; height: 8px; background-color: var(--c-accent); opacity: 0.62; }
.loot-tag { position: absolute; translate: -50% -100%; align-items: center; border-bottom-color: var(--c-text); scale: 1 1; opacity: 1; transition-property: scale, opacity; transition-duration: 0.12s; background-color: rgba(16, 14, 11, 0.9); border-width: 1px; border-color: var(--c-line); border-left-width: 3px; border-left-color: var(--c-money); border-bottom-width: 1px; border-radius: 0; padding: 8px 12px; max-width: 360px; min-width: 0; }
.loot-tag__value { color: var(--c-money); font-size: 28px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); }
.loot-tag--t2 { border-left-color: var(--c-accent-hot); border-bottom-color: var(--c-accent); }
.loot-tag--t3 { border-left-color: var(--c-accent-hot); border-bottom-color: var(--c-accent); }
.loot-tag--t2 .loot-tag__value { color: var(--c-accent-hot); }
.loot-tag--t3 .loot-tag__value { color: var(--c-accent-hot); }
.loot-tag--broken { border-left-color: var(--c-bad); }
.loot-tag--broken .loot-tag__value { color: var(--c-bad); }
.loot-tag--scan { background-color: rgba(10, 11, 12, 0.55); padding: 3px 8px; }
.loot-tag--held { left: 50%; top: 65%; max-width: none; translate: 0 0; }
.loot-tag__name { overflow: hidden; text-overflow: ellipsis; -unity-text-overflow-position: end; color: var(--c-text); font-size: 17px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); letter-spacing: 1px; max-width: 100%; white-space: normal; -unity-text-align: middle-center; }
.loot-tag__meta { flex-direction: row; margin-top: 3px; flex-wrap: wrap; justify-content: center; max-width: 100%; }
.scan-ring { position: absolute; left: 50%; top: 50%; width: 200px; height: 200px; margin-left: -100px; margin-top: -100px; border-radius: 100px; scale: 0.1 0.1; opacity: 1; transition-property: scale, opacity; transition-duration: 0.7s, 0.7s; transition-timing-function: ease-out, ease-in; border-color: rgba(205, 184, 145, 0.48); border-width: 1px; }
.scan-ready { position: absolute; flex-direction: row; align-items: center; left: auto; right: 30px; bottom: 28px; translate: 0 0; }
.scan-ready__text { font-size: 15px; letter-spacing: 1px; color: var(--c-dim); }
.hud-float { position: absolute; font-size: 32px; translate: -50% -50%; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); }
.threat-mark { color: var(--c-bad); font-size: 22px; letter-spacing: 1px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); }
.toast-stack { position: absolute; top: 280px; right: 28px; width: 330px; max-width: 28%; }
.toast--good { border-left-color: var(--c-good); }
.toast--warn { border-left-color: var(--c-bad); }
.toast__body { white-space: normal; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-font-style: normal; letter-spacing: 0; color: var(--c-dim); font-size: 15px; }
.toast__text { flex-shrink: 1; flex-grow: 1; min-width: 0; }
.toast__title { letter-spacing: 2px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); color: var(--c-text); font-size: 18px; white-space: normal; }
.toast__icon { -unity-background-image-tint-color: var(--c-text); width: 32px; height: 32px; min-width: 32px; min-height: 32px; margin-right: 10px; }
.hud-floor { position: absolute; left: 50%; translate: -50% 0; padding: 5px 12px; border-left-width: 2px; border-left-color: var(--c-accent); letter-spacing: 1px; -unity-text-align: middle-center; bottom: 24%; border-color: var(--c-bad); color: var(--c-text); background-color: rgba(50, 19, 14, 0.92); border-radius: 0; font-size: 20px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); }
.horror-radio__line { -unity-text-align: middle-center; min-width: 0; white-space: normal; color: var(--c-text); font-size: 17px; }
.horror-radio--urgent { border-left-color: var(--c-bad); background-color: rgba(43, 20, 15, 0.96); }
.horror-radio--urgent .horror-radio__caption { color: var(--c-bad); }
.subtitles--small .subtitle-line { font-size: 15px; }
.subtitles--large .subtitle-line { font-size: 26px; }
.ping-mark__diamond { width: 11px; height: 11px; border-width: 1px; border-color: var(--c-ink); }
.ping-mark__text { margin-top: 6px; padding: 1px 8px 1px 8px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); background-color: rgba(16, 14, 11, 0.92); border-bottom-width: 1px; border-bottom-color: var(--c-line); font-size: 16px; letter-spacing: 0; }
.horror-theme.menu-narrow .subtitles { left: 28%; right: 41%; }
.death-card { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(16, 8, 7, 0.82); }
.death-card__title { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 116px; letter-spacing: 12px; color: var(--c-bad); max-width: 86%; white-space: normal; -unity-text-align: middle-center; flex-shrink: 0; }
.death-card__cause { margin-top: 4px; background-color: rgba(10, 11, 12, 0.85); -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 27px; color: var(--c-text); border-width: 1px; border-color: var(--c-line); border-left-width: 3px; border-left-color: var(--c-bad); padding: 12px 22px; max-width: 86%; white-space: normal; -unity-text-align: middle-center; flex-shrink: 0; }
.death-card__note { margin-top: 14px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-font-style: normal; letter-spacing: 0; font-size: 17px; color: var(--c-dim); max-width: 86%; white-space: normal; -unity-text-align: middle-center; flex-shrink: 0; }
.horror-theme.menu-compact .death-card__title { font-size: 84px; letter-spacing: 7px; }
.horror-theme.menu-narrow .death-card__title { font-size: 62px; letter-spacing: 4px; }
.horror-theme.menu-short .death-card__cause { font-size: 22px; padding: 8px 14px; }
.ghost-bar { position: absolute; bottom: 90px; flex-direction: row; justify-content: center; align-items: center; border-bottom-width: 2px; background-color: rgba(14, 13, 11, 0.88); color: var(--c-text); border-bottom-color: var(--c-line); left: 8%; right: 8%; flex-wrap: wrap; }
.ghost-bar .hud-prompt__part { max-width: 100%; min-width: 0; }
.ghost-bar .hud-prompt__text { color: var(--c-dim); white-space: normal; min-width: 0; flex-shrink: 1; }
.hud-blackout__text { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 26px; color: rgba(214, 218, 220, 0.7); max-width: 86%; white-space: normal; -unity-text-align: middle-center; letter-spacing: 1px; }
.monitor { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(0, 0, 0); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(190, 255, 205); justify-content: space-between; padding: 28px; }
.monitor__caption { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: rgb(200, 255, 205); font-size: 26px; max-width: 100%; white-space: normal; }
.monitor__help { align-self: center; padding: 3px 14px 3px 14px; background-color: rgba(10, 11, 12, 0.75); border-bottom-width: 2px; border-bottom-color: var(--c-accent); max-width: 100%; min-width: 0; white-space: normal; -unity-text-align: middle-center; letter-spacing: 0; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 16px; }
.horror-theme.truck-display { background-color: rgb(11, 12, 10); padding: 16px 24px; color: var(--c-text); }
.horror-theme.truck-display .truck-display__label { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 23px; letter-spacing: 3px; color: var(--c-accent); margin-top: 10px; }
.horror-theme.truck-display .truck-display__amount { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 78px; color: var(--c-text); margin: 0; }
.horror-theme.truck-display .truck-display__quota { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 20px; color: var(--c-dim); }
.horror-theme.truck-display .truck-display__quota--met { color: var(--c-good); }
.horror-theme.truck-display .truck-display__cargo { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 18px; color: var(--c-dim); }
.horror-theme.truck-display .truck-display__cargo--bad { color: var(--c-bad); }
.horror-theme.truck-display .truck-display__bar { width: auto; height: 8px; }
.horror-theme.colorblind { --c-good: rgb(122, 181, 231); --c-money: rgb(162, 198, 223); --c-bad: rgb(239, 159, 83); }
.fps-counter { position: absolute; left: 10px; top: 8px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 15px; background-color: rgba(10, 11, 12, 0.6); padding: 1px 6px 1px 6px; color: var(--c-dim); border-left-width: 1px; border-left-color: var(--c-line); }

/* ---- from Resources/AbandonedMenus.uss ---- */
.menu-screen.backdrop { background-color: rgba(6, 7, 7, 0.8); padding-left: 0; }
.main .main__notice { width: 620px; max-width: 100%; padding: 8px 12px; background-color: rgba(68, 28, 24, 0.82); border-left-width: 2px; border-left-color: var(--c-bad); }
.main .launch-notice { background-color: rgba(5, 6, 6, 0.92); }
.main .launch-notice__panel { padding: 32px 38px; border-top-width: 4px; border-top-color: rgb(126, 57, 43); }
.main .launch-notice__title { font-size: 80px; letter-spacing: 3px; margin-bottom: 6px; }
.launch-notice__warning { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-accent); font-size: 16px; letter-spacing: 2px; margin: 2px 0 22px 0; }
.main .launch-notice .subtitle { font-size: 15px; letter-spacing: 1px; margin: 0 0 20px 0; padding-bottom: 14px; border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.launch-notice__body { max-height: 290px; min-height: 120px; }
.launch-notice__body .text { font-size: 17px; margin-bottom: 16px; }
.launch-notice__email { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 20px; color: var(--c-text); margin-bottom: 12px; }
.launch-notice__actions { margin-top: 18px; padding-top: 12px; border-top-width: 1px; border-top-color: var(--c-line); }
.launch-notice__actions .menu-button--small { margin-left: 0; margin-right: 10px; }
.main .launch-notice__continue { color: var(--c-text); border-color: var(--c-accent); background-color: rgb(65, 39, 29); }
.menu-screen--pause.backdrop--dim { background-color: rgba(5, 6, 6, 0.64); }
.pause__content { align-items: center; justify-content: center; min-height: 100%; padding: 4% 0; }
.pause__columns { flex-direction: row; align-items: flex-start; min-width: 0; flex-shrink: 0; width: 88%; max-width: 1340px; }
.pause__left .title { color: var(--c-accent); font-size: 76px; letter-spacing: 6px; }
.pause__left .pause__warning { font-size: 16px; color: var(--c-dim); margin-bottom: 24px; padding: 10px 0 12px 0; border-bottom-width: 1px; border-bottom-color: rgb(126, 57, 43); }
.pause__left .pause__resume { color: rgb(234, 225, 197); border-left-color: rgb(126, 57, 43); margin-bottom: 12px; }
.crew-row__identity { width: 100%; min-width: 0; }
.crew-row__controls { width: 100%; justify-content: flex-end; margin-top: 10px; }
.crew-row__who { flex-grow: 1; flex-shrink: 1; min-width: 0; flex-basis: 0; }
.crew-row__name { overflow: hidden; text-overflow: ellipsis; -unity-text-overflow-position: end; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 19px; color: var(--c-text); }
.crew-row__tags { letter-spacing: 2px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 15px; color: var(--c-dim); }
.crew-row__ping { width: 70px; -unity-text-align: middle-right; margin-right: 12px; flex-shrink: 0; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 15px; color: var(--c-dim); }
.crew-row__talking { width: 12px; height: 12px; margin: 0 10px 0 10px; flex-shrink: 0; border-radius: 0; background-color: rgb(46, 43, 35); border-width: 1px; border-color: rgba(194, 184, 160, 0.25); }
.crew-row__volume.unity-base-slider--horizontal .unity-base-slider__dragger { border-width: 0; width: 12px; height: 20px; margin-top: -10px; background-color: var(--c-accent); border-radius: 0; }
.crew-row__volume { width: 130px; min-width: 100px; flex-shrink: 0; }
.crew-row .menu-button--small { font-size: 15px; padding: 6px 10px; }
.play__cards { margin-top: 20px; margin-bottom: 22px; }
.menu-screen .play__card { background-color: rgba(29, 27, 22, 0.9); border-top-width: 2px; border-top-color: rgb(126, 57, 43); border-left-width: 1px; border-left-color: var(--c-line); padding: 20px 18px; }
.menu-screen .play__title { font-size: 24px; color: var(--c-text); margin-bottom: 2px; }
.play__icon { margin-right: 10px; -unity-background-image-tint-color: var(--c-accent); width: 25px; height: 25px; }
.play__card .text { font-size: 17px; }
.play__card .play__blurb { color: var(--c-dim); margin-top: 16px; margin-bottom: 20px; }
.menu-screen .play__card .menu-button { font-size: 26px; }
.play__actions { margin-top: auto; min-height: 148px; flex-shrink: 0; }
.settings__nav .unity-scroll-view__content-container { width: 100%; }
.menu-screen--controls .setting .menu-button--small { color: var(--c-text); border-bottom-color: var(--c-accent); }
.achievement-row { align-items: center; padding: 16px 10px; margin-bottom: 8px; background-color: rgba(30, 28, 23, 0.6); border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.achievement-row--earned { border-left-width: 2px; border-left-color: var(--c-accent); }
.achievement-row__details { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 20px; }
.achievement-row__name { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 23px; color: var(--c-text); margin-bottom: 6px; white-space: normal; }
.achievement-row .text { font-size: 16px; }
.achievement-row__status { color: var(--c-dim); font-size: 16px; width: 108px; min-width: 108px; flex-shrink: 0; -unity-text-align: middle-right; }
.achievement-row--earned .achievement-row__status { color: var(--c-accent); }
.wardrobe__detail-name { white-space: normal; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 29px; color: var(--c-text); }
.wardrobe__card > Label { max-width: 100%; min-width: 0; white-space: normal; flex-shrink: 0; }
.wardrobe__detail-body { min-height: 0; min-width: 0; }
.wardrobe__stage { width: 380px; min-width: 300px; flex-shrink: 0; margin-right: 22px; flex-direction: column; min-height: 0; }
.wardrobe__tabs .menu-button--small { margin-left: 0; margin-right: 8px; min-width: 0; }
.wardrobe__card-name { white-space: normal; -unity-text-align: upper-left; margin-top: 8px; margin-bottom: 8px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 17px; color: var(--c-text); }
.wardrobe__chip Label { color: var(--c-accent); -unity-text-align: middle-center; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 22px; }
.wardrobe__card-tag { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); color: var(--c-money); letter-spacing: 1px; font-size: 15px; }
.wardrobe__hint { color: var(--c-faint); margin-top: 6px; font-size: 15px; }
.wardrobe__status { color: var(--c-accent); -unity-text-align: middle-right; min-height: 20px; font-size: 15px; }
.wardrobe__funds { font-size: 20px; -unity-text-align: middle-right; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-accent); }
.wardrobe__detail-about { color: var(--c-dim); white-space: normal; margin: 6px 0 14px 0; font-size: 17px; }
.ea-watermark { position: absolute; right: 10px; bottom: 3px; font-size: 14px; margin: 0; padding: 0; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: rgba(190, 171, 132, 0.4); letter-spacing: 2px; }
.menu-compact .main .main__logo { font-size: 82px; }
.menu-compact .pause__columns { align-items: stretch; width: 92%; flex-direction: row; }
.menu-compact .pause__left { margin-bottom: 24px; width: 325px; margin-right: 28px; }
.menu-compact .pause__left .title { font-size: 60px; }
.menu-compact .wardrobe__stage { width: 26%; min-width: 190px; margin-right: 16px; }
.menu-compact .wardrobe__detail { width: 30%; min-width: 200px; margin-left: 16px; padding: 14px; }
.menu-narrow .wardrobe__stage { min-width: 160px; margin-right: 12px; }
.menu-narrow .wardrobe__detail { min-width: 180px; margin-left: 12px; }
