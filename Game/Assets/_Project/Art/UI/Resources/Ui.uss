/* ---- from Resources/FieldHud.uss ---- */
.field-hud { color: rgb(214, 198, 161); -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); }
.field-hud Label { font-size: 14px; -unity-font-style: normal; margin: 0; padding: 0; }
.field-panel { background-color: rgba(15, 18, 19, 0.88); border-width: 1px; border-color: rgba(159, 136, 100, 0.42); border-radius: 0; padding: 7px 9px; }
.field-hud .field-vitals { position: absolute; left: 28px; bottom: 28px; top: auto; right: auto; width: 220px; min-width: 0; min-height: 0; margin: 0; padding: 7px 9px; border-width: 1px; border-color: rgba(159, 136, 100, 0.42); }
.field-meter-row { flex-direction: row; align-items: center; margin-bottom: 6px; padding-bottom: 6px; border-bottom-width: 1px; border-bottom-color: rgba(159, 136, 100, 0.22); }
.field-meter-row--last { margin-bottom: 0; padding-bottom: 0; border-bottom-width: 0; }
.field-hud .field-meter-caption { width: 64px; flex-shrink: 0; font-size: 11px; }
.field-hud .field-meter { flex-grow: 1; min-width: 12px; height: 7px; margin: 0 8px 0 0; border-width: 0; border-radius: 0; background-color: rgba(150, 135, 100, 0.25); }
.field-meter-number { width: 37px; -unity-text-align: middle-right; }
.field-hud .field-health .bar__fill { background-color: rgb(229, 106, 78); border-radius: 0; }
.field-hud .field-stamina .bar__fill { background-color: rgb(206, 200, 140); border-radius: 0; }
.field-hud .field-load .bar__fill { background-color: rgb(184, 177, 150); border-radius: 0; }
.field-hud .field-power { position: absolute; top: 28px; right: 28px; width: 205px; flex-direction: row; align-items: center; }
.field-power__caption { flex-grow: 1; }
.field-power__number { margin-right: 9px; }
.field-hud .field-battery { width: 54px; height: 12px; flex-shrink: 0; }
.field-battery .segment { background-color: rgba(153, 157, 128, 0.2); margin-right: 2px; border-width: 0; border-radius: 0; }
.field-battery .segment__fill { background-color: rgb(182, 197, 151); border-radius: 0; }
.field-battery .segment__fill--bad { background-color: rgb(229, 106, 78); }
.field-frame { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.field-recording { position: absolute; top: 80px; right: 28px; align-items: flex-end; }
.field-rec { flex-direction: row; align-items: center; align-self: flex-start; padding: 1px 7px; border-width: 1px; border-color: rgba(159, 136, 100, 0.42); background-color: rgba(15, 18, 19, 0.75); }
.field-hud .field-rec__text { font-size: 16px; }
.field-rec__dot { width: 9px; height: 9px; margin-left: 8px; border-radius: 5px; background-color: rgb(222, 62, 48); }
.field-hud .field-recording__line { font-size: 12px; margin-top: 3px; }
.field-hud .hq-brief { width: 620px; max-width: 40%; right: auto; }
.field-hud .field-note { left: 74px; }
.field-mission { position: absolute; top: 28px; left: 50%; translate: -50% 0; width: 380px; align-items: center; }
.field-objective { width: 100%; flex-direction: row; align-items: center; padding: 6px 9px; }
.field-hud .field-objective__caption { font-size: 12px; margin-right: 10px; color: rgb(196, 175, 123); flex-shrink: 0; }
.field-hud .field-objective__text { font-size: 12px; white-space: normal; flex-shrink: 1; min-width: 0; padding-left: 10px; border-left-width: 1px; border-left-color: rgba(159, 136, 100, 0.3); }
.field-extraction { flex-direction: row; align-items: center; margin-top: 5px; padding: 3px 10px; }
.field-hud .field-extraction__caption { font-size: 13px; color: rgb(182, 197, 151); margin-right: 10px; }
.field-hud .field-extraction__time { font-size: 17px; color: rgb(182, 197, 151); padding-left: 10px; border-left-width: 1px; border-left-color: rgba(153, 172, 121, 0.35); }
.field-mission--departing .field-extraction { border-color: rgb(185, 86, 58); }
.field-mission--departing .field-extraction__caption { color: rgb(237, 113, 87); }
.field-mission--departing .field-extraction__time { color: rgb(237, 113, 87); }
.field-hud .field-departure-status { font-size: 12px; margin-top: 5px; }
.field-hud .field-compass { position: absolute; top: 112px; left: 50%; translate: -50% 0; width: 150px; height: 23px; overflow: hidden; }
.field-hud .field-compass__mark { position: absolute; top: 0; font-size: 12px; translate: -50% 0; white-space: nowrap; }
.field-pockets { position: absolute; left: 24px; top: 35%; width: 34px; border-left-width: 1px; border-left-color: rgba(159, 136, 100, 0.42); background-color: rgba(15, 18, 19, 0.35); }
.field-hud .field-pocket { font-size: 13px; height: 42px; -unity-text-align: middle-center; color: rgb(185, 173, 145); border-left-width: 2px; border-left-color: transparent; }
.field-hud .field-pocket--active { color: rgb(255, 180, 156); background-color: rgba(136, 53, 34, 0.4); border-left-color: rgb(237, 113, 87); }
.field-hud .field-inventory { position: absolute; width: 290px; left: 50%; top: 50%; translate: -50% -50%; padding: 12px; }
.field-hud .field-inventory__title { font-size: 13px; margin-bottom: 8px; }
.field-hud .field-inventory__key { font-size: 12px; width: 28px; flex-shrink: 0; color: rgb(185, 173, 145); }
.field-hud .field-inventory__name { font-size: 12px; white-space: normal; min-width: 0; flex-shrink: 1; }
.field-hud .field-inventory__selected { font-size: 12px; margin-top: 5px; white-space: normal; }
.field-hud .field-inventory__stats { font-size: 11px; margin-top: 4px; white-space: normal; color: rgb(185, 173, 145); }
.field-hud .field-inventory__hint { font-size: 11px; margin-top: 4px; white-space: normal; color: rgb(185, 173, 145); }
.field-hud .field-carry { position: absolute; bottom: 31px; left: 31%; right: 31%; -unity-text-align: middle-center; font-size: 13px; white-space: normal; }
.field-hud .field-switch { position: absolute; bottom: 31px; left: 31%; right: 31%; -unity-text-align: middle-center; font-size: 13px; white-space: normal; }
.field-hud .field-cargo { position: absolute; right: 28px; bottom: 28px; width: 220px; }
.field-cargo__row { flex-direction: row; align-items: center; justify-content: space-between; padding-bottom: 5px; margin-bottom: 5px; border-bottom-width: 1px; border-bottom-color: rgba(159, 136, 100, 0.22); }
.field-cargo__row--last { padding-bottom: 0; margin-bottom: 0; border-bottom-width: 0; }
.field-hud .field-cargo__caption { font-size: 12px; }
.field-hud .field-cargo__value { font-size: 16px; color: rgb(207, 171, 105); }
.field-hud .field-cargo__quota { font-size: 13px; color: rgb(170, 158, 132); }
.field-hud .field-cargo__quota--met { color: rgb(150, 190, 120); }
.field-hud .field-cargo__weight { font-size: 12px; margin-right: 9px; flex-shrink: 0; }
.field-hud .field-cargo .field-load { max-width: 95px; margin-right: 0; }
.field-hud .field-prompt { position: absolute; width: 260px; min-width: 0; max-width: 100%; padding: 4px 6px; translate: 8px -50%; background-color: rgba(15, 18, 19, 0.78); }
.field-hud .field-prompt .hud-prompt-row { position: relative; left: auto; right: auto; top: auto; flex-direction: column; align-items: stretch; min-width: 0; }
.field-hud .field-prompt .hud-prompt__part { min-width: 0; flex-shrink: 0; margin: 0; padding: 0; background-color: transparent; align-items: flex-start; }
.field-hud .field-prompt .hud-prompt__text { min-width: 0; flex-grow: 1; flex-shrink: 1; }
.field-hud .field-prompt Label { font-size: 12px; white-space: normal; }
.field-hud .field-prompt .keycap { min-width: 16px; height: auto; min-height: 18px; flex-shrink: 0; white-space: nowrap; margin-right: 6px; padding: 0 3px; font-size: 11px; }
.field-hud .field-reticle { position: absolute; left: 50%; top: 50%; width: 30px; height: 26px; translate: -50% -50%; border-width: 0; background-color: transparent; }
.field-hud .field-reticle .h-reticle__corner { width: 5px; height: 5px; border-color: rgb(214, 198, 161); }
.field-hud .field-throw { position: absolute; left: 50%; bottom: 63px; top: auto; width: 100px; translate: -50% 0; height: 3px; background-color: rgba(214, 198, 161, 0.2); }
.field-hud .field-throw-fill { height: 3px; background-color: rgb(214, 198, 161); }
.field-hud .loot-tag { padding: 5px 7px; max-width: 245px; border-width: 1px; background-color: rgba(15, 18, 19, 0.88); }
.field-hud .loot-tag__value { font-size: 16px; }
.field-hud .loot-tag__name { font-size: 12px; }
.field-hud .loot-tag__meta { margin-top: 3px; }
.field-hud .loot-tag .tag { font-size: 11px; padding: 1px 4px; }
.field-hud--compact .field-vitals { width: 195px; }
.field-hud--compact .hq-brief { max-width: 36%; }
.field-hud--compact .field-cargo { width: 195px; }
.field-hud--compact .field-power { width: 190px; }
.field-hud--compact .field-mission { width: 320px; }
.field-hud--compact .field-carry { bottom: 115px; left: 23%; right: 23%; }
.field-hud--compact .field-switch { bottom: 115px; left: 23%; right: 23%; }
.field-hud--compact .field-throw { bottom: 138px; }
.field-hud--compact .field-meter-caption { width: 57px; }
.field-hud--compact .field-meter-row Label { font-size: 12px; }
.field-hud--compact .field-meter-row .field-meter-caption { font-size: 10px; }
.colorblind .field-hud .field-health .bar__fill { background-color: rgb(240, 158, 70); }
.colorblind .field-hud .segment__fill--bad { background-color: rgb(240, 158, 70); }
.colorblind .field-hud .field-stamina .bar__fill { background-color: rgb(117, 191, 224); }
.colorblind .field-hud .field-pocket--active { border-left-color: rgb(117, 191, 224); color: rgb(160, 213, 237); }

/* ---- from Resources/TrainingHud.uss ---- */
.horror-hud .training-card { position: absolute; top: 96px; left: 30%; width: 580px; padding: 12px 18px 14px 18px; background-color: rgba(13, 15, 14, 0.9); border-top-width: 2px; border-top-color: rgb(186, 154, 98); border-bottom-width: 1px; border-bottom-color: rgba(217, 207, 184, 0.18); transition-property: opacity, translate, border-top-color; transition-duration: 0.25s, 0.25s, 0.2s; }
.horror-hud .training-card--enter { opacity: 0; translate: 0 -10px; }
.horror-hud .training-card--done { border-top-color: rgb(140, 176, 106); }
.horror-hud .training-card__head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 4px; }
.horror-hud .training-card__chapter { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 13px; letter-spacing: 2px; color: rgb(147, 143, 129); margin: 0; padding: 0; }
.horror-hud .training-card__count { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 13px; letter-spacing: 2px; color: rgb(147, 143, 129); margin: 0; padding: 0; }
.horror-hud .training-card__title { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 27px; letter-spacing: 2px; color: rgb(217, 207, 184); margin: 0; padding: 0; white-space: normal; }
.horror-hud .training-card__text { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 17px; color: rgb(214, 206, 186); margin: 6px 0 0 0; padding: 0; white-space: normal; }
.horror-hud .training-card__meter { flex-direction: row; align-items: center; margin-top: 11px; }
.horror-hud .training-card__bar { flex-grow: 1; height: 9px; border-width: 1px; border-color: rgba(217, 207, 184, 0.28); background-color: rgba(217, 207, 184, 0.07); }
.horror-hud .training-card__bar .bar__fill { height: 100%; background-color: rgb(186, 154, 98); transition-property: width; transition-duration: 0.18s; }
.horror-hud .training-card--done .training-card__bar .bar__fill { background-color: rgb(140, 176, 106); }
.horror-hud .training-card__readout { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 14px; color: rgb(217, 207, 184); margin: 0 0 0 12px; padding: 0; min-width: 120px; -unity-text-align: middle-right; white-space: nowrap; }
.horror-hud .training-card__stamp { position: absolute; right: 14px; top: 12px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 22px; letter-spacing: 3px; color: rgb(140, 176, 106); border-width: 2px; border-color: rgb(140, 176, 106); padding: 0 9px 0 9px; opacity: 0; scale: 1.5 1.5; transition-property: opacity, scale; transition-duration: 0.14s, 0.14s; }
.horror-hud .training-card--done .training-card__stamp { opacity: 1; scale: 1 1; }
.horror-hud .training-card__keys { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.horror-hud .training-key { flex-direction: row; align-items: center; margin: 0 10px 4px 0; padding: 3px 9px 3px 4px; border-width: 1px; border-color: rgba(217, 207, 184, 0.2); background-color: rgba(217, 207, 184, 0.03); transition-property: background-color, border-color, scale; transition-duration: 0.08s, 0.08s, 0.08s; }
.horror-hud .training-key .keycap { margin-right: 7px; }
.horror-hud .training-key__label { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 13px; color: rgb(147, 143, 129); margin: 0; padding: 0; white-space: nowrap; }
.horror-hud .training-key--down { background-color: rgba(186, 154, 98, 0.35); border-color: rgb(186, 154, 98); scale: 1.06 1.06; }
.horror-hud .training-key--down .training-key__label { color: rgb(217, 207, 184); }
.horror-hud .training-key--used { border-color: rgba(140, 176, 106, 0.6); }
.training-list { margin-top: 2px; }
.training-list__row { flex-direction: row; align-items: flex-start; margin-bottom: 3px; }
.training-list__mark { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); width: 20px; min-width: 20px; font-size: 15px; margin: 0; padding: 0; color: rgba(217, 207, 184, 0.3); }
.training-list__title { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 15px; margin: 0; padding: 0; white-space: normal; flex-shrink: 1; color: rgba(217, 207, 184, 0.38); }
.training-list__row--done .training-list__mark { color: rgb(140, 176, 106); }
.training-list__row--done .training-list__title { color: rgb(147, 143, 129); }
.training-list__row--now .training-list__mark { color: rgb(186, 154, 98); }
.training-list__row--now .training-list__title { color: rgb(217, 207, 184); -unity-font-style: bold; }
.training-mark { position: absolute; translate: -50% -100%; align-items: center; }
.training-mark__label { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 17px; letter-spacing: 2px; color: rgb(217, 207, 184); background-color: rgba(13, 15, 14, 0.86); border-left-width: 3px; border-left-color: rgb(186, 154, 98); padding: 1px 9px 1px 8px; margin: 0; white-space: nowrap; }
.training-mark__distance { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 13px; color: rgb(217, 207, 184); background-color: rgba(13, 15, 14, 0.6); padding: 0 6px 0 6px; margin: 2px 0 0 0; white-space: nowrap; }
.training-mark__arrow { width: 30px; height: 20px; margin-top: 3px; }
.training-mark--danger .training-mark__label { border-left-color: rgb(172, 87, 67); color: rgb(232, 158, 138); }
.training-mark--danger .training-mark__distance { color: rgb(232, 158, 138); }
.training-mark--away .training-mark__label { border-left-color: rgb(172, 87, 67); }
.training-edge { position: absolute; translate: -50% -50%; align-items: center; justify-content: center; width: 64px; height: 64px; }
.training-edge__arrow { position: absolute; left: 15px; top: 17px; width: 34px; height: 30px; }
.training-edge__distance { position: absolute; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 12px; color: rgb(217, 207, 184); background-color: rgba(13, 15, 14, 0.75); padding: 0 4px 0 4px; margin: 0; white-space: nowrap; }
.training-highlight { position: absolute; border-width: 2px; border-color: rgb(186, 154, 98); background-color: rgba(186, 154, 98, 0.06); }
.training-highlight__label { position: absolute; left: -2px; bottom: 100%; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 13px; letter-spacing: 1px; color: rgb(13, 15, 14); background-color: rgb(186, 154, 98); padding: 1px 6px 1px 6px; margin: 0 0 3px 0; white-space: nowrap; }
.training-highlight--below .training-highlight__label { bottom: auto; top: 100%; margin: 3px 0 0 0; }
.menu-short .horror-hud .training-card { top: 72px; padding: 8px 14px 10px 14px; }
.menu-short .horror-hud .training-card__title { font-size: 22px; }
.menu-short .horror-hud .training-card__text { font-size: 15px; }

/* ---- from Resources/ModernMenus.uss ---- */
.menu-short .mm-page .heading { font-size: 46px; }
.settings .section { margin-top: 22px; margin-bottom: 4px; padding: 8px 12px; font-size: 14px; letter-spacing: 3px; color: var(--c-accent-hot); background-color: var(--c-panel-3); }
.settings .setting { padding: 0 12px; border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.settings .setting--explained:hover { background-color: var(--c-panel-2); }
.mm-main { padding: 0; }
.mm-rail { position: absolute; left: 0; top: 0; bottom: 56px; width: 44%; min-width: 520px; padding: 6% 32px 0 6%; }
.menu-narrow .mm-rail { width: 100%; min-width: 0; padding-left: 28px; }
.menu-narrow .mm-main__shade { width: 100%; }
.menu-compact .mm-main .main__logo { font-size: 64px; }
.menu-short .mm-main .main__logo { font-size: 60px; }
.menu-narrow .mm-main .main__logo { font-size: 56px; }
.mm-nav { width: 460px; max-width: 100%; margin-top: 4px; }
.mm-status__links { flex-wrap: wrap; }
.mm-status__version { font-size: 14px; color: var(--c-faint); }
.pause .pause__content { justify-content: flex-start; padding: 0; min-height: 100%; }
.pause .pause__columns { width: 100%; max-width: none; min-height: 100%; align-items: stretch; }
.pause .pause__left { width: 420px; margin-right: 56px; padding: 56px 40px 32px 48px; background-color: var(--c-panel); border-left-width: 6px; border-left-color: var(--c-accent); border-right-width: 1px; border-right-color: var(--c-line); }
.pause .pause__left .title { font-size: 58px; letter-spacing: 4px; }
.menu-narrow .pause .pause__left { width: 100%; margin-right: 0; }

/* ---- from Resources/Remake2026.uss ---- */
.mm-main__shade { position: absolute; left: 0; top: 0; bottom: 0; width: 46%; border-right-width: 1px; border-right-color: var(--c-line); background-color: rgba(4, 5, 6, 0.55); }
.mm-status { position: absolute; left: 0; right: 0; bottom: 0; height: 56px; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 3%; border-top-width: 1px; border-top-color: var(--c-line); background-color: rgba(6, 7, 8, 0.85); }
.wardrobe__card { width: 168px; margin: 0 10px 10px 0; padding: 10px; flex-direction: column; align-items: flex-start; justify-content: space-between; -unity-background-image-tint-color: rgba(0, 0, 0, 0); height: auto; min-height: 142px; min-width: 0; max-width: 100%; flex-shrink: 0; background-color: var(--c-panel-2); border-width: 1px; border-color: var(--c-line); border-radius: 0; }
.wardrobe__card:hover { background-color: var(--c-panel-3); border-color: rgba(214, 158, 72, 0.6); }
.wardrobe__card:focus { background-color: var(--c-panel-3); border-color: rgba(214, 158, 72, 0.6); }
.wardrobe__card--selected { background-color: rgba(214, 158, 72, 0.1); border-color: var(--c-accent); border-width: 1px; border-left-width: 4px; }
.wardrobe__card--locked { opacity: 0.55; }
.wardrobe__chip { width: 34px; height: 34px; border-width: 1px; border-color: rgba(0, 0, 0, 0.5); align-items: center; justify-content: center; border-radius: 0; background-color: var(--c-panel-3); }
.wardrobe__chip--icon { width: 96px; height: 96px; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; }
.wardrobe__preview { width: 360px; height: 450px; margin-right: 24px; border-radius: 4px; -unity-background-scale-mode: scale-to-fit; min-height: 160px; max-height: 100%; flex-grow: 1; flex-shrink: 1; background-color: rgb(9, 10, 11); border-width: 1px; border-color: var(--c-line); }
.wardrobe__detail { width: 330px; min-width: 260px; flex-shrink: 0; margin-left: 22px; padding: 18px; background-color: rgba(31, 28, 22, 0.8); border-top-width: 2px; border-top-color: rgb(126, 57, 43); border-left-width: 1px; border-left-color: var(--c-line); }
.creator { background-color: rgb(6, 7, 8); }
.creator .mm-page { width: 100%; max-width: 100%; border-left-width: 0; }
.creator__sign { align-self: flex-end; margin-top: 14px; padding: 12px 40px; font-size: 22px; letter-spacing: 6px; color: var(--c-accent-ink); background-color: var(--c-accent); border-width: 0; }
.creator__sign:hover { background-color: var(--c-accent-hot); color: var(--c-accent-ink); }
.creator__sign:focus { background-color: var(--c-accent-hot); color: var(--c-accent-ink); }
.dialogue__box { border-left-width: 3px; border-left-color: var(--c-accent); background-color: rgba(6, 7, 8, 0.82); }
.dialogue__speaker { letter-spacing: 3px; font-size: 16px; color: var(--c-accent); }
.dialogue__role { letter-spacing: 3px; font-size: 13px; color: var(--c-faint); }
.dialogue__line { color: var(--c-text); font-size: 25px; }
.dialogue__reply { align-self: flex-start; margin-top: 4px; font-size: 18px; }
.dialogue__hint { letter-spacing: 2px; }
.crew-board .heading { font-size: 46px; }
.crew-row { min-height: 58px; border-radius: 0; flex-direction: column; align-items: stretch; padding: 14px 8px; background-color: rgba(35, 33, 27, 0.5); margin-bottom: 6px; border-bottom-width: 1px; border-bottom-color: var(--c-line); padding-top: 8px; padding-bottom: 8px; }
.crew-row__swatch { width: 14px; height: 40px; margin-right: 14px; background-color: var(--c-panel-3); flex-shrink: 0; border-radius: 0; }
.crew-row__talking--on { border-color: var(--c-good); background-color: var(--c-good); }
.pause { padding-left: 0; justify-content: center; align-items: center; background-color: rgba(4, 5, 6, 0.6); }
.pause__left { min-width: 0; flex-shrink: 0; width: 390px; margin-right: 64px; padding-top: 8px; border-left-width: 3px; border-left-color: var(--c-accent); background-color: var(--c-panel); padding: 48px 56px; }
.pause__warning { color: var(--c-faint); }
.hud-card { flex-grow: 1; flex-basis: 0; margin: 0 6px 0 6px; border-left-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-color: var(--c-line); border-right-color: var(--c-line); border-bottom-color: var(--c-line); -unity-background-scale-mode: stretch-to-fill; border-width: 1px; border-top-width: 3px; border-top-color: var(--c-accent); padding: 16px; border-radius: 0; border-color: var(--c-line); background-color: rgba(8, 9, 10, 0.72); }
.toast { flex-direction: row; align-items: center; margin-bottom: 8px; translate: 0 0; opacity: 1; transition-property: translate, opacity; transition-duration: 0.22s; border-width: 1px; border-color: var(--c-line); padding: 12px; border-radius: 0; border-left-width: 3px; border-left-color: var(--c-accent); background-color: rgba(8, 9, 10, 0.9); }

/* ---- from Resources/Remake2026Layouts.uss ---- */
.archive-panel { background-color: var(--c-panel); background-image: none; border-width: 1px; border-color: var(--c-line); border-left-width: 3px; border-left-color: var(--c-accent); border-radius: 0; padding: 30px 36px 24px 40px; }
.archive-panel .board__cork { border-color: rgb(72, 64, 47); flex-direction: row; flex-wrap: wrap; align-items: stretch; background-color: rgba(0, 0, 0, 0); background-image: none; border-width: 0; padding: 0; }
.archive-panel .board__cork .sheet { min-width: 0; flex-basis: 30%; flex-grow: 1; flex-shrink: 1; margin: 0 8px 12px 0; padding: 18px 18px 14px 18px; background-color: var(--c-panel-2); background-image: none; border-width: 1px; border-color: var(--c-line); border-top-width: 3px; border-top-color: var(--c-accent); border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.archive-panel .sheet__place { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); white-space: normal; color: var(--c-text); letter-spacing: 4px; font-size: 22px; }
.archive-panel .sheet__job { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); margin-top: 6px; white-space: normal; color: var(--c-accent); letter-spacing: 3px; font-size: 14px; margin-bottom: 8px; }
.archive-panel .sheet__text { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-font-style: normal; color: var(--c-dim); font-size: 15px; margin-bottom: 6px; white-space: normal; }
.archive-panel .sheet__quip { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-faint); -unity-font-style: italic; font-size: 14px; margin-bottom: 8px; white-space: normal; }
.archive-panel .sheet__fact { border-top-width: 1px; border-top-color: var(--c-line); padding-top: 5px; padding-bottom: 5px; }
.archive-panel .sheet__fact-label { color: var(--c-faint); letter-spacing: 2px; font-size: 13px; width: 38%; flex-shrink: 0; }
.archive-panel .sheet__fact-value { color: var(--c-text); font-size: 16px; }
.archive-panel .sheet__fact-value--warn { color: var(--c-bad); }
.archive-panel .sheet__fact-note { margin-top: 3px; color: var(--c-faint); font-size: 12px; white-space: normal; }
.archive-panel .sheet__take { letter-spacing: 0; margin-top: 12px; align-self: stretch; -unity-text-align: middle-center; }
.archive-panel .sheet__stamp { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); border-width: 1px; border-color: var(--c-good); color: var(--c-good); background-color: rgba(140, 182, 150, 0.08); font-size: 16px; letter-spacing: 6px; }
.archive-panel .dispatch-briefing { border-width: 1px; border-color: rgb(66, 60, 45); border-left-width: 2px; border-left-color: var(--c-accent); background-color: rgba(214, 158, 72, 0.05); padding: 12px 16px; margin-bottom: 16px; }
.appraisal__columns { flex-wrap: wrap; min-width: 0; flex-shrink: 0; flex-direction: row; align-items: flex-start; }
.receipt { border-bottom-width: 6px; -unity-background-scale-mode: stretch-to-fill; border-bottom-color: rgb(118, 118, 96); width: 48%; min-width: 280px; max-width: 550px; flex-basis: 55%; flex-grow: 1; flex-shrink: 1; margin-right: 22px; padding: 20px 24px; background-color: var(--c-panel-2); background-image: none; border-width: 1px; border-color: var(--c-line); border-top-width: 3px; border-top-color: var(--c-accent); color: var(--c-text); }
.receipt__head { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 26px; -unity-text-align: middle-center; letter-spacing: 5px; color: var(--c-accent); }
.receipt__row { height: auto; min-height: 28px; flex-shrink: 0; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); -unity-font-style: normal; font-size: 16px; letter-spacing: 0; border-bottom-width: 1px; border-bottom-color: var(--c-line); padding-top: 3px; padding-bottom: 3px; }
.receipt__line { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-text); font-size: 16px; flex-basis: 0; min-width: 0; flex-grow: 1; flex-shrink: 1; white-space: normal; border-bottom-width: 1px; border-bottom-color: var(--c-line); padding-top: 3px; padding-bottom: 3px; }
.receipt__line-value { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 16px; -unity-text-align: middle-right; min-width: 100px; color: var(--c-text); }
.receipt__line-value--damaged { color: var(--c-bad); }
.receipt__was { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 14px; margin-right: 6px; color: var(--c-faint); }
.receipt__small { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 14px; -unity-text-align: middle-center; color: var(--c-faint); }
.receipt__rule { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 15px; -unity-text-align: middle-center; overflow: hidden; color: rgb(76, 82, 65); background-color: var(--c-line); height: 1px; }
.receipt__total { margin-top: 10px; padding-top: 8px; border-top-width: 2px; border-top-color: var(--c-accent); }
.receipt__total-label { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 24px; flex-grow: 1; letter-spacing: 4px; color: var(--c-dim); }
.receipt__total-value { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 30px; color: var(--c-money); }
.receipt__stamp { background-color: rgba(186, 180, 156, 0.25); border-width: 3px; position: relative; top: auto; right: auto; bottom: auto; left: auto; align-self: flex-start; margin-top: 12px; font-size: 26px; scale: 1 1; white-space: normal; border-color: var(--c-good); color: var(--c-good); }
.appraisal__side { min-width: 0; border-left-width: 6px; border-left-color: var(--c-accent); background-color: var(--c-panel); flex-basis: 40%; flex-grow: 1; flex-shrink: 1; }
.tally { min-height: 30px; border-bottom-width: 1px; border-bottom-color: var(--c-line); padding-top: 6px; padding-bottom: 6px; }
.tally__label { font-size: 18px; flex-grow: 1; min-width: 0; flex-shrink: 1; white-space: normal; color: var(--c-dim); letter-spacing: 2px; }
.tally__value { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-ExtraBold.ttf"); font-size: 24px; min-width: 90px; flex-shrink: 0; color: var(--c-text); }
.tally--total .tally__value { color: var(--c-money); font-size: 26px; }
.award { min-height: 30px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06); background-color: var(--c-panel-2); border-left-width: 3px; border-left-color: var(--c-accent); padding: 8px 12px; margin-top: 8px; }
.appraisal__buttons { margin-top: 18px; flex-direction: row; flex-wrap: wrap; }
.travel { position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: space-between; background-color: rgb(6, 7, 8); }
.travel__where { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 64px; margin-top: 18px; color: var(--c-text); letter-spacing: 10px; }
.travel__middle { flex-grow: 1; align-items: center; justify-content: center; border-left-width: 3px; border-left-color: var(--c-accent); padding-left: 28px; }
.travel__terms { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/BarlowCondensed/BarlowCondensed-SemiBold.ttf"); font-size: 24px; margin-top: 6px; color: var(--c-dim); letter-spacing: 2px; }
.travel__tip { font-size: 19px; -unity-text-align: middle-center; margin-bottom: 30px; color: var(--c-faint); border-top-width: 1px; border-top-color: var(--c-line); padding-top: 10px; margin-top: 14px; }
.transfer__brand { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 34px; margin-bottom: 28px; letter-spacing: 6px; color: var(--c-accent); }
.transfer__direction { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 16px; letter-spacing: 6px; color: var(--c-accent); }
.transfer__status { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 16px; letter-spacing: 2px; white-space: normal; color: var(--c-dim); }
.transfer__progress { height: 2px; background-color: var(--c-accent); }
.transfer__footer { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); letter-spacing: 2px; font-size: 15px; color: var(--c-faint); border-top-width: 1px; border-top-color: var(--c-line); }
.field-inventory__slot { flex-direction: row; align-items: center; padding: 6px 8px; margin-bottom: 4px; min-height: 34px; background-color: rgba(8, 9, 10, 0.72); border-width: 1px; border-color: var(--c-line); border-radius: 0; margin-right: 6px; }
.field-inventory__slot--active { border-color: var(--c-accent); border-bottom-width: 3px; background-color: rgba(214, 158, 72, 0.12); }
.field-inventory__key { color: var(--c-faint); }
.field-inventory__name { color: var(--c-text); }
.field-inventory__selected { color: var(--c-accent-hot); }
.field-compass__tape { position: absolute; height: 22px; top: 0; left: 0; background-color: rgba(6, 7, 8, 0.55); border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.field-compass__needle { position: absolute; bottom: 0; left: 50%; height: 4px; background-color: var(--c-accent); width: 2px; }
.field-compass__mark { color: var(--c-dim); }
.horror-radio { position: absolute; left: 23%; right: 23%; bottom: 56px; padding: 10px 18px 12px 18px; align-items: center; border-width: 1px; border-color: var(--c-line); border-left-width: 3px; border-left-color: var(--c-accent); background-color: rgba(6, 7, 8, 0.8); }
.horror-radio__caption { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); margin-bottom: 4px; font-size: 15px; color: var(--c-accent); letter-spacing: 3px; }

/* ---- from Resources/HqStations.uss ---- */
.field-guide { background-color: rgb(65, 39, 26); border-width: 8px; border-color: rgb(44, 28, 21); border-radius: 9px; padding: 22px 24px 20px 24px; }
.field-guide__cover-title { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 40px; -unity-font-style: bold; letter-spacing: 7px; color: rgb(211, 182, 123); margin-bottom: 2px; }
.field-guide__cover-note { color: rgb(183, 154, 107); font-size: 15px; letter-spacing: 2px; margin-bottom: 16px; }
.field-guide__spread { flex-direction: row; align-items: stretch; flex-shrink: 0; background-color: rgb(214, 199, 165); border-width: 2px; border-color: rgb(152, 126, 86); border-bottom-width: 7px; border-bottom-color: rgb(168, 150, 115); min-height: 480px; }
.field-guide__contents { width: 34%; flex-shrink: 0; min-width: 0; padding: 22px 18px 22px 22px; border-right-width: 10px; border-right-color: rgb(177, 155, 115); background-color: rgb(202, 186, 151); }
.field-guide__page { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 24px 28px 20px 28px; border-left-width: 2px; border-left-color: rgb(231, 216, 177); }
.field-guide__title { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); letter-spacing: 1px; font-size: 34px; -unity-font-style: bold; color: rgb(54, 47, 36); margin: 5px 0 14px 0; }
.field-guide__section { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 19px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(113, 58, 39); margin: 18px 0 8px 0; padding-bottom: 5px; border-bottom-width: 1px; border-bottom-color: rgba(85, 60, 36, 0.28); }
.field-guide__contents > .field-guide__section { margin-top: 0; }
.field-guide__body { white-space: normal; font-size: 20px; color: rgb(62, 54, 40); margin-bottom: 8px; }
.field-guide__note { font-size: 15px; -unity-font-style: italic; color: rgb(111, 87, 59); margin-bottom: 8px; }
.field-guide__contents > .field-guide__body { font-size: 17px; margin-bottom: 18px; }
.field-guide__entry { background-color: rgba(0, 0, 0, 0); border-width: 0; border-bottom-width: 1px; border-bottom-color: rgba(79, 57, 34, 0.15); border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); min-height: 42px; padding: 7px 5px 7px 7px; margin: 2px 0 2px 0; -unity-text-align: middle-left; }
.field-guide__entry-name { font-size: 18px; color: rgb(69, 54, 37); }
.field-guide__entry--locked .field-guide__entry-name { color: rgb(128, 113, 88); -unity-font-style: italic; }
.field-guide__entry:hover { background-color: rgba(126, 82, 42, 0.12); }
.field-guide__entry:focus { border-width: 2px; border-color: var(--c-accent-hot); background-color: rgba(126, 82, 42, 0.12); }
.field-guide__paging { margin-top: 28px; justify-content: space-between; flex-wrap: wrap; }
.field-guide__page-number { font-size: 16px; color: rgb(108, 82, 52); padding: 5px 10px 5px 10px; }
.field-guide__turn:focus { background-color: rgb(190, 165, 121); }
.field-guide__turn:disabled { opacity: 0.4; }
.field-guide__close:focus { background-color: rgb(95, 58, 34); }
.dispatch-briefing { background-color: rgb(25, 29, 26); padding: 12px 18px 16px 18px; margin-bottom: 18px; border-left-width: 4px; border-left-color: rgb(152, 134, 85); }
.dispatch-briefing > .section { margin-top: 0; }
.dispatch-briefing > .subtitle { font-size: 20px; margin-bottom: 8px; }
.scrap-depot { border-top-color: rgb(156, 125, 67); }
.field-guide__entry--selected { background-color: rgba(126, 82, 42, 0.1); border-left-width: 5px; border-left-color: rgb(242, 190, 40); }
.field-guide__close { font-size: 22px; color: rgb(216, 191, 145); background-color: rgb(51, 31, 22); border-width: 1px; border-color: rgb(147, 115, 72); align-self: flex-end; padding: 8px 20px 8px 20px; margin-top: 16px; border-radius: 0; border-bottom-width: 2px; border-bottom-color: rgb(242, 190, 40); }
.field-guide__turn { font-size: 17px; color: rgb(87, 51, 32); background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgba(92, 64, 38, 0.4); padding: 7px 10px 7px 10px; margin: 2px 0 2px 0; border-radius: 0; border-bottom-width: 2px; border-bottom-color: rgb(242, 190, 40); }
.field-guide__close:hover { background-color: rgb(242, 190, 40); color: rgb(18, 16, 8); }
.field-guide__turn:hover { background-color: rgb(242, 190, 40); color: rgb(18, 16, 8); }

/* ======================================================================================================
   Components. Written once, last, so nothing above restyles them: buttons, text, panels, pages, settings.
   ====================================================================================================== */

/* ---- type ---- */
.title { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 64px; letter-spacing: 2px; color: var(--c-text); margin: 0 0 6px 0; white-space: nowrap; }
.heading { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 44px; letter-spacing: 2px; color: var(--c-text); margin: 0 0 14px 0; white-space: normal; }
.subtitle { font-size: 18px; color: var(--c-dim); margin: 0 0 18px 0; white-space: normal; }
.section { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 14px; letter-spacing: 3px; color: var(--c-accent); margin: 22px 0 6px 0; padding-bottom: 6px; border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.text { font-size: 17px; color: var(--c-dim); margin-bottom: 4px; white-space: normal; min-width: 0; }
.text--small { font-size: 15px; }
.text--error { color: var(--c-bad); }
.text--good { color: var(--c-good); }
.text--money { color: var(--c-money); }

/* ---- buttons: text on dark, an accent bar on hover/focus (menu-button--lit is both) ---- */
.menu-button { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 22px; letter-spacing: 1px; color: var(--c-text); -unity-text-align: middle-left; white-space: normal; min-height: 46px; height: auto; flex-shrink: 0; margin: 2px 0; padding: 8px 16px; border-radius: 0; border-width: 0; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); background-image: none; }
.menu-button:hover, .menu-button:focus, .menu-button--lit { color: var(--c-accent-hot); border-left-color: var(--c-accent); background-color: rgba(214, 158, 72, 0.08); }
.menu-button--pressed, .menu-button:active { background-color: rgba(214, 158, 72, 0.18); }
.menu-button:disabled { opacity: 0.4; }
.menu-button--small { font-size: 16px; letter-spacing: 0; -unity-text-align: middle-center; align-self: flex-start; min-height: 34px; margin: 3px; padding: 5px 12px; border-width: 1px; border-color: var(--c-line); background-color: var(--c-panel-2); }
.menu-button--small:hover, .menu-button--small:focus, .menu-button--small.menu-button--lit { color: var(--c-text); border-color: var(--c-accent); background-color: var(--c-panel-3); }
.menu-button--on, .menu-button--on:hover, .menu-button--on.menu-button--lit { color: var(--c-accent-hot); border-color: var(--c-accent); background-color: rgba(214, 158, 72, 0.14); }

/* ---- screens: a dimmed backdrop with a panel (in-world screens) or a full-height page down the left (menus) ---- */
.backdrop { flex-grow: 1; justify-content: center; padding: 20px; background-color: rgba(4, 5, 6, 0.7); }
.backdrop--dim { background-color: rgba(4, 5, 6, 0.86); }
.backdrop--center { align-items: center; }
.panel { width: 660px; max-width: 92%; max-height: 92%; min-width: 0; min-height: 0; flex-direction: column; padding: 28px 32px; border-radius: 0; border-width: 1px; border-color: var(--c-line); border-left-width: 3px; border-left-color: var(--c-accent); background-color: var(--c-panel); background-image: none; }
.panel--wide { width: 960px; }
.panel--xwide { width: 1180px; }
.mm-backdrop { padding: 0; justify-content: flex-start; align-items: flex-start; background-color: rgba(4, 5, 6, 0.55); }
.mm-page { height: 100%; max-height: 100%; width: 56%; min-width: 640px; max-width: 1100px; margin: 0; padding: 48px 56px 28px 64px; border-radius: 0; border-width: 0; border-left-width: 3px; border-left-color: var(--c-accent); border-right-width: 1px; border-right-color: var(--c-line); background-color: var(--c-panel); }
.mm-page--wide { width: 80%; max-width: 1500px; }
.mm-hint { position: absolute; right: 32px; bottom: 24px; font-size: 15px; color: var(--c-faint); }
.scroll { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; }
.menu-narrow .mm-page, .menu-narrow .mm-page--wide { width: 100%; min-width: 0; padding: 32px 28px 20px 32px; }
.menu-short .heading { font-size: 36px; margin-bottom: 8px; }
.menu-short .mm-page { padding-top: 28px; }

/* ---- settings rows (MenuKit.Percent/Range/Switch/Choice/Toggle) ---- */
.setting { flex-direction: row; align-items: center; min-height: 48px; height: auto; min-width: 0; flex-shrink: 0; padding: 2px 0; border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.setting__label { width: 38%; min-width: 0; flex-shrink: 1; font-size: 17px; color: var(--c-text); white-space: normal; padding-right: 12px; }
.setting__value { width: 84px; min-width: 70px; flex-shrink: 0; -unity-text-align: middle-right; font-size: 16px; color: var(--c-accent-hot); }
.setting__control { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 100px; }
.choice__value { flex-grow: 1; flex-shrink: 1; min-width: 0; -unity-text-align: middle-center; font-size: 17px; color: var(--c-text); white-space: normal; }
.choice__arrow { width: 40px; min-width: 40px; flex-shrink: 0; padding: 0; margin-left: 0; color: var(--c-accent); }

/* ---- settings: the pages down the left, the open page beside them, one line of help in the footer ---- */
.settings__columns { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; margin-top: 4px; }
.settings__nav { flex-grow: 0; flex-shrink: 0; width: 220px; margin-right: 28px; padding-right: 16px; border-right-width: 1px; border-right-color: var(--c-line); }
.settings__nav-button { font-size: 20px; min-height: 42px; color: var(--c-dim); }
.settings__nav-button--open, .settings__nav-button--open:hover, .settings__nav-button--open.menu-button--lit { color: var(--c-accent-ink); background-color: var(--c-accent); border-left-color: var(--c-accent-hot); }
.settings__page { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; }
.settings__body { flex-grow: 1; min-height: 0; min-width: 0; }
.settings__note { font-size: 15px; color: var(--c-faint); margin: 3px 0 12px 0; white-space: normal; }
.settings__footer { flex-direction: row; align-items: center; flex-shrink: 0; margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-color: var(--c-line); }
.settings__back { flex-grow: 0; }
.settings__reset { align-self: center; }
.settings__help-text { margin: 0 0 0 18px; font-size: 15px; color: var(--c-dim); white-space: normal; }

/* ---- the title screen ---- */
.main__logo { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 96px; letter-spacing: 2px; color: var(--c-text); margin: 0; white-space: nowrap; }
.mm-main .subtitle { color: var(--c-accent); font-size: 17px; letter-spacing: 2px; margin: 0 0 32px 0; }
.mm-nav__item { font-size: 26px; letter-spacing: 2px; min-height: 54px; padding-left: 18px; }
.mm-nav .setting { border-bottom-width: 0; padding-left: 18px; }
.mm-nav .setting__label { width: 30%; color: var(--c-dim); }
.menu-narrow .main__logo { font-size: 64px; }
