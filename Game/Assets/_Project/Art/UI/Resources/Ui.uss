.menu-screen .language-list__button--current { color: var(--c-text); border-left-color: rgb(151, 65, 47); background-color: rgba(91, 45, 33, 0.4); border-bottom-color: var(--c-accent); }

/* ---- from Resources/HorrorHud.uss ---- */
.horror-hud { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: var(--c-text); }
.horror-hud .h-vitals { left: 28px; bottom: 40px; width: 216px; padding: 12px 14px 10px 12px; background-color: var(--c-ink); border-width: 0; border-left-width: 2px; border-left-color: var(--c-faint); border-top-width: 1px; border-top-color: var(--c-faint); }
.horror-hud .h-inventory { right: 28px; bottom: 40px; width: 460px; max-width: none; flex-direction: column; align-items: stretch; opacity: 1; }
.horror-hud .h-inspection { position: absolute; right: 28px; width: 460px; max-width: none; padding: 14px; background-color: rgba(14, 16, 14, 0.96); border-width: 1px; border-color: var(--c-faint); border-top-width: 2px; border-top-color: var(--c-accent); }
.horror-hud .h-reticle { width: 3px; height: 3px; margin: -1.5px 0 0 -1.5px; background-color: var(--c-text); border-width: 0; border-radius: 0; }
.horror-hud .h-reticle .h-reticle__corner { display: none; position: absolute; width: 6px; height: 6px; border-color: var(--c-text); }
.horror-hud .h-reticle.hud-crosshair--target { width: 22px; height: 22px; margin: -11px 0 0 -11px; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; }
.horror-hud .h-reticle.hud-crosshair--target .h-reticle__corner { display: flex; }
.horror-hud .h-reticle__corner--nw { left: 0; top: 0; border-left-width: 1px; border-top-width: 1px; }
.horror-hud .h-reticle__corner--ne { right: 0; top: 0; border-right-width: 1px; border-top-width: 1px; }
.horror-hud .h-reticle__corner--sw { left: 0; bottom: 0; border-left-width: 1px; border-bottom-width: 1px; }
.horror-hud .h-reticle__corner--se { right: 0; bottom: 0; border-right-width: 1px; border-bottom-width: 1px; }
.horror-hud .h-reticle.hud-crosshair--hidden { opacity: 0; }
.horror-hud .h-floor-warning { left: 28px; right: 28px; top: 40%; bottom: auto; translate: 0 0; width: auto; min-width: 0; white-space: normal; -unity-text-align: middle-center; }
.horror-hud .h-recovery { left: auto; right: 28px; top: 28px; width: 340px; max-width: 28%; padding: 12px 14px; background-color: var(--c-ink); border-top-width: 1px; border-top-color: var(--c-faint); border-left-width: 2px; border-left-color: var(--c-accent); translate: 0 0; align-items: stretch; }
.colorblind .horror-hud { }

