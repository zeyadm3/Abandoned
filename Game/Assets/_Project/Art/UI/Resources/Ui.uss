.crew-transmissions__keys { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 15px; letter-spacing: 1px; padding: 4px 10px 4px 10px; background-color: rgba(8, 11, 9, 0.78); margin-top: 5px; color: rgb(144, 151, 127); }
.crew-transmissions .chat__log { border-width: 0; border-left-width: 1px; border-left-color: rgb(89, 76, 53); padding: 0 0 0 8px; }
.crew-transmissions .chat__line { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); color: rgb(214, 209, 183); font-size: 16px; padding: 4px 7px 4px 7px; background-color: rgba(8, 11, 9, 0.74); margin-top: 4px; }
.crew-transmissions .chat__line--ghost { border-left-width: 2px; border-left-color: rgb(112, 121, 111); }
.crew-transmissions.chat--open .chat__log { background-color: rgba(10, 13, 10, 0.9); padding: 8px 10px 8px 10px; }
.crew-transmissions .chat__field > .unity-text-field__input { background-color: rgb(21, 23, 18); color: rgb(225, 216, 184); border-width: 1px; border-color: rgb(126, 98, 63); border-left-width: 3px; border-left-color: rgb(161, 80, 53); padding: 10px 12px 10px 12px; font-size: 17px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); }
.crew-transmissions .chat__field > .unity-base-text-field__input { background-color: rgb(21, 23, 18); color: rgb(225, 216, 184); border-width: 1px; border-color: rgb(126, 98, 63); border-left-width: 3px; border-left-color: rgb(161, 80, 53); padding: 10px 12px 10px 12px; font-size: 17px; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); }
.crew-voice.hud-voice { left: 24px; bottom: 24px; max-width: 30%; -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 15px; color: rgb(144, 149, 125); white-space: normal; padding: 5px 9px 5px 9px; background-color: rgba(9, 12, 9, 0.78); border-left-width: 1px; border-left-color: rgb(66, 71, 53); }
.crew-voice--transmitting.hud-voice { color: rgb(218, 213, 186); border-left-color: var(--c-good); }
.crew-voice--radio.hud-voice { color: rgb(198, 170, 109); border-left-color: rgb(154, 121, 70); }
.crew-voice--fault.hud-voice { color: var(--c-bad); border-left-color: var(--c-bad); }
.speaker-mark { position: absolute; translate: -50% -100%; flex-direction: row; align-items: center; border-radius: 0; border-left-width: 3px; background-color: rgba(9, 12, 9, 0.89); border-width: 1px; border-color: rgb(98, 104, 78); padding: 5px 9px 5px 9px; }
.speaker-mark__name { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Bold.ttf"); font-size: 15px; color: rgb(211, 211, 183); }
.speaker-mark--radio { border-color: rgb(159, 127, 75); }
.speaker-mark--radio .icon { -unity-background-image-tint-color: rgb(183, 154, 97); }
.instrument-hud.hud-panel { width: 294px; max-width: 25%; background-color: rgba(10, 15, 11, 0.94); border-width: 1px; border-color: rgb(79, 83, 55); border-top-width: 3px; border-top-color: rgb(149, 128, 78); border-left-width: 1px; padding: 15px 17px 16px 17px; }
.instrument-hud--motion.hud-motion { right: 28px; top: 48%; }
.instrument-hud--structure.hud-scanner { left: auto; right: 28px; top: 48%; }
.instrument-hud__title { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 25px; letter-spacing: 2px; color: rgb(203, 194, 157); white-space: normal; }
.instrument-hud__meta { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); white-space: normal; font-size: 15px; color: rgb(140, 142, 107); margin: 4px 0 12px 0; }
.instrument-hud__count { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); font-size: 16px; white-space: normal; color: rgb(163, 148, 99); margin-top: 10px; margin-bottom: 8px; }
.instrument-hud__readout { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); white-space: normal; font-size: 17px; color: rgb(177, 193, 145); }
.instrument-hud__signal { height: 8px; margin: 5px 0 4px 0; }
.instrument-hud__signal .segment { background-color: rgb(27, 33, 19); border-width: 1px; border-color: rgb(55, 64, 36); margin-right: 3px; }
.instrument-hud__signal .segment__fill { background-color: rgb(158, 179, 106); }
.instrument-hud--contact.hud-panel { border-top-color: rgb(188, 162, 92); }
.horror-hud .hud-nightvision { right: 28px; width: 294px; max-width: 25%; }
.horror-hud .hq-brief { position: absolute; top: 24px; left: 28px; right: 28px; max-width: 620px; min-width: 0; flex-direction: column; padding: 10px 14px 11px 14px; background-color: var(--c-ink); border-width: 0; border-left-width: 2px; border-left-color: var(--c-accent); border-top-width: 1px; border-top-color: var(--c-faint); }
.horror-hud .hq-brief__metrics { flex-direction: row; align-items: stretch; margin-bottom: 8px; }
.horror-hud .hq-brief__metric { flex-basis: 0; flex-grow: 1; flex-shrink: 1; min-width: 0; padding-left: 14px; border-left-width: 1px; border-left-color: var(--c-faint); }
.horror-hud .hq-brief__account { flex-grow: 1.35; padding-left: 0; border-left-width: 0; padding-right: 12px; }
.horror-hud .hq-brief__clearance { flex-grow: 1.2; padding-right: 12px; }
.horror-hud .hq-brief__caption { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); margin: 0; padding: 0; min-width: 0; flex-shrink: 0; white-space: normal; color: var(--c-dim); font-size: 13px; letter-spacing: 1px; margin-bottom: 2px; }
.horror-hud .hq-brief__value { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 30px; color: var(--c-text); margin: 0; padding: 0; min-width: 0; flex-shrink: 0; white-space: normal; }
.horror-hud .hq-brief__metric--warning .hq-brief__value { color: var(--c-bad); }
.horror-hud .hq-brief__progress { flex-direction: row; flex-wrap: wrap; align-items: flex-end; }
.horror-hud .hq-brief__experience { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); padding: 0; min-width: 0; flex-shrink: 0; white-space: normal; color: var(--c-dim); letter-spacing: 0; font-size: 13px; margin: 0 0 6px 10px; }
.horror-hud .hq-brief__assignment { flex-direction: row; align-items: flex-start; padding-top: 8px; border-top-width: 1px; border-top-color: var(--c-faint); }
.horror-hud .hq-brief__dispatch-caption { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 16px; color: var(--c-accent); letter-spacing: 1px; width: 96px; flex-shrink: 0; padding: 0; margin: 0 12px 0 0; }
.horror-hud .hq-brief__detail { flex-basis: 0; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.horror-hud .hq-brief__job { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); margin: 0; padding: 0; min-width: 0; flex-shrink: 0; white-space: normal; letter-spacing: 0; font-size: 15px; color: var(--c-text); }
.horror-hud .hq-brief__departure { -unity-font-definition: url("project://database/Assets/_Project/Art/ThirdParty/Fonts/Barlow/Barlow-Medium.ttf"); margin: 0; padding: 0; min-width: 0; flex-shrink: 0; white-space: normal; letter-spacing: 0; font-size: 13px; color: var(--c-accent); margin-top: 3px; }
.horror-hud .hq-brief--compact .hq-brief__metric { padding-left: 10px; }
.horror-hud .hq-brief--compact .hq-brief__account { padding-left: 0; padding-right: 8px; }
.horror-hud .hq-brief--compact .hq-brief__clearance { padding-right: 8px; }
.horror-hud .hq-brief--compact .hq-brief__caption { font-size: 12px; letter-spacing: 0; }
.horror-hud .hq-brief--compact .hq-brief__value { font-size: 26px; }
.horror-hud .hq-brief--compact .hq-brief__progress { flex-direction: column; align-items: flex-start; }
.horror-hud .hq-brief--compact .hq-brief__experience { margin: 0; }
.horror-hud .hq-brief--compact .hq-brief__assignment { flex-direction: column; }
.horror-hud .hq-brief--compact .hq-brief__dispatch-caption { margin-bottom: 3px; }
.horror-hud .hq-brief--compact .hq-brief__detail { flex-basis: auto; flex-grow: 0; flex-shrink: 0; width: 100%; }
.archive-panel.archive-panel--compact { padding: 16px 18px 16px 18px; }
.archive-panel.archive-panel--compact .board__cork .sheet { margin: 0 5px 14px 5px; padding: 14px 12px 14px 12px; }
