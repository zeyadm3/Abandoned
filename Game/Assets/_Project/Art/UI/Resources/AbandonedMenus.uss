/* ABANDONED — a recovery record left in a condemned building.
   Original architectural framing, oxidised metal and worn stencil paint.
   Menu-only composition; shared controls and the in-game instruments have their own sheets. */

.menu-screen .backdrop,
.menu-screen.backdrop {
    background-color: rgba(6, 7, 7, 0.8);
    padding-left: 0;
}

.menu-screen .panel {
    background-color: rgba(15, 16, 15, 0.97);
    border-left-width: 1px;
    border-left-color: rgba(194, 184, 160, 0.2);
    border-right-width: 1px;
    border-right-color: rgba(194, 184, 160, 0.12);
    border-top-width: 3px;
    border-top-color: rgb(121, 54, 43);
    border-bottom-width: 1px;
    border-bottom-color: rgba(194, 184, 160, 0.2);
    padding: 28px 34px 24px 34px;
}

.menu-screen .heading,
.menu-screen .title {
    -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    color: var(--c-text);
    letter-spacing: 3px;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.6);
}

.menu-screen .heading { font-size: 42px; margin-bottom: 12px; }
.menu-screen .subtitle {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 17px;
    letter-spacing: 1px;
    color: var(--c-dim);
    margin-bottom: 22px;
}

.menu-record,
.pause__eyebrow,
.main__eyebrow {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--c-accent);
    margin-bottom: 10px;
    white-space: normal;
}

.menu-screen .section {
    -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 23px;
    letter-spacing: 2px;
    color: var(--c-text);
    border-bottom-width: 1px;
    border-bottom-color: var(--c-line);
    padding-bottom: 8px;
}

.menu-screen .menu-button {
    -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 29px;
    letter-spacing: 1px;
    border-left-width: 2px;
    border-left-color: rgba(121, 54, 43, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: rgba(194, 184, 160, 0.1);
    padding-left: 10px;
    padding-right: 8px;
    color: var(--c-text);
    transition-duration: 0.12s;
}

.menu-screen .menu-button:hover,
.menu-screen .menu-button:focus,
.menu-screen .menu-button--lit {
    color: rgb(235, 224, 194);
    background-color: rgba(92, 42, 33, 0.16);
    border-left-color: rgb(151, 65, 47);
    border-bottom-color: rgba(181, 139, 92, 0.55);
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.75);
}

.menu-screen .menu-button:focus {
    border-width: 1px;
    border-left-width: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--c-accent);
    border-right-color: var(--c-accent);
}

.menu-screen .menu-button--small {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 17px;
    letter-spacing: 0;
    padding: 7px 12px;
    color: var(--c-dim);
    background-color: rgba(32, 31, 26, 0.9);
    border-width: 1px;
    border-color: rgba(194, 184, 160, 0.22);
    -unity-text-align: middle-center;
}

.menu-screen .menu-button--small:hover,
.menu-screen .menu-button--small:focus,
.menu-screen .menu-button--small.menu-button--on {
    color: var(--c-text);
    background-color: rgb(63, 40, 32);
    border-color: var(--c-accent);
}
.menu-screen .menu-button--small:focus { border-width: 1px; }

.menu-screen .menu-button--pressed { color: rgb(255, 242, 210); }

/* Main screen: words on the left; an incomplete architectural A in the dark on the right. */
.main__shade {
    width: 100%;
    background-color: rgba(5, 6, 6, 0.54);
    border-width: 0;
}

.main__eyebrow { position: absolute; top: 5%; left: 7%; right: 7%; }
.main__column {
    width: 790px;
    max-width: 87%;
    margin-left: 7%;
    padding-left: 0;
    margin-top: 36px;
    margin-bottom: 104px;
}

.main .main__logo {
    font-size: 110px;
    letter-spacing: 2px;
    color: rgb(222, 215, 191);
    margin-bottom: 0;
    white-space: nowrap;
    text-shadow: 0 4px 0 rgba(0, 0, 0, 0.9);
}

.main .subtitle { max-width: 640px; margin-top: 4px; margin-bottom: 18px; letter-spacing: 2px; }
.main__fracture { height: 2px; width: 182px; margin-bottom: 24px; background-color: rgb(126, 57, 43); }
.main__actions { width: 510px; max-width: 100%; flex-shrink: 0; }
.main__action { min-height: 56px; align-items: center; padding-right: 12px; }
.main__index {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    width: 44px;
    font-size: 16px;
    color: rgba(184, 172, 147, 0.48);
    margin-right: 14px;
    padding-top: 4px;
}
.main__action--active .main__index { color: var(--c-accent); }
.main .main__button { flex-grow: 1; font-size: 35px; border-bottom-color: rgba(194, 184, 160, 0.09); }
.main .main__notice { width: 620px; max-width: 100%; padding: 8px 12px; background-color: rgba(68, 28, 24, 0.82); border-left-width: 2px; border-left-color: var(--c-bad); }
.main__links { left: 7%; bottom: 68px; right: 7%; }
.main .main__links .menu-button--small { font-size: 15px; min-height: 30px; padding: 4px 10px; background-color: rgba(18, 18, 15, 0.72); }
.main__memo {
    position: absolute;
    left: 7%; right: 28%; bottom: 30px;
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 15px;
    letter-spacing: 0;
    color: var(--c-faint);
}
.main .footer { right: 4%; bottom: 32px; width: 24%; font-size: 15px; -unity-text-align: middle-right; white-space: normal; }
.main .menu-title__wear { -unity-background-image-tint-color: rgb(10, 11, 10); }
.main .menu-title__stain { -unity-background-image-tint-color: rgb(71, 40, 30); opacity: 0.35; }

.main__ruin { position: absolute; right: 7%; top: 18%; width: 27%; height: 62%; opacity: 0.46; }
.main__ruin-leg { position: absolute; width: 13%; height: 90%; background-color: rgba(112, 107, 92, 0.24); border-left-width: 1px; border-left-color: rgba(217, 206, 174, 0.22); }
.main__ruin-leg--left { left: 20%; top: 0; rotate: 20deg; }
.main__ruin-leg--right { right: 20%; top: 3%; height: 87%; rotate: -20deg; background-color: rgba(112, 107, 92, 0.18); }
.main__ruin-beam { position: absolute; top: 52%; height: 7%; background-color: rgba(133, 84, 60, 0.29); }
.main__ruin-beam--left { left: 20%; width: 28%; rotate: -2deg; }
.main__ruin-beam--right { right: 20%; width: 19%; top: 55%; rotate: 8deg; }
.main__ruin-fault { position: absolute; top: 10%; bottom: 23%; left: 49%; width: 1px; background-color: rgba(178, 134, 99, 0.28); rotate: 2deg; }
.main__ruin-caption {
    position: absolute; right: -1%; bottom: -2%;
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 16px; letter-spacing: 3px;
    color: rgba(194, 184, 160, 0.5);
    -unity-text-align: middle-right;
}

/* The launch record is the first image of the game, including the early-access information. */
.main .launch-notice { background-color: rgba(5, 6, 6, 0.92); }
.main .launch-notice__panel { padding: 32px 38px; border-top-width: 4px; border-top-color: rgb(126, 57, 43); }
.main .launch-notice__title { font-size: 80px; letter-spacing: 3px; margin-bottom: 6px; }
.launch-notice__warning {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    color: var(--c-accent); font-size: 16px; letter-spacing: 2px;
    margin: 2px 0 22px 0;
}
.main .launch-notice .subtitle { font-size: 15px; letter-spacing: 1px; margin: 0 0 20px 0; padding-bottom: 14px; border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.launch-notice__body { max-height: 290px; min-height: 120px; }
.launch-notice__body .text { font-size: 17px; margin-bottom: 16px; }
.launch-notice__email {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 20px; color: var(--c-text); margin-bottom: 12px;
}
.launch-notice__actions { margin-top: 18px; padding-top: 12px; border-top-width: 1px; border-top-color: var(--c-line); }
.launch-notice__actions .menu-button--small { margin-left: 0; margin-right: 10px; }
.main .launch-notice__continue { color: var(--c-text); border-color: var(--c-accent); background-color: rgb(65, 39, 29); }

/* Pause: a recovery file beside the still-live building. */
.menu-screen--pause.backdrop--dim { background-color: rgba(5, 6, 6, 0.64); }
.pause__scroll .unity-scroll-view__content-container { justify-content: center; min-height: 100%; padding: 4% 0; }
.pause__columns { width: 88%; max-width: 1340px; }
.pause__left { width: 390px; margin-right: 64px; padding-top: 8px; }
.pause__left .title { font-size: 76px; letter-spacing: 6px; }
.pause__eyebrow { margin-bottom: 4px; color: var(--c-accent); }
.pause__left .pause__warning { font-size: 16px; color: var(--c-dim); margin-bottom: 24px; padding: 10px 0 12px 0; border-bottom-width: 1px; border-bottom-color: rgb(126, 57, 43); }
.pause__left .pause__resume { color: rgb(234, 225, 197); border-left-color: rgb(126, 57, 43); margin-bottom: 12px; }
.pause__crew { padding: 24px 28px; }
.pause__crew .heading { font-size: 34px; letter-spacing: 2px; }
.crew-row { flex-direction: column; align-items: stretch; padding: 14px 8px; background-color: rgba(35, 33, 27, 0.5); border-bottom-width: 1px; border-bottom-color: rgba(194, 184, 160, 0.17); margin-bottom: 6px; }
.crew-row__identity { width: 100%; min-width: 0; }
.crew-row__controls { width: 100%; justify-content: flex-end; margin-top: 10px; }
.crew-row__who { min-width: 0; flex-basis: 0; }
.crew-row__swatch, .crew-row__talking, .crew-row__ping { flex-shrink: 0; }
.crew-row__name { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); font-size: 19px; color: var(--c-text); }
.crew-row__tags, .crew-row__ping { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); font-size: 15px; color: var(--c-dim); }
.crew-row__talking { border-radius: 0; background-color: rgb(46, 43, 35); border-width: 1px; border-color: rgba(194, 184, 160, 0.25); }
.crew-row__talking--on { background-color: var(--c-good); border-color: var(--c-good); }
.crew-row__volume.unity-base-slider--horizontal .unity-base-slider__dragger { background-color: var(--c-accent); border-radius: 0; }
.crew-row__volume { width: 130px; min-width: 100px; flex-shrink: 0; }
.crew-row .menu-button--small { font-size: 15px; padding: 6px 10px; }

/* Crew access, settings folders and personal equipment retain their existing functions. */
.play__cards { margin-top: 20px; margin-bottom: 22px; }
.menu-screen .play__card { background-color: rgba(29, 27, 22, 0.9); border-top-width: 2px; border-top-color: rgb(126, 57, 43); border-left-width: 1px; border-left-color: var(--c-line); padding: 20px 18px; }
.menu-screen .play__title { font-size: 24px; color: var(--c-text); margin-bottom: 2px; }
.play__icon { -unity-background-image-tint-color: var(--c-accent); width: 25px; height: 25px; }
.play__card .text { font-size: 17px; }
.play__card .play__blurb { color: var(--c-dim); margin-top: 16px; margin-bottom: 20px; }
.menu-screen .play__card .menu-button { font-size: 26px; }
.play__actions { margin-top: auto; min-height: 148px; flex-shrink: 0; }
.settings__nav { width: 232px; min-width: 190px; border-right-color: rgba(194, 184, 160, 0.23); padding-right: 22px; margin-right: 30px; }
.settings__nav .unity-scroll-view__content-container { width: 100%; }
.menu-screen .settings__nav-button { font-size: 24px; color: var(--c-dim); padding: 10px; margin-bottom: 7px; }
.menu-screen .settings__nav-button--open { color: var(--c-text); border-left-color: rgb(151, 65, 47); background-color: rgba(91, 45, 33, 0.4); border-bottom-color: var(--c-accent); }
.settings__page-title { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 30px; letter-spacing: 2px; color: var(--c-text); }
.settings__page-blurb { font-size: 16px; color: var(--c-dim); margin-bottom: 14px; }
.settings__note { font-size: 15px; margin-top: 3px; margin-bottom: 12px; color: var(--c-faint); }
.settings__footer { padding-top: 10px; border-top-width: 1px; border-top-color: var(--c-line); }
.menu-screen--controls .setting { padding: 8px 0; }
.menu-screen--controls .setting .menu-button--small { color: var(--c-text); border-bottom-color: var(--c-accent); }
.menu-screen--credits .section { margin-top: 24px; }
.menu-screen--credits .text { font-size: 17px; margin-bottom: 10px; }
.menu-screen--howtoplay .text { font-size: 18px; margin-bottom: 14px; }
.achievement-row { align-items: center; padding: 16px 10px; margin-bottom: 8px; background-color: rgba(30, 28, 23, 0.6); border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.achievement-row--earned { border-left-width: 2px; border-left-color: var(--c-accent); }
.achievement-row__details { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 20px; }
.achievement-row__name { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 23px; color: var(--c-text); margin-bottom: 6px; white-space: normal; }
.achievement-row .text { font-size: 16px; }
.achievement-row__status { color: var(--c-dim); font-size: 16px; width: 108px; min-width: 108px; flex-shrink: 0; -unity-text-align: middle-right; }
.achievement-row--earned .achievement-row__status { color: var(--c-accent); }
.wardrobe__preview { background-color: rgb(8, 10, 9); border-width: 1px; border-color: rgba(194, 184, 160, 0.2); }
.wardrobe__detail { background-color: rgba(31, 28, 22, 0.8); border-top-width: 2px; border-top-color: rgb(126, 57, 43); }
.wardrobe__detail-name { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 29px; color: var(--c-text); }
.wardrobe__card { background-color: rgb(28, 27, 22); border-width: 2px; border-color: rgba(194, 184, 160, 0.2); height: auto; min-height: 142px; min-width: 0; max-width: 100%; flex-shrink: 0; }
.wardrobe__card > Label { max-width: 100%; min-width: 0; white-space: normal; flex-shrink: 0; }
.wardrobe__card-name { margin-top: 8px; margin-bottom: 8px; }
.wardrobe__detail-body { min-height: 0; min-width: 0; }
.wardrobe__preview { min-height: 160px; max-height: 100%; flex-grow: 1; flex-shrink: 1; }
.wardrobe__stage { flex-direction: column; min-height: 0; }
.wardrobe__tabs .menu-button--small { min-width: 0; }
.wardrobe__card:hover, .wardrobe__card:focus { background-color: rgb(47, 34, 27); border-color: var(--c-accent); }
.wardrobe__card--selected { background-color: rgb(48, 35, 27); border-color: var(--c-accent); border-width: 2px; }
.wardrobe__card-name { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); font-size: 17px; color: var(--c-text); }
.wardrobe__chip Label { -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf"); font-size: 22px; }
.wardrobe__card-tag, .wardrobe__hint, .wardrobe__status { font-size: 15px; }
.wardrobe__funds { -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf"); color: var(--c-accent); }
.wardrobe__detail-about { font-size: 17px; }
.menu-screen--demoend .title { font-size: 56px; color: var(--c-text); }
.ea-watermark { color: rgba(190, 171, 132, 0.4); letter-spacing: 2px; }

/* Keep the same hierarchy at larger UI scales and short windows. */
.menu-compact .main .main__logo { font-size: 82px; }
.menu-compact .main__column { width: 660px; max-width: 88%; }
.menu-compact .main__ruin { opacity: 0.26; right: 3%; width: 24%; }
.menu-compact .main .main__button { font-size: 31px; }
.menu-compact .main__memo { right: 7%; bottom: 22px; }
.menu-compact .main .footer { bottom: 60px; }
.menu-compact .pause__columns { width: 92%; }
.menu-compact .pause__columns { flex-direction: row; }
.menu-compact .pause__left { width: 325px; margin-right: 28px; }
.menu-compact .pause__left .title { font-size: 60px; }
.menu-compact .pause__crew { padding: 22px; }
.menu-compact .settings__nav { width: 182px; min-width: 155px; margin-right: 20px; padding-right: 14px; }
.menu-compact .settings__nav-button { font-size: 21px; }
.menu-compact .wardrobe__stage { width: 26%; min-width: 190px; margin-right: 16px; }
.menu-compact .wardrobe__detail { width: 30%; min-width: 200px; margin-left: 16px; padding: 14px; }
.menu-narrow .wardrobe__stage { min-width: 160px; margin-right: 12px; }
.menu-narrow .wardrobe__detail { min-width: 180px; margin-left: 12px; }
.menu-narrow .wardrobe__card { width: 100%; margin-right: 0; }
.menu-narrow .pause__columns { flex-direction: column; align-items: stretch; }
.menu-narrow .pause__left { width: 100%; margin-right: 0; margin-bottom: 24px; }
.menu-narrow .pause__crew { width: 100%; max-width: 100%; }
.menu-narrow .main__ruin { display: none; }
.menu-narrow .main .launch-notice__title { font-size: 62px; letter-spacing: 2px; }
.menu-short .main .main__logo { font-size: 78px; }
.menu-short .main__column { margin-top: 22px; margin-bottom: 116px; padding-bottom: 0; }
.menu-short .main__fracture { margin-bottom: 10px; }
.menu-short .main__action { min-height: 43px; }
.menu-short .main .main__button { font-size: 29px; }
.menu-short .main .subtitle { font-size: 15px; margin-bottom: 12px; }
.menu-short .main__eyebrow { top: 3%; font-size: 15px; }
.menu-short .main .launch-notice__title { font-size: 62px; }
.menu-short .launch-notice__body { min-height: 80px; max-height: 190px; }
.menu-short .launch-notice__warning { margin-bottom: 16px; }
.menu-short .menu-screen .panel { padding: 20px 28px; }
.menu-short .menu-screen .heading { font-size: 34px; margin-bottom: 8px; }
.menu-short .menu-record { margin-bottom: 6px; font-size: 15px; }
.menu-short .menu-screen .subtitle { margin-bottom: 14px; }
.menu-short .pause__left .menu-button { font-size: 25px; }

/* 0.24.8: Settings > Gameplay > Language. One button per language, each in its own script. */
.menu-screen .language-list { flex-direction: row; flex-wrap: wrap; align-items: flex-start; margin-bottom: 4px; }
.menu-screen .language-list__button { margin-left: 0; margin-right: 8px; margin-bottom: 8px; }
.menu-screen .language-list__button--current { color: var(--c-text); border-left-color: rgb(151, 65, 47); background-color: rgba(91, 45, 33, 0.4); border-bottom-color: var(--c-accent); }
