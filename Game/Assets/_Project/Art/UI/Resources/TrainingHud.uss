/* The training job's guidance (Scripts/Tutorial): the lesson card at the top, the chapter checklist on the left,
   markers and edge arrows over the world, and frames around the HUD pieces a lesson points out.
   Same bone/rust/amber instruments as HorrorHud.uss; loaded after it (UiThemeAssets.Layers). */

/* ---- The lesson card ---- */
/* left and width are set in code (TutorialObjectiveCard.Place): centred, clear of the checklist and the battery. */
.horror-hud .training-card {
    position: absolute;
    top: 96px;
    left: 30%;
    width: 580px;
    padding: 12px 18px 14px 18px;
    background-color: rgba(13, 15, 14, 0.9);
    border-top-width: 2px;
    border-top-color: rgb(186, 154, 98);
    border-bottom-width: 1px;
    border-bottom-color: rgba(217, 207, 184, 0.18);
    transition-property: opacity, translate, border-top-color;
    transition-duration: 0.25s, 0.25s, 0.2s;
}
.horror-hud .training-card--enter { opacity: 0; translate: 0 -10px; }
.horror-hud .training-card--done { border-top-color: rgb(140, 176, 106); }
.horror-hud .training-card__head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 4px; }
.horror-hud .training-card__chapter,
.horror-hud .training-card__count {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(147, 143, 129);
    margin: 0;
    padding: 0;
}
.horror-hud .training-card__title {
    -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 27px;
    letter-spacing: 2px;
    color: rgb(217, 207, 184);
    margin: 0;
    padding: 0;
    white-space: normal;
}
.horror-hud .training-card__text {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 17px;
    color: rgb(214, 206, 186);
    margin: 6px 0 0 0;
    padding: 0;
    white-space: normal;
}
.horror-hud .training-card__meter { flex-direction: row; align-items: center; margin-top: 11px; }
.horror-hud .training-card__bar {
    flex-grow: 1;
    height: 9px;
    border-width: 1px;
    border-color: rgba(217, 207, 184, 0.28);
    background-color: rgba(217, 207, 184, 0.07);
}
.horror-hud .training-card__bar .bar__fill {
    height: 100%;
    background-color: rgb(186, 154, 98);
    transition-property: width;
    transition-duration: 0.18s;
}
.horror-hud .training-card--done .training-card__bar .bar__fill { background-color: rgb(140, 176, 106); }
.horror-hud .training-card__readout {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 14px;
    color: rgb(217, 207, 184);
    margin: 0 0 0 12px;
    padding: 0;
    min-width: 120px;
    -unity-text-align: middle-right;
    white-space: nowrap;
}
.horror-hud .training-card__stamp {
    position: absolute;
    right: 14px;
    top: 12px;
    -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 22px;
    letter-spacing: 3px;
    color: rgb(140, 176, 106);
    border-width: 2px;
    border-color: rgb(140, 176, 106);
    padding: 0 9px 0 9px;
    rotate: -6deg;
    opacity: 0;
    scale: 1.5 1.5;
    transition-property: opacity, scale;
    transition-duration: 0.14s, 0.14s;
}
.horror-hud .training-card--done .training-card__stamp { opacity: 1; scale: 1 1; }

/* The keys this lesson uses: each lights while it's held. */
.horror-hud .training-card__keys { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.horror-hud .training-key {
    flex-direction: row;
    align-items: center;
    margin: 0 10px 4px 0;
    padding: 3px 9px 3px 4px;
    border-width: 1px;
    border-color: rgba(217, 207, 184, 0.2);
    background-color: rgba(217, 207, 184, 0.03);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.08s, 0.08s, 0.08s;
}
.horror-hud .training-key .keycap { margin-right: 7px; }
.horror-hud .training-key__label {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 13px;
    color: rgb(147, 143, 129);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}
.horror-hud .training-key--down { background-color: rgba(186, 154, 98, 0.35); border-color: rgb(186, 154, 98); scale: 1.06 1.06; }
.horror-hud .training-key--down .training-key__label { color: rgb(217, 207, 184); }
.horror-hud .training-key--used { border-color: rgba(140, 176, 106, 0.6); }

/* ---- The chapter checklist (in the field note on the left) ---- */
.training-list { margin-top: 2px; }
.training-list__row { flex-direction: row; align-items: flex-start; margin-bottom: 3px; }
.training-list__mark {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf");
    width: 20px;
    min-width: 20px;
    font-size: 15px;
    margin: 0;
    padding: 0;
    color: rgba(217, 207, 184, 0.3);
}
.training-list__title {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 15px;
    margin: 0;
    padding: 0;
    white-space: normal;
    flex-shrink: 1;
    color: rgba(217, 207, 184, 0.38);
}
.training-list__row--done .training-list__mark { color: rgb(140, 176, 106); }
.training-list__row--done .training-list__title { color: rgb(147, 143, 129); }
.training-list__row--now .training-list__mark { color: rgb(186, 154, 98); }
.training-list__row--now .training-list__title { color: rgb(217, 207, 184); -unity-font-style: bold; }

/* ---- Over the world: the target's marker, the edge arrow, the monster ---- */
.training-mark { position: absolute; translate: -50% -100%; align-items: center; }
.training-mark__label {
    -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 17px;
    letter-spacing: 2px;
    color: rgb(217, 207, 184);
    background-color: rgba(13, 15, 14, 0.86);
    border-left-width: 3px;
    border-left-color: rgb(186, 154, 98);
    padding: 1px 9px 1px 8px;
    margin: 0;
    white-space: nowrap;
}
.training-mark__distance {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Regular.ttf");
    font-size: 13px;
    color: rgb(217, 207, 184);
    background-color: rgba(13, 15, 14, 0.6);
    padding: 0 6px 0 6px;
    margin: 2px 0 0 0;
    white-space: nowrap;
}
.training-mark__action { flex-direction: row; align-items: center; margin-top: 4px; padding: 2px 8px 2px 3px; background-color: rgba(13, 15, 14, 0.86); }
.training-mark__action .keycap { margin-right: 6px; }
.training-mark__verb {
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf");
    font-size: 14px;
    color: rgb(217, 207, 184);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}
.training-mark__arrow { width: 30px; height: 20px; margin-top: 3px; }
.training-mark--danger .training-mark__label { border-left-color: rgb(172, 87, 67); color: rgb(232, 158, 138); }
.training-mark--danger .training-mark__distance { color: rgb(232, 158, 138); }
.training-mark--away .training-mark__label { border-left-color: rgb(172, 87, 67); }

.training-edge { position: absolute; translate: -50% -50%; align-items: center; justify-content: center; width: 64px; height: 64px; }
.training-edge__arrow { position: absolute; left: 15px; top: 17px; width: 34px; height: 30px; }
.training-edge__distance {
    position: absolute;
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf");
    font-size: 12px;
    color: rgb(217, 207, 184);
    background-color: rgba(13, 15, 14, 0.75);
    padding: 0 4px 0 4px;
    margin: 0;
    white-space: nowrap;
}

/* ---- Frames around the HUD instruments a lesson points out ---- */
.training-highlight {
    position: absolute;
    border-width: 2px;
    border-color: rgb(186, 154, 98);
    background-color: rgba(186, 154, 98, 0.06);
}
.training-highlight__label {
    position: absolute;
    left: -2px;
    bottom: 100%;
    -unity-font-definition: url("../../ThirdParty/Fonts/IBMPlexMono/IBMPlexMono-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(13, 15, 14);
    background-color: rgb(186, 154, 98);
    padding: 1px 6px 1px 6px;
    margin: 0 0 3px 0;
    white-space: nowrap;
}
.training-highlight--below .training-highlight__label { bottom: auto; top: 100%; margin: 3px 0 0 0; }

/* Short screens: the card gives the world more room. */
.menu-short .horror-hud .training-card { top: 72px; padding: 8px 14px 10px 14px; }
.menu-short .horror-hud .training-card__title { font-size: 22px; }
.menu-short .horror-hud .training-card__text { font-size: 15px; }
