/* 0.24.12 menus: structure and presentation only. Every colour is the theme's (AbandonedTheme.uss variables) or one
   the menus already used; loaded last (UiThemeAssets.Layers), so it wins over the older layout rules. */

/* ---------- pages (MenuKit.Page): a full-height sheet on the left, the world visible beside it ---------- */

.mm-backdrop {
    padding: 0;
    justify-content: flex-start;
    background-color: rgba(8, 10, 12, 0.62);
}

.mm-page {
    height: 100%;
    max-height: 100%;
    width: 58%;
    min-width: 700px;
    max-width: 1180px;
    margin: 0;
    padding: 40px 56px 28px 64px;
    border-radius: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 6px;
    border-left-color: var(--c-accent);
    border-right-width: 1px;
    border-right-color: var(--c-line);
    background-color: var(--c-panel);
}

.mm-page--wide { width: 84%; max-width: 1680px; }
.menu-narrow .mm-page { width: 100%; min-width: 0; padding: 28px 28px 20px 32px; }
.menu-short .mm-page { padding-top: 24px; padding-bottom: 16px; }

.mm-crumb { font-size: 14px; letter-spacing: 6px; color: var(--c-faint); margin-bottom: 6px; }
.mm-page .menu-record { font-size: 13px; letter-spacing: 3px; color: var(--c-accent); margin-bottom: 2px; }
.mm-page .heading { font-size: 60px; letter-spacing: 5px; margin-bottom: 2px; color: var(--c-text); }
.menu-short .mm-page .heading { font-size: 46px; }
.mm-page .subtitle { color: var(--c-dim); margin-bottom: 18px; }

.mm-hint {
    position: absolute;
    right: 36px;
    bottom: 26px;
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--c-faint);
}
.menu-narrow .mm-hint { display: none; }

/* ---------- settings: categories | options | what the highlighted option does ---------- */

.settings__columns { flex-grow: 1; flex-shrink: 1; flex-direction: row; min-height: 0; }
.settings__page { flex-grow: 1; flex-shrink: 1; min-width: 0; }

.settings__help {
    width: 300px;
    flex-shrink: 0;
    align-self: flex-start;
    margin-left: 28px;
    padding: 18px 20px;
    background-color: var(--c-panel-2);
    border-top-width: 3px;
    border-top-color: var(--c-accent);
}
.settings__help-title { font-size: 22px; letter-spacing: 1px; color: var(--c-text); margin-bottom: 8px; white-space: normal; }
.settings__help-text { font-size: 16px; color: var(--c-dim); white-space: normal; }
.menu-compact .settings__help { width: 240px; margin-left: 20px; }
.menu-narrow .settings__help { display: none; }

.settings .section {
    margin-top: 22px;
    margin-bottom: 4px;
    padding: 8px 12px;
    font-size: 14px;
    letter-spacing: 3px;
    color: var(--c-accent-hot);
    background-color: var(--c-panel-3);
}
.settings .setting { padding: 0 12px; border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.settings .setting--explained:hover { background-color: var(--c-panel-2); }

/* ---------- main menu: rail, detail card, status bar ---------- */

.mm-main { padding: 0; }

.mm-main__shade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 46%;
    background-color: rgba(8, 10, 12, 0.78);
    border-right-width: 1px;
    border-right-color: var(--c-line);
}

.mm-rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 56px;
    width: 44%;
    min-width: 520px;
    padding: 6% 32px 0 6%;
}
.menu-narrow .mm-rail { width: 100%; min-width: 0; padding-left: 28px; }
.menu-narrow .mm-main__shade { width: 100%; }

/* The stencil logo sized to the rail (the centred layout gave it the whole width). */
.mm-main .main__logo { font-size: 76px; }
.menu-compact .mm-main .main__logo { font-size: 64px; }
.menu-short .mm-main .main__logo { font-size: 60px; }
.menu-narrow .mm-main .main__logo { font-size: 56px; }

.mm-eyebrow { font-size: 14px; letter-spacing: 6px; color: var(--c-accent); margin-bottom: 10px; }
.mm-rule { height: 2px; width: 160px; margin: 6px 0 26px 0; background-color: var(--c-accent); }

.mm-nav { width: 460px; max-width: 100%; margin-top: 4px; }

.mm-nav__item {
    font-size: 40px;
    letter-spacing: 3px;
    -unity-text-align: middle-left;
    min-height: 58px;
    margin: 2px 0;
    padding-left: 18px;
    border-width: 0;
    border-left-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-dim);
    transition-property: padding-left, color, background-color;
    transition-duration: 0.12s;
}
.mm-nav__item--active, .mm-nav__item:hover, .mm-nav__item:focus {
    padding-left: 28px;
    color: var(--c-text);
    border-left-width: 4px;
    border-left-color: var(--c-accent);
    background-color: rgba(177, 119, 86, 0.12);
}
.menu-short .mm-nav__item { font-size: 32px; min-height: 48px; }

.mm-card {
    position: absolute;
    right: 6%;
    bottom: 104px;
    width: 30%;
    min-width: 360px;
    padding: 22px 26px;
    background-color: var(--c-panel);
    border-top-width: 3px;
    border-top-color: var(--c-accent);
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--c-line);
    border-right-color: var(--c-line);
    border-bottom-color: var(--c-line);
}
.mm-card__index { font-size: 13px; letter-spacing: 4px; color: var(--c-faint); }
.mm-card__title {
    -unity-font-definition: url("../../ThirdParty/Fonts/SairaStencilOne/SairaStencilOne-Regular.ttf");
    font-size: 34px;
    letter-spacing: 2px;
    color: var(--c-text);
    margin: 4px 0 8px 0;
}
.mm-card__text { font-size: 18px; color: var(--c-dim); white-space: normal; }
.mm-card__memo {
    margin-top: 16px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--c-line);
    font-size: 14px;
    color: var(--c-faint);
    white-space: normal;
}
.menu-narrow .mm-card { display: none; }

.mm-status {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 56px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 3%;
    background-color: var(--c-panel);
    border-top-width: 1px;
    border-top-color: var(--c-line);
}
.mm-status__links { flex-wrap: wrap; }
.mm-status__keys { font-size: 15px; letter-spacing: 2px; color: var(--c-faint); }
.mm-status__version { font-size: 14px; color: var(--c-faint); }
.menu-compact .mm-status__keys { display: none; }

/* ---------- pause: a side sheet, the game and the crew beside it ---------- */

.pause .pause__content { justify-content: flex-start; padding: 0; min-height: 100%; }
.pause .pause__columns { width: 100%; max-width: none; min-height: 100%; align-items: stretch; }
.pause .pause__left {
    width: 420px;
    margin-right: 56px;
    padding: 56px 40px 32px 48px;
    background-color: var(--c-panel);
    border-left-width: 6px;
    border-left-color: var(--c-accent);
    border-right-width: 1px;
    border-right-color: var(--c-line);
}
.pause .pause__left .title { font-size: 58px; letter-spacing: 4px; }
.pause .pause__crew { margin-top: 56px; align-self: flex-start; }
.menu-narrow .pause .pause__left { width: 100%; margin-right: 0; }
